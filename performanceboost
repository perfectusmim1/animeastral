-- [LocalScript] GraphicsTuner v5.1 (Hardened)
-- Queue-based processing | Modular architecture | Lookup tables
-- Interval-based monitor | Safe Luau GC | Performance telemetry
-- v5.1: forward-decl fix, head/tail queue, re-run guard, settings respected,
--       physics opt, restore snapshot, pcall-hardened scan

getgenv().GraphicsTuner = getgenv().GraphicsTuner or {
    Settings = {
        GraphicsDestruction = {
