}

do
    -- Re-run guard: disconnect previous session's connections & stop old loops
    if getgenv().GT_Connections then
        for _, c in ipairs(getgenv().GT_Connections) do
            pcall(function() c:Disconnect() end)
        end
    end
    getgenv().GT_Connections = {}
    local Connections = getgenv().GT_Connections
    local function track(conn)
        Connections[#Connections + 1] = conn
        return conn
    end
    local RunId = (getgenv().GT_RunId or 0) + 1
    getgenv().GT_RunId = RunId

    -- Service cache
    local S = setmetatable({}, {
        __index = function(t, k)
            local s = game:GetService(k)
            rawset(t, k, s)
            return s
        end
    })

    local P: Player = S.Players.LocalPlayer
    local Set = GraphicsTuner.Settings
    -- Eski çalıştırmadan kalan Settings tablosunda yeni anahtarlar eksik olabilir; varsayılanları birleştir
    if Set.World == nil then
        Set.World = { RemoveWater = true, WaterRadius = 1024, ClearTerrain = false }
    end
    if Set.Player.SimplifyOthers == nil then
        Set.Player.SimplifyOthers = true
    end
    if Set.Player.FreezeAnimations == nil then
        Set.Player.FreezeAnimations = true
    end
    if Set.Player.AnimFreezeDistance == nil then
        Set.Player.AnimFreezeDistance = 100
    end
    if Set.GraphicsDestruction.DestroySounds == nil then
        Set.GraphicsDestruction.DestroySounds = true
    end
    local Heartbeat = S.RunService.Heartbeat

    -- Lookup tables for ClassName matching
    local PROTECT_CLASSES = {
        ScreenGui = true, Frame = true, ScrollingFrame = true, CanvasGroup = true,
        TextLabel = true, TextButton = true, TextBox = true,
        ImageLabel = true, ImageButton = true, ViewportFrame = true, VideoFrame = true,
        BillboardGui = true, SurfaceGui = true,
        ProximityPrompt = true, ClickDetector = true,
        TouchTransmitter = true,
        Script = true, LocalScript = true, ModuleScript = true,
        RemoteEvent = true, RemoteFunction = true,
        BindableEvent = true, BindableFunction = true,
        Animation = true, Animator = true, AnimationController = true, AnimationTrack = true,
        Humanoid = true,
        Tool = true, BackpackItem = true,
    }

    local PARTICLE_CLASSES = { ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true }
    local LIGHT_CLASSES = { PointLight = true, SpotLight = true, SurfaceLight = true }
    local CLOTHES_CLASSES = { Shirt = true, Pants = true, ShirtGraphic = true }

    -- Performance telemetry
    local Stats = {
        StartTime = 0,
        Processed = 0,
        Destroyed = 0,
        Protected = 0,
        InitMs = 0,
        QueuePeak = 0,
    }

    -- Forward declaration (ProcessQueue runs before OptimizeObject is defined)
    local OptimizeObject

    -- Queue system (explicit head/tail: no #Queue on tables with nil holes)
    local Queue = {}
    local QueueHead, QueueTail = 1, 0
    local MAX_QUEUE_SIZE = 10000
    local MAX_BATCH = Set.Performance.BatchSize

    local function enqueue(obj)
        local size = QueueTail - QueueHead + 1
        if size < MAX_QUEUE_SIZE then
            QueueTail += 1
            Queue[QueueTail] = obj
            if size + 1 > Stats.QueuePeak then
                Stats.QueuePeak = size + 1
            end
        end
    end

    local function ProcessQueue()
        local processed = 0
        while processed < MAX_BATCH and QueueHead <= QueueTail do
            local obj = Queue[QueueHead]
            Queue[QueueHead] = nil
            QueueHead += 1
            if obj and obj.Parent then
                pcall(OptimizeObject, obj)
            end
            processed += 1
        end
        if QueueHead > QueueTail then
            QueueHead, QueueTail = 1, 0
        end
    end

    -- Protection check using lookup tables
    local function ShouldProtect(obj)
        local cn = obj.ClassName
        if PROTECT_CLASSES[cn] then
            return true
        end
        if cn:find("Value", 1, true) then
            return true
        end
        -- Catch-all for GUI/UI classes not in the lookup table
        if obj:IsA("GuiBase2d") or obj:IsA("UIBase") then
            return true
        end
        if obj:IsA("Sound") then
            return true
        end
        if P.PlayerGui and obj:IsDescendantOf(P.PlayerGui) then
            return true
        end
        local ok, result = pcall(function()
            return obj:IsDescendantOf(S.CoreGui)
        end)
        if ok and result then return true end
        if Set.Player.ProtectSelf and P.Character and obj:IsDescendantOf(P.Character) then
            return true
        end
        if obj:FindFirstAncestorWhichIsA("Tool") then
            return true
        end
        return false
    end

    -- Modular: Destruction rules
    local function ProcessDestruction(obj, cn)
        if PARTICLE_CLASSES[cn] and Set.GraphicsDestruction.RemoveParticles then
            obj:Destroy()
            return true
        end
        if cn == "Trail" and Set.GraphicsDestruction.RemoveTrails then
            obj:Destroy()
            return true
        end
        if cn == "Beam" and Set.GraphicsDestruction.RemoveBeams then
            obj:Destroy()
            return true
        end
        if LIGHT_CLASSES[cn] and Set.GraphicsDestruction.RemoveLights then
            obj:Destroy()
            return true
        end
        if CLOTHES_CLASSES[cn] and Set.GraphicsDestruction.RemoveClothes then
            obj:Destroy()
            return true
        end
        if Set.GraphicsDestruction.RemoveAccessories then
            if obj:IsA("Accessory") or obj:IsA("Hat") or cn == "CharacterMesh" or cn == "SurfaceAppearance" or cn == "BaseWrap" then
                obj:Destroy()
                return true
            end
        end
        if cn == "Sky" and Set.GraphicsDestruction.RemoveSky then
            obj:Destroy()
            return true
        end
        if cn == "Atmosphere" and Set.GraphicsDestruction.RemoveAtmosphere then
            obj:Destroy()
            return true
        end
        if cn == "Clouds" and Set.GraphicsDestruction.RemoveClouds then
            obj:Destroy()
            return true
        end
        if obj:IsA("PostEffect") and Set.GraphicsDestruction.RemovePostEffects then
            obj:Destroy()
            return true
        end
        return false
    end

    -- Modular: BasePart optimization
    local function ProcessBasePart(obj, cn)
        if not obj:IsA("BasePart") then return end
        if Set.Graphics.SimplifyMaterials then
            obj.Material = Enum.Material.SmoothPlastic
        end
        if Set.Graphics.NoShadows then
            obj.CastShadow = false
        end
        if Set.Graphics.NoReflections then
            obj.Reflectance = 0
        end
        obj.TopSurface = Enum.SurfaceType.Smooth
        obj.BottomSurface = Enum.SurfaceType.Smooth
        if cn == "MeshPart" then
            if Set.Performance.SimplifyMeshes then
                obj.RenderFidelity = Enum.RenderFidelity.Performance
            end
            if Set.Performance.MinimalCollision then
                obj.CollisionFidelity = Enum.CollisionFidelity.Box
            end
            if Set.GraphicsDestruction.RemoveTextures then
                obj.TextureID = ""
            end
            obj.DoubleSided = false
        elseif cn == "UnionOperation" then
            if Set.Performance.SimplifyMeshes then
                obj.RenderFidelity = Enum.RenderFidelity.Performance
            end
            if Set.Performance.MinimalCollision then
                obj.CollisionFidelity = Enum.CollisionFidelity.Box
            end
            obj.UsePartColor = true
        end
    end

    -- Modular: Visual/behavioral tweaks
    local function ProcessVisuals(obj, cn)
        if cn == "SpecialMesh" and Set.GraphicsDestruction.RemoveTextures then
            obj.TextureId = ""
        end
        if cn == "Model" then
            obj.LevelOfDetail = Enum.ModelLevelOfDetail.Disabled
        end
        if cn == "Explosion" and Set.GraphicsDestruction.DisableExplosions then
            obj.BlastPressure = 0
            obj.BlastRadius = 0
            obj.Visible = false
        end
        if Set.GraphicsDestruction.RemoveDecals then
            if cn == "Decal" or cn == "Texture" then
                obj.Transparency = 1
            end
        end
        if obj:IsA("Sound") then
            if Set.GraphicsDestruction.DestroySounds then
                obj:Destroy()
                Stats.Destroyed += 1
            elseif Set.GraphicsDestruction.MuteSounds then
                -- Attribute guard: prevent repeated 0.2x stacking on re-processing
                if not obj:GetAttribute("GT_Muted") then
                    obj:SetAttribute("GT_Muted", true)
                    obj.Volume = obj.Volume * 0.2
                end
            end
        end
    end

    -- Main dispatch (assigns to forward-declared local)
    function OptimizeObject(obj)
        if ShouldProtect(obj) then
            Stats.Protected += 1
            ProcessVisuals(obj, obj.ClassName)
            return
        end
        local cn = obj.ClassName
        Stats.Processed += 1
        if ProcessDestruction(obj, cn) then
            Stats.Destroyed += 1
            return
        end
        ProcessBasePart(obj, cn)
        ProcessVisuals(obj, cn)
    end

    -- Graphics render settings
    local function OptimizeGraphics()
        local R = settings():GetService("RenderSettings")
        local U = UserSettings():GetService("UserGameSettings")
        R.QualityLevel = Enum.QualityLevel.Level01
        R.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
        R.EagerBulkExecution = false
        U.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        U.GraphicsQualityLevel = 1
        workspace.LevelOfDetail = Enum.ModelLevelOfDetail.Disabled
        pcall(function()
            sethiddenproperty(R, "EnableFRM", true)
            sethiddenproperty(R, "AutoFRMLevel", 1)
            sethiddenproperty(R, "DebugFRMQualityLevelOverride", 1)
            sethiddenproperty(workspace, "MeshPartHeads", Enum.MeshPartHeads.Disabled)
            sethiddenproperty(workspace, "AnimationThrottlingEnabled", true)
            sethiddenproperty(workspace, "SignalBehavior", Enum.SignalBehavior.Immediate)
        end)
        local L = S.Lighting
        L.GlobalShadows = false
        L.ShadowSoftness = 0
        L.EnvironmentDiffuseScale = 0
        L.EnvironmentSpecularScale = 0
        if Set.Graphics.FullBright then
            L.Brightness = 3
            L.OutdoorAmbient = Color3.new(1, 1, 1)
            L.Ambient = Color3.new(1, 1, 1)
        end
        if Set.Graphics.RemoveFog then
            L.FogEnd = 9e9
            L.FogStart = 9e9
        end
        if Set.Graphics.CompatibilityMode then
            pcall(function()
                sethiddenproperty(L, "Technology", Enum.Technology.Compatibility)
            end)
        end
        local T = workspace:FindFirstChildOfClass("Terrain")
        if T then
            pcall(function() T.WaterWaveSize = 0 end)
            pcall(function() T.WaterWaveSpeed = 0 end)
            pcall(function() T.WaterReflectance = 0 end)
            pcall(function() T.WaterTransparency = 0.9 end)
            pcall(function() T.Decoration = false end)
        end
        pcall(function()
            S.MaterialService.Use2022Materials = false
        end)
    end

    local function OptimizePhysics()
        pcall(function()
            sethiddenproperty(workspace, "PhysicsSteppingMethod", Enum.PhysicsSteppingMethod.Adaptive)
        end)
        pcall(function()
            sethiddenproperty(workspace, "InterpolationThrottling", Enum.InterpolationThrottlingMode.Enabled)
        end)
    end

    local function DevConsoleBoost()
        pcall(function()
            local VIM = S.VirtualInputManager
            track(game.DescendantAdded:Connect(function(d)
                if d.Name == "MainView" and d.Parent and d.Parent.Name == "DevConsoleUI" then
                    task.wait(0.05)
                    local p = d.Parent.Parent.Parent
                    if p then
                        p.Enabled = false
                    end
                end
            end))
            VIM:SendKeyEvent(true, "F9", false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, "F9", false, game)
        end)
    end

    local function SetupGC()
        pcall(function() collectgarbage("collect") end)
        task.spawn(function()
            -- RunId check: loop dies automatically when the script is re-executed
            while getgenv().GT_RunId == RunId do
                task.wait(Set.Performance.GCInterval)
                if getgenv().GT_RunId ~= RunId then break end
                pcall(function() collectgarbage("collect") end)
            end
        end)
    end

    local function ClearNilInstances()
        if getnilinstances then
            local nil_objs = getnilinstances()
            for _, obj in ipairs(nil_objs) do
                if not ShouldProtect(obj) then
                    pcall(function()
                        obj:Destroy()
                        Stats.Destroyed += 1
                    end)
                end
            end
        end
    end

    -- Su/Terrain temizliği (client-side)
    local function OptimizeWorld()
        local T = workspace:FindFirstChildOfClass("Terrain")
        if not T then return end
        if Set.World.ClearTerrain then
            pcall(function() T:Clear() end)
            return
        end
        if Set.World.RemoveWater then
            -- Suyu voksel bazında Air ile değiştir; chunk chunk arka planda çalışır, donma yapmaz
            task.spawn(function()
                local r = Set.World.WaterRadius
                local step = 256
                local c = Vector3.zero
                local char = P.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then c = root.Position end
                for x = c.X - r, c.X + r - step, step do
                    for z = c.Z - r, c.Z + r - step, step do
                        for y = c.Y - 512, c.Y + 512 - step, step do
                            if getgenv().GT_RunId ~= RunId then return end
                            local region = Region3.new(
                                Vector3.new(x, y, z),
                                Vector3.new(x + step, y + step, z + step)
                            ):ExpandToGrid(4)
                            pcall(function()
                                T:ReplaceMaterial(region, 4, Enum.Material.Water, Enum.Material.Air)
                            end)
                            task.wait()
                        end
                    end
                end
            end)
        end
    end

    -- Diğer oyuncuların karakterlerini sadeleştir
    local function SimplifyCharacter(char)
        pcall(function()
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            end
        end)
        for _, d in ipairs(char:GetDescendants()) do
            pcall(function()
                local cn = d.ClassName
                if d:IsA("Accessory") or CLOTHES_CLASSES[cn] or PARTICLE_CLASSES[cn]
                    or cn == "CharacterMesh" or cn == "SurfaceAppearance" or cn == "BaseWrap" then
                    d:Destroy()
                    Stats.Destroyed += 1
                elseif d:IsA("BasePart") then
                    d.Material = Enum.Material.SmoothPlastic
                    d.CastShadow = false
                    d.Reflectance = 0
                    if d:IsA("MeshPart") then
                        d.RenderFidelity = Enum.RenderFidelity.Performance
                        d.TextureID = ""
                    end
                elseif cn == "Decal" then
                    d.Transparency = 1 -- yüz decal'leri dahil
                end
            end)
        end
    end

    local function SetupSimplifyOthers()
        local function hook(pl)
            if pl == P then return end
            if pl.Character then
                task.spawn(SimplifyCharacter, pl.Character)
            end
            track(pl.CharacterAdded:Connect(function(char)
                task.wait(1) -- aksesuar/kıyafetlerin yüklenmesini bekle
                SimplifyCharacter(char)
            end))
        end
        for _, pl in ipairs(S.Players:GetPlayers()) do
            hook(pl)
        end
        track(S.Players.PlayerAdded:Connect(hook))
    end

    -- Diğer oyuncuların animasyonlarını dondur (uzaktakileri AdjustSpeed(0) ile)
    local function SetupAnimationFreeze()
        task.spawn(function()
            while getgenv().GT_RunId == RunId do
                local cam = workspace.CurrentCamera
                local camPos = cam and cam.CFrame.Position
                local dist = Set.Player.AnimFreezeDistance
                for _, pl in ipairs(S.Players:GetPlayers()) do
                    if pl ~= P and pl.Character then
                        local char = pl.Character
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        local animator = hum and hum:FindFirstChildOfClass("Animator")
                        if animator and hrp then
                            -- Mesafe > eşik ise donar (speed 0), yakınsa normal (speed 1)
                            local speed = (camPos and (hrp.Position - camPos).Magnitude > dist) and 0 or 1
                            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                                pcall(function() tr:AdjustSpeed(speed) end)
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end

