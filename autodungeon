local function optimalFarmPosition(enemies, typeStr)
    local positions3D = {}
    for _, e in ipairs(enemies) do
        local cf = getObjectCFrame(e)
        if cf then table.insert(positions3D, cf.Position) end
    end
    if #positions3D == 0 then return nil, 0 end
    local h = getFarmHeightForType(typeStr)
    if #positions3D == 1 then
        return CFrame.new(positions3D[1] + Vector3.new(0, h, 0)), 1
    end

    local range = getPlayerRange()
    local centroid = Vector3.zero
    for _, p in ipairs(positions3D) do centroid += p end
    centroid /= #positions3D

    local allFit = true
    for _, p in ipairs(positions3D) do
        local dist = (Vector2.new(p.X, p.Z) - Vector2.new(centroid.X, centroid.Z)).Magnitude
        if dist > range * 0.95 then allFit = false; break end
    end
    if allFit then
        return CFrame.new(centroid + Vector3.new(0, h, 0)), #positions3D
    end

    local candidates = {}
    for _, p in ipairs(positions3D) do table.insert(candidates, p) end
    for i = 1, #positions3D do
        for j = i + 1, #positions3D do
            table.insert(candidates, (positions3D[i] + positions3D[j]) / 2)
        end
    end
    table.insert(candidates, centroid)

    local bestPos = candidates[1]
    local bestCount = 0

    for _, candidate in ipairs(candidates) do
        local count = 0
        for _, p in ipairs(positions3D) do
            local dist = (Vector2.new(p.X, p.Z) - Vector2.new(candidate.X, candidate.Z)).Magnitude
            if dist <= range * 0.95 then count = count + 1 end
        end
        if count > bestCount then
            bestCount = count
            bestPos = candidate
        elseif count == bestCount then
            if (candidate - centroid).Magnitude < (bestPos - centroid).Magnitude then
                bestPos = candidate
            end
        end
    end

    local clusterCenter = Vector3.zero
    local clusterCount = 0
    for _, p in ipairs(positions3D) do
        local dist = (Vector2.new(p.X, p.Z) - Vector2.new(bestPos.X, bestPos.Z)).Magnitude
        if dist <= range * 0.95 then
            clusterCenter += p
            clusterCount = clusterCount + 1
        end
    end

    if clusterCount > 0 then
        clusterCenter /= clusterCount
        return CFrame.new(clusterCenter + Vector3.new(0, h, 0)), clusterCount
    else
        return CFrame.new(bestPos + Vector3.new(0, h, 0)), 1
    end
end

local function waitForWaveSpawn(folder, expectedCount)
    local targets = {}
    if not folder then return targets end

    local function getAlive()
        local t = {}
        for _, e in ipairs(folder:GetChildren()) do
            if isEnemyAlive(e) then table.insert(t, e) end
        end
        return t
    end

    targets = getAlive()
    if #targets == 0 or #targets >= expectedCount then return targets end

    local stableTime = tick()
    local lastCount = #targets

    while tick() - stableTime < 0.6 do
        task.wait(0.01)
        targets = getAlive()
        if #targets >= expectedCount then return targets
        elseif #targets > lastCount then
            stableTime = tick()
            lastCount = #targets
        end
    end
    return targets
end

local function farmEnemies(targets, typeStr, zoneStr, checkEnabledFunc, folder)
    local originalCheck = checkEnabledFunc
    checkEnabledFunc = function()
        if isMultiplayerPaused() then return false end
        return originalCheck()
    end

    local useOptimal = true
    if typeStr == "Farm" then
        useOptimal = (Options.PerfectPosition and Options.PerfectPosition.Value) or false
    end

    local isHoverEnabled = getHoverState(typeStr)

    if #targets > 0 then
        if isHoverEnabled then enableHover() else disableHover() end

        local isFastTeleport = (Options.FastTeleportFarm and Options.FastTeleportFarm.Value) or false
        if isFastTeleport then
            if useOptimal then
                local tcf, coveredCount = optimalFarmPosition(targets, typeStr)
                if tcf then
                    MovementGoTo(tcf)
                    task.wait(0.01)
                    return
                end
            end
            for _, enemy in ipairs(targets) do
                if not checkEnabledFunc() then break end
                local cf = getObjectCFrame(enemy)
                if cf then
                    MovementGoTo(cf + Vector3.new(0, getFarmHeightForType(typeStr), 0))
                    task.wait(0.01)
                end
            end
            return
        end

        local initialCount = #targets
        local tcf, coveredCount = nil, 0
        if useOptimal then tcf, coveredCount = optimalFarmPosition(targets, typeStr) end

        if tcf and coveredCount >= 2 then
            local range = getPlayerRange()
            MovementGoTo(tcf)

            local startTime = tick()
            local lastHealthTotal = 0
            for _, e in ipairs(targets) do
                if isEnemyAlive(e) then lastHealthTotal = lastHealthTotal + getEnemyHealth(e) end
            end
            local lastHealthChangeTime = tick()
            local isDropping = false
            local dropStartTime = 0

            while tick() - startTime < 5 and checkEnabledFunc() do
                local currentHealthTotal = 0
                for _, e in ipairs(targets) do
                    if isEnemyAlive(e) then currentHealthTotal = currentHealthTotal + getEnemyHealth(e) end
                end

                if currentHealthTotal ~= lastHealthTotal and currentHealthTotal > 0 then
                    lastHealthTotal = currentHealthTotal
                    lastHealthChangeTime = tick()
                end

                if not isDropping and (tick() - lastHealthChangeTime > 5.0) then
                    isDropping = true
                    dropStartTime = tick()
                end

                if isDropping and (tick() - dropStartTime > 2.0) then
                    isDropping = false
                    lastHealthChangeTime = tick()
                end

                isHoverEnabled = getHoverState(typeStr)
                if isHoverEnabled and not isDropping then
                    enableHover()
                    MovementGoTo(tcf)
                else
                    disableHover()
                    MovementGoTo(tcf - Vector3.new(0, getFarmHeightForType(typeStr), 0))
                end

                if folder then
                    local currentCount = 0
                    for _, e in ipairs(folder:GetChildren()) do
                        if isEnemyAlive(e) then currentCount = currentCount + 1 end
                    end
                    if currentCount > initialCount then break end
                end

                local anyCoveredAlive = false
                for _, enemy in ipairs(targets) do
                    if isEnemyAlive(enemy) then
                        local ecf = getObjectCFrame(enemy)
                        if ecf then
                            local dist = (Vector2.new(ecf.Position.X, ecf.Position.Z) - Vector2.new(tcf.Position.X, tcf.Position.Z)).Magnitude
                            if dist <= range * 0.95 then anyCoveredAlive = true; break end
                        end
                    end
                end
                if not anyCoveredAlive then break end
                task.wait(0.01)
            end
        else
            for _, enemy in ipairs(targets) do
                if not checkEnabledFunc() then break end

                if folder then
                    local currentCount = 0
                    for _, e in ipairs(folder:GetChildren()) do
                        if isEnemyAlive(e) then currentCount = currentCount + 1 end
                    end
                    if currentCount > initialCount then break end
                end

                local lastHealth = getEnemyHealth(enemy)
                local lastHealthChangeTime = tick()
                local isDropping = false
                local dropStartTime = 0

                while isEnemyAlive(enemy) and checkEnabledFunc() do
                    local currentHealth = getEnemyHealth(enemy)
                    if currentHealth ~= lastHealth and currentHealth > 0 then
                        lastHealth = currentHealth
                        lastHealthChangeTime = tick()
                    end

                    if not isDropping and (tick() - lastHealthChangeTime > 5.0) then
                        isDropping = true
                        dropStartTime = tick()
                    end

                    if isDropping and (tick() - dropStartTime > 2.0) then
                        isDropping = false
                        lastHealthChangeTime = tick()
                    end

                    isHoverEnabled = getHoverState(typeStr)
                    if isHoverEnabled and not isDropping then enableHover() else disableHover() end

                    if folder then
                        local currentCount = 0
                        for _, e in ipairs(folder:GetChildren()) do
                            if isEnemyAlive(e) then currentCount = currentCount + 1 end
                        end
                        if currentCount > initialCount then break end
                    end

                    local cf = getObjectCFrame(enemy)
                    if cf then
                        local heightOffset = (isHoverEnabled and not isDropping) and getFarmHeightForType(typeStr) or 0
                        MovementGoTo(cf + Vector3.new(0, heightOffset, 0))
                    end
                    task.wait(0.01)
                end
            end
        end
    else
        if typeStr == "Farm" then disableHover() else enableHover() end
    end
end

