    while task.wait(1) do
        if isMultiplayerPaused() then continue end
        if State.isJoining then continue end
        if State.isReturning then continue end

        local isEnabled = Options.AutoTombRaid and Options.AutoTombRaid.Value
        if not isEnabled then continue end
        if State.currentMode then continue end
        if not State.canJoin.TombRaid then continue end

        -- Sadece normal dünyadayken oluştur
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if not visibility or not string.match(tostring(visibility), "^World:") then continue end

        -- Teleport loading varsa bekle
        local tl = getTeleportLoading()
        if tl and tl.Visible then continue end

        -- Daha yüksek öncelikli bir mod daveti varsa (chat veya notify), önce onun işlenmesini bekle
        local blocked = false
        for _, info in ipairs(GAMEMODE_INVITES) do
            local otherEnabled = Options[info.optionKey] and Options[info.optionKey].Value
            if otherEnabled and State.canJoin[info.mode] and State.priorities[info.mode] < State.priorities.TombRaid then
                if info.source == "chat" and isChatInviteActive(info.mode) then
                    blocked = true; break
                elseif info.source == "notify" then
                    pcall(function()
                        local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
                        local gamemodeNotify = hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("GamemodeNotify")
                        if gamemodeNotify then
                            local notify = gamemodeNotify:FindFirstChild(info.notifyName)
                            if notify and notify.Visible then blocked = true end
                        end
                    end)
                    if blocked then break end
                end
            end
        end
        if blocked then continue end

        State.isJoining = true

        if Options.AutoReturnTombRaid and Options.AutoReturnTombRaid.Value then
            saveReturnData()
            task.wait(0.3)
        end

        fireTombRaidCreate()
