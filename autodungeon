local function executeAutoReturn()
    disableHover()
    if not savedReturnWorld or not savedReturnCFrame then return end

    pcall(function()
        local tl = getTeleportLoading()
        if tl and tl.Visible then
            waitForLoadingScreen(tl)
            task.wait(0.5)
        end
    end)

    local currentVis = LocalPlayer:GetAttribute("VisibilityContext")
    local targetVis = "World:" .. tostring(savedReturnWorld)

    if currentVis == targetVis then
        MovementGoTo(savedReturnCFrame)
    else
        -- Remote ile world değiştir (RequestChangeWorld)
        local worldNum = tonumber(savedReturnWorld)
        if worldNum ~= nil then
            local bridgeId = resolveBridgeId("RequestChangeWorld")
            local event = getBridgeEvent()
            if bridgeId and event then
                event:FireServer({ worldNum, bridgeId })
            end
        end

        waitForTeleportComplete()
        task.wait(0.5)

        local newVis = LocalPlayer:GetAttribute("VisibilityContext")
        if newVis == targetVis then
            MovementGoTo(savedReturnCFrame)
        end
    end
end

