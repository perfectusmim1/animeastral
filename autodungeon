local function gamemodeTakingOver()
    for _, info in ipairs(GAMEMODE_INVITES) do
        local isEnabled = Options[info.optionKey] and Options[info.optionKey].Value
        if isEnabled and isInviteAvailable(info) then return true end
    end
    for _, key in ipairs({ "AutoTombRaid", "AutoSoulRaid", "AutoBeachDefense", "AutoCloverRaid", "AutoInfinityCastle", "AutoTitanDefense", "AutoTimelessRaid", "AutoCursedRush", "AutoKingCursesRush", "AutoNinjaRaid", "AutoSinsRaid" }) do
        if Options[key] and Options[key].Value then return true end
    end
    return false
end

