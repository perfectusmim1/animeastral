local function hookGateBridge()
    if GateBridgeHooked then return end
    GateBridgeHooked = true
    task.spawn(function()
        pcall(function()
            local libWorld = ReplicatedStorage:WaitForChild("SimpleWorld", 5)
            local libObj = libWorld and libWorld:WaitForChild("Library", 5)
            if not libObj then return end
            local Library = require(libObj)
            if not Library or not Library.getBridge then return end

            local RaidAnnouncement = Library.getBridge("RaidAnnouncement")
            if not RaidAnnouncement then return end

            RaidAnnouncement:Connect(function(data)
                if type(data) == "table" and data.NotifyKind == "GamemodeOpen" and data.GateTeleport == true then
                    GateBridgeOpen = true
                    GateBridgeRank = data.GateRank
                    GateBridgeTime = tick()
                end
            end)
        end)
    end)
end

