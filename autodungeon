local function promoCraftEnsureKeep(worldNum)
    worldNum = tonumber(worldNum)
    if not worldNum then return end
    local fixedAt = promoCraftKeepFixed[worldNum]
    if fixedAt and tick() - fixedAt < 300 then return end
    pcall(function()
        local craft = promoLibrary.getConfig("CraftConfig")
        local recipe = craft and craft:GetRecipe("World" .. worldNum)
        if not recipe then return end
        local aac = promoAutoActionController
        if not (aac and aac.CycleAction) then return end
        local petsData = promoLibrary.getConfig("PetsData")
        local rarity = petsData and petsData[recipe.PetId] and petsData[recipe.PetId].Rarity
        if not rarity then return end
        local worldKey = "World" .. worldNum
        local pa = promoPlayerData and promoPlayerData.Data and promoPlayerData.Data.PetAutoActions
        local cur = pa and pa[worldKey] and pa[worldKey][rarity]
        local needIndex = false
        pcall(function()
            local st = promoGetState()
            if st then
                for _, m in ipairs(st.Missions or {}) do
                    if m.Type == "IndexMapsCompleted" then
                        needIndex = not m.Complete and (Options.PromoAutoIndex and Options.PromoAutoIndex.Value)
                        break
                    end
                end
            end
        end)
        if not needIndex and not promoCraftKeepFixed[worldNum] then return end
        local crafted = promoPlayerData.Data and promoPlayerData.Data.PetHistory
            and promoPlayerData.Data.PetHistory[recipe.ResultPetId] == true
        if not needIndex then
            if cur ~= "deleteShiny" then
                local n = 0
                while n < 5 do
                    local action = aac:CycleAction(worldKey, rarity)
                    if action == "deleteShiny" then break end
                    n = n + 1
                end
                if lastIndexLog ~= ("craftrestore:" .. tostring(worldNum)) then
                    lastIndexLog = "craftrestore:" .. tostring(worldNum)
                end
            end
        elseif crafted then
            if cur ~= "deleteShiny" then
                local n = 0
                while n < 5 do
                    local action = aac:CycleAction(worldKey, rarity)
                    if action == "deleteShiny" then break end
                    n = n + 1
                end
                if lastIndexLog ~= ("craftdel:" .. tostring(worldNum)) then
                    lastIndexLog = "craftdel:" .. tostring(worldNum)
                end
            end
        elseif cur ~= nil then
            local n = 0
            while n < 5 do
                local action = aac:CycleAction(worldKey, rarity)
                if action == nil then break end
                n = n + 1
            end
            if lastIndexLog ~= ("craftkeep:" .. tostring(worldNum)) then
                lastIndexLog = "craftkeep:" .. tostring(worldNum)
            end
        end
    end)
    promoCraftKeepFixed[worldNum] = tick()
end

local function promoCraftStep(worldNum)
    pcall(function()
        local craft = promoLibrary.getConfig("CraftConfig")
        if not craft or not craft.GetRecipe then return end
        local recipe = craft:GetRecipe("World" .. worldNum)
        if not recipe then return end
        promoCraftEnsureKeep(worldNum)
        promoCraftFetchData()
        local petCount, shinyCount, shards = promoCraftCount(recipe)
        local normalNeed = tonumber(recipe.PetAmount) or 3
        local shinyNeed = tonumber(recipe.ShinyPetAmount) or normalNeed
        local normalShards = tonumber(recipe.ItemAmount) or 25
        local shinyShards = tonumber(recipe.ShinyCraftedPrice) or 75
        local fire, fireShiny = false, false
        if shinyCount >= shinyNeed and shards >= shinyShards then
            fire, fireShiny = true, true
        elseif petCount >= normalNeed and shards >= normalShards then
            fire, fireShiny = true, false
        end
        if fire and tick() - promoLastCraftFire > 4 then
            promoLastCraftFire = tick()
            local b = promoLibrary.getBridge("CraftPet")
            if b then
                b:Fire("World" .. worldNum, fireShiny)
                local which = fireShiny and "shiny" or "normal"
                if lastIndexLog ~= ("craft:" .. tostring(worldNum) .. which) then
                    lastIndexLog = "craft:" .. tostring(worldNum) .. which
                end
            end
        end
    end)
end

