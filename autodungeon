task.spawn(function()
    while task.wait(0.3) do
        if isMultiplayerPaused() then
            disableHover()
            continue
        end

        local inDungeon, dungeonFolder = detectDungeon()
        local inGate, gateFolder = detectGate()
        local inTrialEasy, trialEasyFolder = detectTrial("Easy")
        local inTrialMedium, trialMediumFolder = detectTrial("Medium")

        if inDungeon then
            State.currentMode = "Dungeon"
            State.enemiesFolder = dungeonFolder
        elseif inGate then
            State.currentMode = "Gate"
            State.enemiesFolder = gateFolder
        elseif inTrialEasy then
            State.currentMode = "TrialEasy"
            State.enemiesFolder = trialEasyFolder
        elseif inTrialMedium then
            State.currentMode = "TrialMedium"
            State.enemiesFolder = trialMediumFolder
        else
            State.currentMode = nil
            State.enemiesFolder = nil
        end

        State.currentRoom = readCurrentRoom()
        State.currentWave = readCurrentWave()
        State.currentTrialRoom = readCurrentTrialRoom()

        if inDungeon and not State.wasIn.Dungeon then
            State.wasIn.Dungeon = true
            State.entryTime.Dungeon = tick()
            saveReturnData()
        end
        if inGate and not State.wasIn.Gate then
            State.wasIn.Gate = true
            State.entryTime.Gate = tick()
            saveReturnData()
        end
        if inTrialEasy and not State.wasIn.TrialEasy then
            State.wasIn.TrialEasy = true
            State.entryTime.TrialEasy = tick()
            saveReturnData()
        end
        if inTrialMedium and not State.wasIn.TrialMedium then
            State.wasIn.TrialMedium = true
            State.entryTime.TrialMedium = tick()
            saveReturnData()
        end

        if not inDungeon then State.hasLeft.Dungeon = false; State.entryTime.Dungeon = nil end
        if not inGate then State.hasLeft.Gate = false; State.entryTime.Gate = nil end
        if not inTrialEasy then State.hasLeft.TrialEasy = false; State.entryTime.TrialEasy = nil end
        if not inTrialMedium then State.hasLeft.TrialMedium = false; State.entryTime.TrialMedium = nil end

        -- Priority calculation
        local currentMinute = os.date("*t").min
        local function isTimingActive(gamemodeKey)
            local toggleKey = gamemodeKey .. "TimingToggle"
            local dropKey = gamemodeKey .. "Times"
            if Options[toggleKey] and Options[toggleKey].Value then
                local selected = selectedMultiValues(Options[dropKey] and Options[dropKey].Value)
                for _, timeStr in ipairs(selected) do
                    local minStr = timeStr:match("xx:(%d+)")
                    if minStr then
                        local targetMin = tonumber(minStr)
                        local diff = currentMinute - targetMin
                        if diff < 0 then diff = diff + 60 end
                        if diff == 0 then return true, true end
                    end
                end
                return false, true
            end
            return false, false
        end

        local tActiveDungeon, tRestrDungeon = isTimingActive("Dungeon")
        local tActiveGate, tRestrGate = isTimingActive("Gate")
        local tActiveTrialEasy, tRestrTrialEasy = isTimingActive("TrialEasy")
        local tActiveTrialMedium, tRestrTrialMedium = isTimingActive("TrialMedium")

        State.priorities = {
            Dungeon = tActiveDungeon and 0 or (tonumber(Options.DungeonPriority and Options.DungeonPriority.Value) or 1),
            Gate = tActiveGate and 0 or (tonumber(Options.GatePriority and Options.GatePriority.Value) or 2),
            TrialEasy = tActiveTrialEasy and 0 or (tonumber(Options.TrialEasyPriority and Options.TrialEasyPriority.Value) or 3),
            TrialMedium = tActiveTrialMedium and 0 or (tonumber(Options.TrialMediumPriority and Options.TrialMediumPriority.Value) or 4),
        }

        local canJoin = {
            Dungeon = not tRestrDungeon or tActiveDungeon,
            Gate = not tRestrGate or tActiveGate,
            TrialEasy = not tRestrTrialEasy or tActiveTrialEasy,
            TrialMedium = not tRestrTrialMedium or tActiveTrialMedium,
        }

        if State.currentMode then
            local currentPriority = State.priorities[State.currentMode]
            if Options.LeaveForHigherPriority and Options.LeaveForHigherPriority.Value then
                for mode, _ in pairs(canJoin) do
                    if canJoin[mode] then
                        canJoin[mode] = State.priorities[mode] < currentPriority
                    end
                end
            else
                for mode, _ in pairs(canJoin) do canJoin[mode] = false end
            end
        end

        State.canJoin = canJoin
    end
end)

