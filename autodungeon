    pcall(function()
        local seen = {}
        for petId, info in pairs(petInventoryCache) do
            if type(petId) ~= "string" or type(info) ~= "table" or type(info.PetId) ~= "string" then continue end
            local display = info.PetId .. " | " .. tostring(info.Rarity)
                .. (info.Shiny and " | Shiny" or "")
                .. " | " .. formatMultiplier(info.Multiplier)
            local count = seen[display] or 0
            seen[display] = count + 1
            if count > 0 then display = display .. " (" .. (count + 1) .. ")" end
