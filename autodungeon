local gqWaveOwnedAuto = nil
local gqWaveOwnedLeave = nil

gqSyncWaveToggles = function()
    local activeMode = nil
    local activeQ = nil
    local withLeave = false
    if Options.AutoGlobalQuest and Options.AutoGlobalQuest.Value
        and not (Options.AutoQuest and Options.AutoQuest.Value)
        and not (Options.AutoSideQuest and Options.AutoSideQuest.Value)
        and not isMultiplayerPaused() then
        local st = gqState()
        if st and st.Quests then
            local sel = selectedMultiValues(Options.GlobalQuestSelect and Options.GlobalQuestSelect.Value)
            for _, kind in ipairs({ "complete", "waves" }) do
                if activeMode then break end
                for _, label in ipairs(sel) do
                    local idx = tonumber(tostring(label):match("%[(%d+)%]"))
                    if idx then
                        for _, q in ipairs(st.Quests) do
                            if q.Index == idx and not q.Complete and not q.Claimed then
                                local k, parsed = gqParse(q.Objective)
                                if k == kind then
                                    local entry = gqFind(GQ_MODES, parsed)
                                    if entry and gqWorldUnlocked(entry.world) then
                                        activeMode = parsed
                                        activeQ = q
                                        withLeave = (kind == "waves")
                                    end
                                end
                                break
                            end
                        end
                    end
                    if activeMode then break end
                end
            end
        end
    end

    local activeOpts = nil
    if activeMode then
        activeOpts = gqFind(GQ_MODES, activeMode)
    end

    if activeOpts then
        if Options[activeOpts.auto] and not Options[activeOpts.auto].Value then
            pcall(function() Options[activeOpts.auto]:SetValue(true) end)
        end
        gqWaveOwnedAuto = activeOpts.auto
        if withLeave then
            if Options[activeOpts.leave] and not Options[activeOpts.leave].Value then
                pcall(function() Options[activeOpts.leave]:SetValue(true) end)
            end
            gqWaveOwnedLeave = activeOpts.leave
        else
            if Options[activeOpts.leave] and Options[activeOpts.leave].Value then
                pcall(function() Options[activeOpts.leave]:SetValue(false) end)
            end
            gqWaveOwnedLeave = nil
        end
        local prog = string.format(" (%d/%d)", activeQ.Current or 0, activeQ.Required or 0)
        GlobalQuestStatus:SetDesc("Status: " .. activeMode .. prog .. (withLeave and "\nAuto & Auto Leave on" or "\nAuto on"))
    else
        if gqWaveOwnedAuto and Options[gqWaveOwnedAuto] and Options[gqWaveOwnedAuto].Value then
            pcall(function() Options[gqWaveOwnedAuto]:SetValue(false) end)
        end
        if gqWaveOwnedLeave and Options[gqWaveOwnedLeave] and Options[gqWaveOwnedLeave].Value then
            pcall(function() Options[gqWaveOwnedLeave]:SetValue(false) end)
        end
        gqWaveOwnedAuto = nil
        gqWaveOwnedLeave = nil
    end
end

