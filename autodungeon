-- TOMB RAID REMOTES
-- BridgeNet2 byte identifier'ları ("\xA8" gibi) her sunucu/oturum ve
-- güncellemede yeniden atanır; sabit değer kullanmak scripti bozar.
-- Bu yüzden identifier, bridge ADİNDAN (isimler oyun kaynak kodunda sabittir)
-- runtime'da dinamik olarak çözülür.
-- ══════════════════════════════════════════════════════════════

local function getBridgeFolder()
    return ReplicatedStorage:FindFirstChild("BridgeNet2")
end

local function getBridgeEvent()
    local bridge = getBridgeFolder()
    return bridge and bridge:FindFirstChild("dataRemoteEvent")
end

-- BridgeNet2 identifier haritasını çıkar (isim -> byte id)
-- Bu oyun identifier'ları attribute/StringValue olarak SAKLAMIYOR;
-- bu yüzden client modülünün belleğindeki tablolar getgc ile taranır.
function buildBridgeIdentifierMap()
    local map = {}
    local folder = getBridgeFolder()

    -- Yöntem 1: attribute / StringValue (bazı BridgeNet2 sürümleri için)
    if folder then
        for name, value in pairs(folder:GetAttributes()) do
            if type(value) == "string" then map[name] = value end
        end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("StringValue") and map[child.Name] == nil then
                map[child.Name] = child.Value
            end
        end
    end

    -- Yöntem 2: bellekteki identifier tablolarını tara
    -- (isim -> kısa byte id veya tersi şeklindeki string tabloları aranır)
    if typeof(getgc) == "function" then
        local ok, gc = pcall(getgc, true)
        if ok and type(gc) == "table" then
            for _, obj in ipairs(gc) do
                if type(obj) == "table" then
                    pcall(function()
                        local total = 0
                        for k, v in pairs(obj) do
                            if type(k) ~= "string" or type(v) ~= "string" then error("skip") end
                            total = total + 1
                            if total > 300 then error("skip") end
                        end
                        if total < 2 then error("skip") end

                        local nameToId, idToName = true, true
                        for k, v in pairs(obj) do
                            if not (#v <= 3 and #k > 3) then nameToId = false end
                            if not (#k <= 3 and #v > 3) then idToName = false end
                            if not nameToId and not idToName then error("skip") end
                        end

                        if nameToId then
                            for k, v in pairs(obj) do
                                if map[k] == nil then map[k] = v end
                            end
                        elseif idToName then
                            for k, v in pairs(obj) do
                                if map[v] == nil then map[v] = k end
                            end
                        end
                    end)
                end
            end
        end
    end

    return map
end

-- Genel bridge identifier çözümleyici (tüm modlar için)
local cachedBridgeMap = nil
local BridgeNet2Module = nil

local function getBridgeNet2Module()
    if BridgeNet2Module then return BridgeNet2Module end
    pcall(function()
        local lib = ReplicatedStorage:FindFirstChild("SimpleWorld")
        lib = lib and lib:FindFirstChild("Library")
        lib = lib and lib:FindFirstChild("Packages")
        lib = lib and lib:FindFirstChild("BridgeNet2")
        if lib then BridgeNet2Module = require(lib) end
    end)
    return BridgeNet2Module
end

local function resolveBridgeId(bridgeName)
    -- 1. Cache kontrol
    if cachedBridgeMap and cachedBridgeMap[bridgeName] then
        return cachedBridgeMap[bridgeName]
    end

    -- Xeno executor tespiti: getgc tablo döndürmez, direkt ReferenceIdentifier kullan
    local isXeno = false
    if typeof(getgc) == "function" then
        local testOk, testGc = pcall(getgc, true)
        if testOk and type(testGc) == "table" then
            local hasTable = false
            for _, obj in ipairs(testGc) do
                if type(obj) == "table" then hasTable = true; break end
            end
            if not hasTable then isXeno = true end
        end
    end

    if not isXeno then
        -- 2. getgc ile harita oluştur
        if not cachedBridgeMap then
            cachedBridgeMap = buildBridgeIdentifierMap()
        end
        if cachedBridgeMap[bridgeName] then return cachedBridgeMap[bridgeName] end
    else
        if not cachedBridgeMap then cachedBridgeMap = {} end
    end

    -- 3. Fallback: ReferenceIdentifier (Xeno veya getgc başarısız)
    local bn2 = getBridgeNet2Module()
    if bn2 and bn2.ReferenceIdentifier then
        local ok, id = pcall(bn2.ReferenceIdentifier, bridgeName, 5)
        if ok and id and type(id) == "string" then
            cachedBridgeMap[bridgeName] = id
            return id
        end
    end

    return nil
end

