-- LOOP 3: COMBAT (her 0.01s)
-- ══════════════════════════════════════════════════════════════

task.spawn(function()
    while task.wait(0.01) do
        if isMultiplayerPaused() then continue end

        local mode = State.currentMode
        if not mode then continue end
        if not State.enemiesFolder then continue end
        if State.hasLeft[mode] then continue end

        local isAutoEnabled = false
        if mode == "Dungeon" then isAutoEnabled = Options.AutoDungeon and Options.AutoDungeon.Value
        elseif mode == "Gate" then isAutoEnabled = Options.AutoGate and Options.AutoGate.Value
        elseif mode == "TombRaid" then isAutoEnabled = Options.AutoTombRaid and Options.AutoTombRaid.Value
        elseif mode == "SoulRaid" then isAutoEnabled = Options.AutoSoulRaid and Options.AutoSoulRaid.Value
        elseif mode == "BeachDefense" then isAutoEnabled = Options.AutoBeachDefense and Options.AutoBeachDefense.Value
        elseif mode == "CloverRaid" then isAutoEnabled = Options.AutoCloverRaid and Options.AutoCloverRaid.Value
        elseif mode == "InfinityCastle" then isAutoEnabled = Options.AutoInfinityCastle and Options.AutoInfinityCastle.Value
        elseif mode == "TitanDefense" then isAutoEnabled = Options.AutoTitanDefense and Options.AutoTitanDefense.Value
        elseif mode == "TimelessRaid" then isAutoEnabled = Options.AutoTimelessRaid and Options.AutoTimelessRaid.Value
        elseif mode == "NinjaRaid" then isAutoEnabled = Options.AutoNinjaRaid and Options.AutoNinjaRaid.Value
        elseif mode == "CursedRush" then isAutoEnabled = Options.AutoCursedRush and Options.AutoCursedRush.Value
        elseif mode == "KingCursesRush" then isAutoEnabled = Options.AutoKingCursesRush and Options.AutoKingCursesRush.Value
        elseif mode == "TrialEasy" then isAutoEnabled = Options.AutoTrialEasy and Options.AutoTrialEasy.Value
        elseif mode == "TrialMedium" then isAutoEnabled = Options.AutoTrialMedium and Options.AutoTrialMedium.Value
        end
        if not isAutoEnabled then continue end

        local tl = getTeleportLoading()
        if tl and tl.Visible then
            waitForLoadingScreen(tl)
            task.wait(0.5)
            continue
        end

        -- Auto leave check
        local shouldLeave = false

        -- Yüksek öncelikli davet varsa zorla leave ("Leave for Higher Priority")
        if not shouldLeave and Options.LeaveForHigherPriority and Options.LeaveForHigherPriority.Value then
            local currentPriority = State.priorities[mode] or 99
            for _, info in ipairs(GAMEMODE_INVITES) do
                local otherEnabled = Options[info.optionKey] and Options[info.optionKey].Value
                if otherEnabled and State.priorities[info.mode] and State.priorities[info.mode] < currentPriority then
                    if isInviteAvailable(info) then
                        shouldLeave = true; break
                    end
                end
            end
        end

        if mode == "Dungeon" then
            local leaveEnabled = Options.AutoLeave and Options.AutoLeave.Value
            local targetRoom = tonumber(Options.LeaveRoom and Options.LeaveRoom.Value) or 50
            if leaveEnabled and targetRoom > 0 then
                local aliveCount = 0
                for _, e in ipairs(State.enemiesFolder:GetChildren()) do
                    if isEnemyAlive(e) then aliveCount = aliveCount + 1 end
                end
                if State.currentRoom > targetRoom or (State.currentRoom == targetRoom and aliveCount == 0) then
                    shouldLeave = true
                end
            end
        elseif mode == "Gate" then
            local leaveEnabled = Options.AutoLeaveGate and Options.AutoLeaveGate.Value
            local targetWave = tonumber(Options.LeaveGateWave and Options.LeaveGateWave.Value) or 50
            if leaveEnabled and targetWave > 0 then
                local aliveCount = 0
                for _, e in ipairs(State.enemiesFolder:GetChildren()) do
                    if isEnemyAlive(e) then aliveCount = aliveCount + 1 end
                end
                if State.currentWave > targetWave or (State.currentWave == targetWave and aliveCount == 0) then
                    shouldLeave = true
                end
            end
        elseif mode == "TombRaid" then
            local leaveEnabled = Options.AutoLeaveTombRaid and Options.AutoLeaveTombRaid.Value
            local targetWave = tonumber(Options.LeaveTombRaidWave and Options.LeaveTombRaidWave.Value) or 50
