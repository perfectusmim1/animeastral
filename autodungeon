local function resolveBridgeId(bridgeName)

    if cachedBridgeMap and cachedBridgeMap[bridgeName] then
        return cachedBridgeMap[bridgeName]
    end

    local isXeno = false
    if typeof(getgc) == "function" then
        local testOk, testGc = pcall(getgc, true)
        if testOk and type(testGc) == "table" then
            local hasTable = false
            for _, obj in ipairs(testGc) do
                if type(obj) == "table" then hasTable = true; break end
            end
            if not hasTable then isXeno = true end
        end
    end

    if not isXeno then

        if not cachedBridgeMap then
            cachedBridgeMap = buildBridgeIdentifierMap()
        end
        if cachedBridgeMap[bridgeName] then return cachedBridgeMap[bridgeName] end
    else
        if not cachedBridgeMap then cachedBridgeMap = {} end
    end

    local bn2 = getBridgeNet2Module()
    if bn2 and bn2.ReferenceIdentifier then
        local ok, id = pcall(bn2.ReferenceIdentifier, bridgeName, 5)
        if ok and id and type(id) == "string" then
            cachedBridgeMap[bridgeName] = id
            return id
        end
    end

    return nil
end

