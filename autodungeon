local function promoKillMobs(targets, worldNum)
    if worldNum and not promoWorldUnlocked(worldNum) then return false end
    if worldNum and promoGetCurrentWorld() ~= worldNum then
        promoTeleportToWorld(worldNum)
        task.wait(1.2)
    end
    local folder = activeEnemiesFolder()
    if not folder then
        if worldNum then
            promoTeleportToWorld(worldNum)
            local first = targets[1]
            goToBossArea(worldNum, first and first.mob, first and first.id)
        end
        return false
    end
    local allTargets = {}
    local function addTargets(key)
        if not key then return end
        for _, a in ipairs(MOB_ALIASES[tostring(key)] or { tostring(key) }) do
            table.insert(allTargets, a)
        end
    end
    for _, t in ipairs(targets) do
        addTargets(t.mob)
        addTargets(t.id)
    end
    local best, bestDist = nil, math.huge
    local root = getRootPart()
    for _, target in ipairs(allTargets) do
        for _, enemy in ipairs(folder:GetChildren()) do
            if isEnemyAlive(enemy) and matchesEnemy(enemy, target) then
                local cf = getObjectCFrame(enemy)
                if cf then
                    local dist = root and (root.Position - cf.Position).Magnitude or 0
                    if dist < bestDist then best, bestDist = cf, dist end
                end
            end
        end
        if best then break end
    end
    if not best then
        if worldNum then
            local first = targets[1]
            goToBossArea(worldNum, first and first.mob, first and first.id)
        end
        return false
    end
    if bestDist > 10 then
        MovementGoTo(CFrame.new(best.Position + Vector3.new(0, 6, 0)))
    end
    return true
end

