                        end
                    end
                end
            end
        end
    end)

    return inTimeless, folder
end

local function detectNinjaRaid()
    local inNinja = false
    local folder = nil

    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if isNinjaRaidContext(visibility) then
            inNinja = true
            local raidArenas = workspace:FindFirstChild("RaidArenas")
            if raidArenas then
                local worldName = tostring(visibility):match("^Raid:(.+)")
                if worldName then
                    local w = raidArenas:FindFirstChild(worldName)
                    if w then folder = w:FindFirstChild("Enemies") end
                end
                if not folder then
                    for _, arena in ipairs(raidArenas:GetChildren()) do
                        if string.find(arena.Name, "^World1_") then
                            local ef = arena:FindFirstChild("Enemies")
                            if ef then folder = ef; break end
                        end
                    end
                end
            end
        end
    end)

    return inNinja, folder
end

local function detectTrial(difficulty)
    local inTrial = false
    local folder = nil
    local visKey = "Trial:" .. difficulty
    local arenaName = difficulty

    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if visibility == visKey then
            inTrial = true
            local arena = workspace:FindFirstChild("TimeTrialArenas")
            if arena then
                local a = arena:FindFirstChild(arenaName)
                if a then folder = a:FindFirstChild("Enemies") end
            end
        else
            local trialGui = LocalPlayer.PlayerGui:FindFirstChild("TrialGui")
            if trialGui and trialGui.Enabled then
                local mainFrame = trialGui:FindFirstChild("Main")
                if mainFrame and mainFrame.Visible then
                    local arena = workspace:FindFirstChild("TimeTrialArenas")
                    if arena then
                        local a = arena:FindFirstChild(arenaName)
                        if a and a:FindFirstChild("Enemies") and #a.Enemies:GetChildren() > 0 then
                            inTrial = true
                            folder = a.Enemies
                        end
                    end
                end
            end
        end
    end)

    local notifyName = "Notify_TimeTrial_" .. difficulty
    pcall(function()
        local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
        local notify = hud and hud:FindFirstChild("Main")
            and hud.Main:FindFirstChild("GamemodeNotify")
            and hud.Main.GamemodeNotify:FindFirstChild(notifyName)
        if notify and notify.Visible then inTrial = false end
    end)

    return inTrial, folder
end

local function isInCursedRush()
    local vis = LocalPlayer:GetAttribute("VisibilityContext")
    return vis ~= nil and string.find(tostring(vis), "^BossRush:CursedRush") ~= nil
end

local function detectCursedRush()
    local inCursed = false
    local arena = nil

    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if visibility and string.find(visibility, "^BossRush:CursedRush") then
            inCursed = true
            local bossArenas = workspace:FindFirstChild("BossRushArenas")
            if bossArenas then
                -- Arena adını doğrudan context'ten al (BossRush:CursedRush_X_Y -> CursedRush_X_Y),
                -- böylece uniq id değişse bile her zaman kendi arenamız bulunur
                local arenaName = visibility:match("^BossRush:(.+)")
                if arenaName then
                    arena = bossArenas:FindFirstChild(arenaName)
