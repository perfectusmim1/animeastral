    gqAllQuests = {}
    local vals = {}
    for _, q in ipairs(st.Quests) do
        if Options.HideCompletedGQ and Options.HideCompletedGQ.Value and q.Complete then continue end
        local kind, parsed = gqParse(q.Objective)
        if not kind then continue end
        local world = nil
        local ok = true
        if kind == "kill" or kind == "obtain" then
            local entry = gqFind(GQ_KILL, parsed) or gqFind(GQ_OBTAIN, parsed)
            if not entry then ok = false end
            world = entry and entry.world
        elseif kind == "roll" then
            local rw = gqFind(GQ_ROLL, parsed)
            if not rw then ok = false end
            world = rw and tonumber(rw:match("World(%d+)"))
