task.spawn(function()
    local gqListBuilt = false
    while task.wait(0.5) do
        if gqSyncWaveToggles then gqSyncWaveToggles() end

        if isMultiplayerPaused() then continue end
        if State.currentMode then continue end
        if not (Options.AutoGlobalQuest and Options.AutoGlobalQuest.Value) then continue end
        if Options.AutoQuest and Options.AutoQuest.Value then continue end
        if Options.AutoSideQuest and Options.AutoSideQuest.Value then continue end
        local st = gqState()
        if not st or not st.Quests then continue end
        local quests = st.Quests
        if not gqListBuilt then
            rebuildGqList()
            gqListBuilt = true
        end

        local claimedAny = false
        for _, q in ipairs(quests) do
            if q.Complete and not q.Claimed then
                fireBridge("GlobalQuestClaim", q.Index, true)
                claimedAny = true
            end
        end
        if claimedAny then
            GlobalQuestStatus:SetDesc("Status: Claiming global quests...")
            task.wait(0.6)
            continue
        end

        local buckets = { kill = {}, roll = {}, join = {}, complete = {}, waves = {}, sidequests = {} }
        for _, q in ipairs(quests) do
            if q.Complete or q.Claimed then continue end
            local kind, parsed = gqParse(q.Objective)
            if kind == "kill" or kind == "obtain" then
                local entry = gqFind(GQ_KILL, parsed) or gqFind(GQ_OBTAIN, parsed)
                if entry and gqWorldUnlocked(entry.world) then
                    table.insert(buckets.kill, { q = q, kind = kind, parsed = parsed, entry = entry })
                end
            elseif kind == "join" then
                local entry = gqFind(GQ_MODES, parsed)
                if entry and gqWorldUnlocked(entry.world) then
                    table.insert(buckets.join, { q = q, kind = kind, parsed = parsed })
                end
            elseif kind == "complete" then
                local entry = gqFind(GQ_MODES, parsed)
                if entry and gqWorldUnlocked(entry.world) then
                    table.insert(buckets.complete, { q = q, kind = kind, parsed = parsed })
                end
            elseif kind == "waves" then
                local entry = gqFind(GQ_MODES, parsed)
                if entry and gqWorldUnlocked(entry.world) then
                    table.insert(buckets.waves, { q = q, kind = kind, parsed = parsed })
                end
            elseif kind == "sidequests" then
                if not (Options.AutoSideQuest and Options.AutoSideQuest.Value) then
                    table.insert(buckets.sidequests, { q = q, kind = kind })
                end
            end
        end

        local function bestOf(bucket)
            local best = nil
            for _, item in ipairs(bucket) do
                local q = item.q
                if best == nil or q.Current / q.Required < best.q.Current / best.q.Required then
                    best = item
                end
            end
            return best
        end

        local item = nil
        local selected = selectedMultiValues(Options.GlobalQuestSelect and Options.GlobalQuestSelect.Value)
        if #selected > 0 then
            for _, kind in ipairs({ "kill", "complete", "waves", "join", "sidequests" }) do
                for _, label in ipairs(selected) do
                    local idx = tonumber(tostring(label):match("%[(%d+)%]"))
                    if idx then
                        for _, b in ipairs(buckets[kind]) do
                            if b.q.Index == idx then item = b break end
                        end
                        if item then break end
                    end
                end
                if item then break end
            end
        else
            for _, kind in ipairs({ "kill", "complete", "waves", "join" }) do
                item = bestOf(buckets[kind])
                if item then break end
            end
        end

        if not item then
            local rollSelected = nil
            for _, label in ipairs(selected) do
                local idx = tonumber(tostring(label):match("%[(%d+)%]"))
                if idx then
                    for _, q in ipairs(quests) do
                        if q.Index == idx and not q.Complete and not q.Claimed then
                            local kind, parsed = gqParse(q.Objective)
                            if kind == "roll" and gqFind(GQ_ROLL, parsed) then
                                local rw = gqFind(GQ_ROLL, parsed)
                                local world = tonumber(rw:match("World(%d+)"))
                                if world and gqWorldUnlocked(world) then rollSelected = q end
                            end
                            break
                        end
                    end
                end
                if rollSelected then break end
            end
            if rollSelected then
                GlobalQuestStatus:SetDesc(string.format("Status: Rolling %s (%d/%d)", rollSelected.Objective, rollSelected.Current or 0, rollSelected.Required or 0))
            else
                GlobalQuestStatus:SetDesc("Status: Waiting for unlocked quests...")
            end
            continue
        end

        local q = item.q
        GlobalQuestStatus:SetDesc(string.format("Status: %s (%d/%d)", q.Objective, q.Current, q.Required))
        if item.kind == "kill" or item.kind == "obtain" then
            gqKill(item.entry)
        elseif item.kind == "join" then
            gqJoin(item.parsed)
        elseif item.kind == "complete" then
            gqCompleteJoin(item.parsed)
        elseif item.kind == "waves" then
            gqSyncWaveToggles()
        elseif item.kind == "sidequests" then
            gqSideQuestStep()
        end
    end
end)

