local function systemCompleted(worldNum, sysType, sysKey)
    local d = promoPlayerData.Data
    if not d then return false end
    local ok = false
    pcall(function()
        local wc = promoLibrary.getConfig("WorldConfig")
        local sk = wc:GetSystemKey(worldNum, sysKey)
        if not sk then return end
        if sysType == "Gacha" then
            local gc = promoLibrary.getConfig("GachaConfig")
            local active = d.ActiveGachas and d.ActiveGachas[sk]
            if type(active) ~= "string" then return end
            local ri = gc:GetRarityIndex(active)
            local di = gc:GetRarityIndex("Divine")
            ok = type(ri) == "number" and type(di) == "number" and di > 0 and di <= ri
        elseif sysType == "Upgrades" then
            local uc = promoLibrary.getConfig("UpgradesConfig")
            local sys = uc:GetSystem(sk)
            local lvls = d.MultiplierUpgrades and d.MultiplierUpgrades[sk]
            if not sys or type(sys.Upgrades) ~= "table" then return end
            local all = true
            for k, j in pairs(sys.Upgrades) do
                local max = tonumber(j and j.MaxLevel) or 0
                if max <= 0 then all = false break end
                local cur = type(lvls) == "table" and tonumber(lvls[k]) or 0
                if cur < max then all = false break end
            end
            ok = all
        elseif sysType == "Upgrades2" then
            local uc = promoLibrary.getConfig("Upgrades2Config")
            local sys = uc:GetSystem(sk)
            local lvls = d.Upgrades2Levels and d.Upgrades2Levels[sk]
            if not sys or type(sys.Upgrades) ~= "table" then return end
            local all = true
            for k, j in pairs(sys.Upgrades) do
                local max = tonumber(j and j.MaxLevel) or 0
                if max <= 0 or max == math.huge then all = false break end
                local cur = type(lvls) == "table" and tonumber(lvls[k]) or 0
                if cur < max then all = false break end
            end
            ok = all
        elseif sysType == "RangeUpgrade" then
            local rc = promoLibrary.getConfig("RangeUpgradeConfig")
            local u = rc:GetUpgrade(sk)
            local max = tonumber(u and u.MaxLevel) or 0
            local cur = tonumber(d.RangeLevel) or 1
            ok = max > 0 and cur >= max
        elseif sysType == "Progression" then
            local pc = promoLibrary.getConfig("ProgressionConfig")
            local p = pc:GetProgression(sk)
            local max = tonumber(p and p.MaxLevel) or 0
            local cur = tonumber(d.ActiveProgressions and d.ActiveProgressions[sk]) or 0
            ok = max > 0 and cur >= max
        elseif sysType == "Sword" then
            local sc = promoLibrary.getConfig("SwordConfig")
            local sword = sc:GetSword(sk)
            if not sword or type(sword.Items) ~= "table" then return end
            local top = nil
            for _, m in ipairs(sc.Rarity_Order or {}) do
                if sword.Items[m] ~= nil then top = m end
            end
            if not top then return end
            local owned = d.ActiveSwords and d.ActiveSwords[sk]
            local n = 0
            if type(owned) == "table" and type(owned[top]) == "table" then
                for k, v in pairs(owned[top]) do n = n + (tonumber(v) or 0) end
            end
            ok = n > 0
        elseif sysType == "Titans" then
            local tc2 = promoLibrary.getConfig("TitansConfig")
            local titan = tc2:GetTitan(sk)
            if not titan or type(titan.Items) ~= "table" then return end
            local top = nil
            for _, m in ipairs(tc2.Rarity_Order or {}) do
                if titan.Items[m] ~= nil then top = m end
            end
            if not top then return end
            local owned = d.ActiveTitans and d.ActiveTitans[sk]
            local n = 0
            if type(owned) == "table" and type(owned[top]) == "table" then
                for k, v in pairs(owned[top]) do n = n + (tonumber(v) or 0) end
            end
            ok = n > 0
        elseif sysType == "PlayerPassive" then
            local pc = promoLibrary.getConfig("PlayerPassiveConfig")
            for _, k5 in ipairs(pc:GetPassivesByRarity("Divine")) do
                if k5 and d.PassiveVault and d.PassiveVault[tostring(k5.Id)] then
                    ok = true
                    break
                end
            end
        elseif sysType == "Offering" then
            local oc = promoLibrary.getConfig("OfferingConfig")
            ok = oc:IsMaxed(sk, tonumber(d.Offerings and d.Offerings[sk]) or 0) == true
        end
    end)
    return ok
end

