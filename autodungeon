local function buildModeAliases()
    PROMO_MODE_ALIASES = {}
    local function add(key, name)
        if key then
            PROMO_MODE_ALIASES[tostring(key):gsub("%s+", ""):lower()] = name or key
        end
        if name then
            PROMO_MODE_ALIASES[tostring(name):gsub("%s+", ""):lower()] = name
        end
    end
    pcall(function()
        local lib = promoLibrary
        local rc = lib.getConfig("RaidConfig")
        for _, r in pairs(rc:GetAllRaids()) do
            if type(r) == "table" then add(r.AchievementModeKey, r.Name) end
        end
        local dc = lib.getConfig("DungeonConfig")
        for _, d in pairs(dc:GetAllDungeons()) do
            if type(d) == "table" then add(d.AchievementModeKey, d.Name) end
        end
        local tc = lib.getConfig("TimeTrialConfig")
        for _, t in pairs(tc:GetAllTrials()) do
            if type(t) == "table" then add(t.AchievementModeKey, t.Name) end
        end
        local fc = lib.getConfig("DefenseConfig")
        for _, f in pairs(fc:GetAllDefenses()) do
            if type(f) == "table" then add(f.AchievementModeKey, f.Name) end
        end
    end)
end
local function promoModeKey(gamemodeName)
    local norm = tostring(gamemodeName or ""):gsub("%s+", ""):lower()
    if not PROMO_MODE_ALIASES then buildModeAliases() end
    if PROMO_MODE_ALIASES[norm] then return PROMO_MODE_ALIASES[norm] end
    if not PROMO_MODE_LOOKUP then
        PROMO_MODE_LOOKUP = {}
        for k, v in pairs(GQ_MODES_PROMO) do
            PROMO_MODE_LOOKUP[tostring(k):gsub("%s+", ""):lower()] = k
        end
    end
    return PROMO_MODE_LOOKUP[norm]
end

