local function setupAutoRejoin()
    local TeleportService = game:GetService("TeleportService")
    local GuiService = game:GetService("GuiService")

    local isRejoining = false
    local function attemptRejoin(force)
        if isRejoining then return end
        local isEnabled = Options.AutoRejoin and Options.AutoRejoin.Value
        if not force and isEnabled == false then return end

        isRejoining = true
        task.wait(1)

        local placeId = game.PlaceId
        local jobId = game.JobId
        local psId = nil

        pcall(function()
            if game.PrivateServerId and game.PrivateServerId ~= "" then
                psId = game.PrivateServerId
            end
        end)

        if psId then
            pcall(function()
                TeleportService:TeleportToPrivateServer(placeId, psId, { LocalPlayer })
            end)
            task.wait(4)
        end

        if jobId and jobId ~= "" then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
            end)
            task.wait(3)
        end

        pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end

    manualRejoin = attemptRejoin

    pcall(function()
        GuiService.ErrorMessageChanged:Connect(function(msg)
            if msg and #msg > 0 then
                attemptRejoin()
            end
        end)
    end)

    pcall(function()
        local promptOverlay = CoreGui:WaitForChild("RobloxPromptGui", 5)
            and CoreGui.RobloxPromptGui:WaitForChild("promptOverlay", 5)
        if promptOverlay then
            promptOverlay.ChildAdded:Connect(function(child)
                if child.Name == "ErrorPrompt" then
                    attemptRejoin()
                end
            end)
            local existing = promptOverlay:FindFirstChild("ErrorPrompt")
            if existing then
                attemptRejoin()
            end
        end
    end)
end

