-- Arena bazlı algılama: workspace'te arena klasörü varsa mod açık demektir
local ARENA_CHECKS = {
    Dungeon = function()
        local arenas = workspace:FindFirstChild("DungeonArenas")
        return arenas and arenas:FindFirstChild("World9Dungeon") ~= nil
    end,
    TrialEasy = function()
        local arenas = workspace:FindFirstChild("TimeTrialArenas")
        return arenas and arenas:FindFirstChild("Easy") ~= nil
    end,
    TrialMedium = function()
        local arenas = workspace:FindFirstChild("TimeTrialArenas")
        return arenas and arenas:FindFirstChild("Medium") ~= nil
    end,
}

local function isArenaOpen(mode)
    local check = ARENA_CHECKS[mode]
    if not check then return false end
    local ok, result = pcall(check)
    return ok and result
end

-- Timing bazlı algılama (yedek): timing ayarlarında seçilen dakikadaysak mod "açık" kabul edilir
local TIMING_MODE_MAP = {
    Dungeon = "Dungeon",
    Gate = "Gate",
    TrialEasy = "TrialEasy",
    TrialMedium = "TrialMedium",
}

local function isTimingFallbackActive(mode)
    local timingKey = TIMING_MODE_MAP[mode]
    if not timingKey then return false end

    local toggleKey = timingKey .. "TimingToggle"
    local dropKey = timingKey .. "Times"
    if not (Options[toggleKey] and Options[toggleKey].Value) then return false end

    local selected = selectedMultiValues(Options[dropKey] and Options[dropKey].Value)
    local currentMin = os.date("*t").min

    for _, timeStr in ipairs(selected) do
        local minStr = timeStr:match("xx:(%d+)")
        if minStr then
            local targetMin = tonumber(minStr)
            if currentMin == targetMin then return true end
        end
    end
    return false
end

