local function isArenaOpen(mode)
    local check = ARENA_CHECKS[mode]
    if not check then return false end
    local ok, result = pcall(check)
    return ok and result
end

local function isGateBridgeActive()
    if not GateBridgeOpen then return false end

    if tick() - GateBridgeTime > 60 then
        GateBridgeOpen = false
        GateBridgeRank = nil
        return false
    end

    if GateBridgeRank then
        local selectedRanks = selectedMultiValues(Options.GateRanks and Options.GateRanks.Value)
        for _, r in ipairs(selectedRanks) do
            if r == GateBridgeRank then return true end
        end
        return false
    end
    return true
end

local function isInviteAvailable(info)

    if isArenaOpen(info.mode) then return true end

    if info.mode == "Gate" and isGateBridgeActive() then return true end
    return false
end

