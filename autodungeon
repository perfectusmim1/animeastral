local function formatMultiplier(n)
    n = tonumber(n) or 0
    local function trim(v, suffix)
        v = math.floor(v * 10 + 0.5) / 10
        if v == math.floor(v) then return tostring(math.floor(v)) .. suffix end
        return string.format("%.1f", v) .. suffix
    end
    if n >= 1e6 then return trim(n / 1e6, "m") end
    if n >= 1e3 then return trim(n / 1e3, "k") end
    return tostring(n)
end

local function findInventoryCache()
    if type(getgc) == "function" then
        pcall(function()
            local best, bestCount = nil, 0
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" then
                    local cache = rawget(v, "InventoryCache")
                    if type(cache) == "table" then
                        local count = 0
                        for _ in pairs(cache) do count = count + 1 end
                        if count > bestCount then best, bestCount = cache, count end
                    end
                end
            end
            if best then petInventoryCache = best end
        end)
    end
end

