local gqAutoFilled = false
local function gqAutoFill()
    if gqAutoFilled then return true end
    if not ensureQuestData() then return false end
    if not playerData.Ready then return false end
    local ok = pcall(function()
        local gqc = questLibrary and questLibrary.getConfig("GlobalQuestConfig")
        local ec = questLibrary and questLibrary.getConfig("EnemyConfig")
        local sqc = questLibrary and questLibrary.getConfig("SideQuestConfig")
        local st = gqState()
        if not gqc or not ec or not st or not st.Quests then return end
        local rawList = gqc:GetAll()
        if type(rawList) ~= "table" then return end
        local allEnemies = ec:GetAllEnemies()

        local function resolveEnemy(mob)
            local e = ec:GetEnemyByName(mob)
            if e then return e end
            for _, info in pairs(allEnemies) do
                if type(info) == "table" and info.ModelName == mob then return info end
            end
            return nil
        end

        GQ_KILL = {}
        GQ_OBTAIN = {}
        GQ_ROLL = {}
        for _, q in ipairs(st.Quests) do
            local raw = rawList[q.Index]
            if not raw then continue end
            if q.Type == "Defeat" and q.Mob then
                local enemy = resolveEnemy(q.Mob)
                if enemy and enemy.World then
                    GQ_KILL[q.EnemyName or q.Mob] = { world = enemy.World, names = { q.Mob, q.EnemyName or q.Mob } }
                end
            elseif q.Type == "GachaRoll" and q.EnemyName and raw.Gacha then
                GQ_ROLL[q.EnemyName] = raw.Gacha
            elseif q.Type == "AccessoryObtain" and q.EnemyName and raw.Accessory then
                for _, q2 in ipairs(st.Quests) do
                    if q2.Type == "Defeat" and q2.Mob then
                        local e = resolveEnemy(q2.Mob)
                        if e and e.World and e.Drops and e.Drops[raw.Accessory] then
                            GQ_OBTAIN[q.EnemyName] = {
                                world = e.World,
                                names = { q.EnemyName, e.ModelName or q2.Mob },
                            }
                            break
                        end
                    end
                end
            end
        end

        SIDE_QUESTS = {}
        if sqc and type(sqc.Quests) == "table" then
            for id, cq in pairs(sqc.Quests) do
                if type(cq) == "table" and cq.World and (cq.EnemyId or cq.EnemyName) then
                    table.insert(SIDE_QUESTS, {
                        id = id,
