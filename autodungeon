local function detectTrial(difficulty)
    local inTrial = false
    local folder = nil
    local visKey = "Trial:" .. difficulty
    local arenaName = difficulty

    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if visibility == visKey then
            inTrial = true
            local arena = workspace:FindFirstChild("TimeTrialArenas")
            if arena then
                local a = arena:FindFirstChild(arenaName)
                if a then folder = a:FindFirstChild("Enemies") end
            end
        else
            local trialGui = LocalPlayer.PlayerGui:FindFirstChild("TrialGui")
            if trialGui and trialGui.Enabled then
                local mainFrame = trialGui:FindFirstChild("Main")
                if mainFrame and mainFrame.Visible then
                    local arena = workspace:FindFirstChild("TimeTrialArenas")
                    if arena then
                        local a = arena:FindFirstChild(arenaName)
                        if a and a:FindFirstChild("Enemies") and #a.Enemies:GetChildren() > 0 then
                            inTrial = true
                            folder = a.Enemies
                        end
                    end
                end
            end
        end
    end)

    return inTrial, folder
end

local function isInCursedRush()
    local vis = LocalPlayer:GetAttribute("VisibilityContext")
    return vis ~= nil and string.find(tostring(vis), "^BossRush:CursedRush") ~= nil
end

local function detectCursedRush()
    local inCursed = false
    local arena = nil

    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if visibility and string.find(visibility, "^BossRush:CursedRush") then
            inCursed = true
            local bossArenas = workspace:FindFirstChild("BossRushArenas")
            if bossArenas then

                local arenaName = visibility:match("^BossRush:(.+)")
                if arenaName then
                    arena = bossArenas:FindFirstChild(arenaName)
                end
            end
        end
    end)

    return inCursed, arena
end

local function readCurrentRoom()
    local room = 0
    pcall(function()
        local roomLabel = LocalPlayer.PlayerGui:FindFirstChild("DungeonGui")
            and LocalPlayer.PlayerGui.DungeonGui:FindFirstChild("Main")
            and LocalPlayer.PlayerGui.DungeonGui.Main:FindFirstChild("Room")
        if roomLabel and roomLabel:IsA("TextLabel") then
            room = tonumber(roomLabel.Text:match("(%d+)")) or 0
        end
    end)
    return room
end

local function readCurrentWave()
    local wave = 0
    pcall(function()
        local mode = State.currentMode
        local gui, path

        if mode == "CursedRush" or mode == "KingCursesRush" then
            gui = LocalPlayer.PlayerGui:FindFirstChild("BossRushGui")
        elseif mode == "BeachDefense" or mode == "TitanDefense" then
            gui = LocalPlayer.PlayerGui:FindFirstChild("DefenseGui")
        else
            gui = LocalPlayer.PlayerGui:FindFirstChild("RaidGui")
        end

        if gui then
            local main = gui:FindFirstChild("Main")
            local waveLabel = main and main:FindFirstChild("Wave")
            if waveLabel and waveLabel:IsA("TextLabel") then
                wave = tonumber(waveLabel.Text:match("(%d+)")) or 0
            end
        end
    end)
    return wave
end

local function readCurrentTrialRoom()
    local room = 0
    pcall(function()
        local trialGui = LocalPlayer.PlayerGui:FindFirstChild("TrialGui")
        local roomLabel = trialGui and trialGui:FindFirstChild("Main")
            and trialGui.Main:FindFirstChild("Room")
        if roomLabel and roomLabel:IsA("TextLabel") then
            room = tonumber(roomLabel.Text:match("(%d+)")) or 0
        end
    end)
    return room
end

