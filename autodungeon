local isCollectingSukuna = false

local function findFingerPrompt(finger)
    local prompt = finger:FindFirstChild("FingerPrompt", true)
    if prompt and prompt:IsA("ProximityPrompt") then return prompt end
    return finger:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function triggerFingerPrompt(prompt)
    if not prompt then return false end
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if prompt.MaxActivationDistance < 30 then prompt.MaxActivationDistance = 30 end
    end)
    if typeof(fireproximityprompt) == "function" then
        if pcall(fireproximityprompt, prompt) then return true end
    end
    local held = pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    end)
    if held then return true end
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, prompt.KeyboardKeyCode or Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, prompt.KeyboardKeyCode or Enum.KeyCode.E, false, game)
    end)
    return ok
end

local function getAliveMobs(arena)
    local mobs = {}
    local enemies = arena and arena:FindFirstChild("Enemies")
    if not enemies then return mobs end
    for _, e in ipairs(enemies:GetChildren()) do
        if isEnemyAlive(e) then table.insert(mobs, e) end
    end
    return mobs
end

local function getPromptTargetCFrame(finger)
    -- Prompt'un bağlı olduğu parçayı hedefle (Cube.166 gibi), yoksa model pivotu
    local prompt = findFingerPrompt(finger)
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        return prompt.Parent.CFrame
    end
    return getObjectCFrame(finger)
end

local function collectSukunaFinger(arena)
    if not arena:FindFirstChild("SukunaFinger") then return false end

    local startTime = tick()

    -- Model arenada var olduğu sürece 4 birim üstünde hover ile bekle ve prompt'u tetikle
    while (tick() - startTime < 20) do
        if not (Options.AutoCollectSukuna and Options.AutoCollectSukuna.Value) or not isInCursedRush() then
            disableHover()
            return false
        end

        -- Modeli her turda taze bul: referans eskise bile gerçek durumu görür
        local finger = arena:FindFirstChild("SukunaFinger")
        if not finger or not finger.Parent then break end

        -- Parmağın 4 birim üstüne, yüzü parmağa dönük ışınlan; hover ile düşme engellenir
        local targetCF = getPromptTargetCFrame(finger)
        if targetCF then
            enableHover()
            MovementGoTo(CFrame.lookAt(targetCF.Position + Vector3.new(0, 4, 0), targetCF.Position))
        end

        local prompt = findFingerPrompt(finger)
        if prompt then triggerFingerPrompt(prompt) end
        task.wait(0.2)
    end

    disableHover()

    -- Model hâlâ arenada duruyorsa toplanmamış demektir, moba dönme
    if arena:FindFirstChild("SukunaFinger") then return false end

    -- Model gerçekten yok oldu (toplandı) -> mobların tam ortasına geri ışınlan
    local mobs = getAliveMobs(arena)
    if #mobs > 0 then
        local tcf = optimalFarmPosition(mobs, "Cursed")
        if tcf then
            MovementGoTo(tcf)
        end
    end
    return true
end

task.spawn(function()
    while task.wait(0.3) do
        if isMultiplayerPaused() then continue end
        if isCollectingSukuna then continue end

        local isEnabled = Options.AutoCollectSukuna and Options.AutoCollectSukuna.Value
        if not isEnabled then continue end

        local inCursed, arena = detectCursedRush()
        if not inCursed or not arena then continue end

        local finger = arena:FindFirstChild("SukunaFinger")
        if not finger then continue end

        isCollectingSukuna = true
        pcall(function() collectSukunaFinger(arena) end)
        isCollectingSukuna = false
    end
end)

