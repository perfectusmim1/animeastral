local DungeonPriorityDrop = Tabs.Priority:AddDropdown("DungeonPriority", { Title = "Dungeon", Values = PRIORITY_VALUES, Multi = false, Default = "1" })
local GatePriorityDrop = Tabs.Priority:AddDropdown("GatePriority", { Title = "Gate", Values = PRIORITY_VALUES, Multi = false, Default = "2" })
