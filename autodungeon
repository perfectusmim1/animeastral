            if Options.AutoSideQuest and Options.AutoSideQuest.Value then ok = false end
        else
            ok = false
        end
        if not ok then continue end
        table.insert(gqAllQuests, q)
        table.insert(vals, string.format("[%d] %s", q.Index, q.Objective))
