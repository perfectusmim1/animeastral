local function gachaTitleCase(s)
    local out = {}
    local small = { ["of"] = true, ["and"] = true, ["the"] = true, de = true, da = true, ["do"] = true, ["dos"] = true }
    for w in tostring(s):gmatch("%S+") do
        local lw = w:lower()
        if out[1] and small[lw] then
            table.insert(out, lw)
        else
            table.insert(out, w:sub(1, 1):upper() .. w:sub(2):lower())
        end
    end
    return table.concat(out, " ")
end

