local function gqParse(obj)
    local t = tostring(obj or "")
    local s = t:match("^Join (.-) %d+ times")
    if s then return "join", s end
    s = t:match("^Defeat (.-) %d+ times")
    if s then return "kill", s end
    s = t:match("^Obtain (.-) %d+ time")
    if s then return "obtain", s end
    s = t:match("^Roll %w+ from (.-) %d+ time")
    if s then return "roll", s end
    s = t:match("^Complete (%d+) side quests")
    if s then return "sidequests", s end
    s = t:match("^Complete (%d+) index maps")
    if s then return "indexmaps", s end
    s = t:match("^Complete (.-) (%d+) times")
    if s then return "complete", s end
    local _, wname = t:match("^Clear (%d+) waves in (.+)")
    if wname then
        wname = wname:gsub("%s*[%.%s]+$", "")
        return "waves", wname
    end
    return nil
end

