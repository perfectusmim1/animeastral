local GAMEMODE_INVITES = {
    { mode = "Dungeon", optionKey = "AutoDungeon", returnKey = "AutoReturnDungeon", notifyName = "Notify_Dungeon_World9Dungeon" },
    { mode = "Gate", optionKey = "AutoGate", returnKey = "AutoReturnGate", notifyName = "Notify_Raid_World5", rankCheck = true },
    { mode = "TrialEasy", optionKey = "AutoTrialEasy", returnKey = "AutoReturnTrialEasy", notifyName = "Notify_TimeTrial_Easy" },
    { mode = "TrialMedium", optionKey = "AutoTrialMedium", returnKey = "AutoReturnTrialMedium", notifyName = "Notify_TimeTrial_Medium" },
    { mode = "TrialHard", optionKey = "AutoTrialHard", returnKey = "AutoReturnTrialHard", notifyName = "Notify_TimeTrial_Hard" },
