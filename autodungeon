local function questSystemsActive()
    return (Options.AutoQuest and Options.AutoQuest.Value)
        or (Options.AutoSideQuest and Options.AutoSideQuest.Value)
        or (Options.AutoGlobalQuest and Options.AutoGlobalQuest.Value)
end

local questPauseState = false
local function questPauseNotify()
    local on = questSystemsActive()
    if on and not questPauseState then
        questPauseState = true
        Fluent:Notify({ Title = "Paused", Content = "Quest systems are active. Farming and promotion paused.", Duration = 4 })
    elseif not on and questPauseState then
        questPauseState = false
        Fluent:Notify({ Title = "Resumed", Content = "Quest systems are off. Farming and promotion resumed.", Duration = 4 })
    end
    return on
end

