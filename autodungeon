local BOSS_POS_CACHE_FILE = "AnimeAstral/bosspositions.json"
local bossPosCache = nil
local function bossSpawnPos(worldNum, mobKeys)
    worldNum = tonumber(worldNum)
    if not worldNum then return nil end
    local ws = workspace:FindFirstChild("Worlds")
    local w = ws and ws:FindFirstChild(tostring(worldNum))
    local es = w and w:FindFirstChild("EnemySpawns")
    if not es then return nil end

    local want = {}
    for _, key in ipairs(mobKeys) do
        if key then
            for _, a in ipairs(MOB_ALIASES[tostring(key)] or { tostring(key) }) do
                want[string.lower(tostring(a))] = true
            end
        end
    end
    local function scan(folder)
        if not folder then return nil end
        for _, part in ipairs(folder:GetChildren()) do
            if part:IsA("BasePart") then
                local base = (part.Name:match("^(.-)_%d+$") or part.Name):lower()
                if want[base] then return part.Position end
            end
        end
        return nil
    end

    local pos = scan(es)
    if not pos and bossPosCache == nil then
        bossPosCache = {}
        pcall(function()
            if isfile and isfile(BOSS_POS_CACHE_FILE) then
                local d = readfile(BOSS_POS_CACHE_FILE)
                if d and d ~= "" then
                    local decoded = HttpService:JSONDecode(d)
                    if type(decoded) == "table" then bossPosCache = decoded end
                end
            end
        end)
    end
    if not pos then
        local c = bossPosCache and bossPosCache[tostring(worldNum)]
        if type(c) == "table" and c.X then pos = Vector3.new(c.X, c.Y, c.Z) end
    end
    if not pos and next(want) then
        local seed = GQ_BOSS_POS[worldNum]
        if seed then
            pcall(function() LocalPlayer:RequestStreamAroundAsync(seed) end)
            local start = tick()
            while tick() - start < 5 and not pos do
                pos = scan(es)
                if not pos then task.wait(0.5) end
            end
            if pos then
                bossPosCache[tostring(worldNum)] = { X = pos.X, Y = pos.Y, Z = pos.Z }
                pcall(function()
                    makefolder("AnimeAstral")
                    writefile(BOSS_POS_CACHE_FILE, HttpService:JSONEncode(bossPosCache))
                end)
            end
        end
    end
    return pos
end

local function goToBossArea(worldNum, mobName, mobId)
    worldNum = tonumber(worldNum)
    if not worldNum then return false end
    ensureWorld(worldNum)
    local pos = bossSpawnPos(worldNum, { mobName, mobId })
    if not pos then
        pcall(function()
            local ws2 = workspace:FindFirstChild("Worlds")
            local w = ws2 and ws2:FindFirstChild(tostring(worldNum))
            local bp = w and w:FindFirstChild("BossWorld" .. worldNum)
            if bp and bp:IsA("BasePart") then pos = bp.Position end
        end)
    end
    if not pos then pos = GQ_BOSS_POS[worldNum] end
    if not pos then return false end
    if tick() - lastBossTeleport >= 5 then
        lastBossTeleport = tick()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(pos) end)
        MovementGoTo(CFrame.new(pos + Vector3.new(0, 5, 0)))
    end
    return true
end

local gqBossKills = 0
local gqMissStreak = 0
local function questKill(targetId, worldNum, isWorldBoss)
    local folder = activeEnemiesFolder()
    if not folder then
        if isWorldBoss and worldNum then goToBossArea(worldNum, targetId) end
        return false
    end
    local best, bestDist = nil, math.huge
    local root = getRootPart()
    for _, enemy in ipairs(folder:GetChildren()) do
        if isEnemyAlive(enemy) and matchesEnemy(enemy, targetId) then
            local cf = getObjectCFrame(enemy)
            if cf then
                local dist = root and (root.Position - cf.Position).Magnitude or 0
                if dist < bestDist then best, bestDist = cf, dist end
            end
        end
    end
    if not best then
        if isWorldBoss then
            gqMissStreak = gqMissStreak + 1
            if gqMissStreak >= 8 then
                gqMissStreak = 0
                if worldNum then goToBossArea(worldNum, targetId) end
            end
        end
        return false
    end
    if isWorldBoss and gqMissStreak > 0 then
        gqMissStreak = 0
        gqBossKills = gqBossKills + 1
    end
    if bestDist > 10 then
        MovementGoTo(CFrame.new(best.Position + Vector3.new(0, 6, 0)))
    end
    return true
end

local function killWithAliases(name, id, worldNum, isWorldBoss)
    local targets = {}
    local function addTargets(key)
        if not key then return end
        for _, a in ipairs(MOB_ALIASES[tostring(key)] or { tostring(key) }) do
            table.insert(targets, a)
        end
    end
    addTargets(name)
    addTargets(id)
    for _, alias in ipairs(targets) do
        if questKill(alias, worldNum, isWorldBoss) then return true end
    end
    return false
end

