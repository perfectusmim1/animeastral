        if State.wasIn.Gate and Options.AutoReturnGate and Options.AutoReturnGate.Value then doReturn = true end
        if State.wasIn.TrialEasy and Options.AutoReturnTrialEasy and Options.AutoReturnTrialEasy.Value then doReturn = true end
        if State.wasIn.TrialMedium and Options.AutoReturnTrialMedium and Options.AutoReturnTrialMedium.Value then doReturn = true end

        State.wasIn = { Dungeon = false, Gate = false, TrialEasy = false, TrialMedium = false }
        saveReturnData()

        if doReturn then
            State.isReturning = true
            executeAutoReturn()
            State.isReturning = false
        end
    end
end)

