local starWorldValues = nil
local starWorldValuesReady = false
local function buildStarWorldValues()
    local ready = (promoPlayerData and promoPlayerData.Ready) == true
    if starWorldValues and (starWorldValuesReady or not ready) then
        return starWorldValues
    end
    starWorldValues = nil
    pcall(function()
        local wc = promoLibrary and promoLibrary.getConfig("WorldConfig")
        local worlds = wc and wc.Worlds
        if type(worlds) == "table" and #worlds > 0 then
            local out = {}
            for i, w in ipairs(worlds) do
                local name = type(w) == "table" and (w.Name or w.Key or tostring(i)) or tostring(w)
                if not ready or promoWorldUnlocked(i) then
                    table.insert(out, i .. " - " .. tostring(name))
                end
            end
            if #out > 0 then
                starWorldValues = out
                starWorldValuesReady = ready
            end
        end
    end)
    return starWorldValues
end

local function starSelectedWorlds()
    local sel = Options.StarWorlds and Options.StarWorlds.Value
    local out = {}
    if type(sel) == "table" then
        for k, v in pairs(sel) do
            local label = nil
            if type(v) == "string" then
                label = v
            elseif type(k) == "string" and v == true then
                label = k
            end
            if label then
                local n = tonumber(tostring(label):match("^(%d+)"))
                if n then table.insert(out, n) end
            end
        end
    elseif type(sel) == "string" then
        local n = tonumber(sel:match("^(%d+)"))
        if n then table.insert(out, n) end
    end
    table.sort(out)
    return out
end

