task.spawn(function()
    while true do
        task.wait(1)
        if Options.AutoCollectBall and Options.AutoCollectBall.Value then
            local targetFolder = workspace:FindFirstChild("World8Balls")
            local ballList = {}
            if targetFolder then
                for _, child in ipairs(targetFolder:GetChildren()) do
                    if child.Name:sub(1, 5) == "Ball_" and child.Parent then
                        table.insert(ballList, child)
                    end
                end
            end

            local detected = #ballList
            if detected > 0 then
                BallStatusParagraph:SetDesc(string.format("Status: Collecting balls...\nDetected: %d | Collected: 0 | Skipped: 0", detected))
                local collectedCount = 0
                local skippedCount = 0

                for i, ball in ipairs(ballList) do
                    if not (Options.AutoCollectBall and Options.AutoCollectBall.Value) then break end
                    if ball.Parent then
                        BallStatusParagraph:SetDesc(string.format("Status: Collecting (%d/%d)\nDetected: %d | Collected: %d | Skipped: %d", i, detected, detected, collectedCount, skippedCount))
                        local success = collectSingleBall(ball)
                        if success then
                            collectedCount = collectedCount + 1
                        else
                            skippedCount = skippedCount + 1
                        end
                        task.wait(0.15)
                    else
                        skippedCount = skippedCount + 1
                    end
                end

                BallStatusParagraph:SetDesc(string.format("Status: Session Finished\nDetected: %d | Collected: %d | Skipped: %d", detected, collectedCount, skippedCount))

                if Options.AutoBallServerHop and Options.AutoBallServerHop.Value and Options.AutoCollectBall and Options.AutoCollectBall.Value then
                    BallStatusParagraph:SetDesc(string.format("Status: Server hopping...\nDetected: %d | Collected: %d | Skipped: %d", detected, collectedCount, skippedCount))
                    task.wait(1)
                    ballServerHop(function(st)
                        BallStatusParagraph:SetDesc("Status: " .. st)
                    end)
                end
            else
                BallStatusParagraph:SetDesc("Status: No balls found in World8Balls\nDetected: 0 | Collected: 0 | Skipped: 0")
                if Options.AutoBallServerHop and Options.AutoBallServerHop.Value and Options.AutoCollectBall and Options.AutoCollectBall.Value then
                    BallStatusParagraph:SetDesc("Status: No balls detected. Server hopping...")
                    task.wait(1)
                    ballServerHop(function(st)
                        BallStatusParagraph:SetDesc("Status: " .. st)
                    end)
                end
            end
        end
    end
end)

