local function promoProcessMission(mission)
    local mType = mission.Type
    local m = mission.Mission or {}
    local current = tonumber(mission.Current) or 0
    local required = tonumber(mission.Required) or 0

    if mType == "PlayerLevel" then
        if Options.PromoAutoEquipBest and Options.PromoAutoEquipBest.Value then
            promoEquipBest("XP")
        end
        local targets = selectedEnemyInstances()
        if #targets > 0 then
            farmEnemies(targets, "Farm", "", function()
                return Options.AutoPromotion and Options.AutoPromotion.Value
            end, nil)
        end
        return true
    elseif mType == "PlayerRank" then
        if Options.PromoAutoRank and Options.PromoAutoRank.Value then
            promoRankUp()
        end
        return true
    elseif mType == "PlayerRange" then
        pcall(function()
            local bridge = promoLibrary.getBridge("RangeUpgradeRequest")
            if not bridge then return end
            local key = nil
            local rug = promoLibrary.getConfig("RangeUpgradeConfig")
            local vc = LocalPlayer:GetAttribute("VisibilityContext")
            local wn = vc and tostring(vc):match("World:(%d+)")
            if rug and wn then
                key = rug:ResolveKey("World" .. wn)
            end
            if not key and rug then key = rug:ResolveKey("World0") end
            if not key and rug then key = rug:ResolveKey(0) end
            if not key and rug then
                for k in pairs(rug:GetAllUpgrades() or {}) do key = k break end
            end
            if key then
                bridge:Fire(key)
            else
                bridge:Fire()
            end
        end)
        return true
    elseif mType == "PetSummon" then
        if Options.PromoAutoStar and Options.PromoAutoStar.Value then
            promoOpenEgg()
        end
        return true
    elseif mType == "GachaRoll" then
        if Options.PromoAutoGacha and Options.PromoAutoGacha.Value then
            local worldKey = m.Gacha or "World1"
            promoRollGacha(worldKey)
        end
        return true
    elseif mType == "AccessoryObtain" then
        if Options.PromoAutoAccessory and Options.PromoAutoAccessory.Value then
            local bought = promoBuyMissingMerchant()
            if not bought then
                local target = nil
                for _, item in ipairs(promoGetMissingAccessories()) do
                    if not item.isMerchant and not target then target = item end
                end
                if target then
                    promoTeleportToWorld(target.world)
                    promoKillMob(target.mob, target.world)
                end
            end
        end
        return true
    elseif mType == "Defeat" then
        local mob = m.Mob or m.Enemy or "*"
        if mob == "*" or mob == "any" or mob == "all" then
            local targets = selectedEnemyInstances()
            if #targets > 0 then
                farmEnemies(targets, "Farm", "", function()
                    return Options.AutoPromotion and Options.AutoPromotion.Value
                end, nil)
            end
        else
            local worldNum = nil
            pcall(function()
                local EnemyConfig = promoLibrary.getConfig("EnemyConfig")
                local e = EnemyConfig:GetEnemy(mob)
                if e then worldNum = e.World end
            end)
            promoKillMob(mob, worldNum)
        end
        return true
    elseif mType == "SideQuestCompleted" then
        if Options.PromoAutoSideQuest and Options.PromoAutoSideQuest.Value then
            if State.indexFarmWorld then return true end
            local quests = promoGetSideQuestProgress()
            for _, q in ipairs(quests) do
                if not q.accepted then
                    promoAcceptSideQuest(q.id)
                    return true
                end
                if q.required > 0 and q.progress >= q.required then
                    promoAcceptSideQuest(q.id)
                    return true
                end
                if q.required > 0 and q.progress < q.required then
                    if q.world then promoTeleportToWorld(q.world) end
                    local relic = promoActiveRelicBoss()
                    if relic and tonumber(relic.bossWorld) == tonumber(q.world) then
                        promoKillMobs({ { mob = q.enemy }, { mob = relic.bossName } }, q.world)
                    else
                        promoKillMob(q.enemy, q.world)
                    end
                    return true
                end
            end
        end
        return true
    elseif mType == "IndexMapsCompleted" then
        return true
    elseif mType == "GamemodeJoin" then
        if Options.PromoAutoGamemode and Options.PromoAutoGamemode.Value then
            local gamemode = m.Gamemode or ""
            promoJoinGamemode(gamemode)
        end
        return true
    elseif mType == "GamemodeWaves" or mType == "GamemodeComplete" then
        if Options.PromoAutoGamemode and Options.PromoAutoGamemode.Value then
            promoSyncGamemodeToggles()
        end
        return true
    elseif mType == "RelicLevel" then
        if Options.PromoAutoRelic and Options.PromoAutoRelic.Value then
            promoRelicMission(mission)
        end
        return true
    elseif mType == "RelicAscension" then
        if Options.PromoAutoRelic and Options.PromoAutoRelic.Value then
            promoRelicMission(mission)
        end
        return true
    end
    return false
end

local function promoIsParallelMission(mType)
    return mType == "PetSummon" or mType == "GachaRoll" or mType == "PlayerRank"
        or mType == "PlayerRange"
end

local function promoIsSequentialMission(mType)
    return mType == "AccessoryObtain" or mType == "SideQuestCompleted"
        or mType == "GamemodeJoin" or mType == "GamemodeWaves" or mType == "GamemodeComplete"
        or mType == "PlayerLevel" or mType == "Defeat"
        or mType == "RelicLevel" or mType == "RelicAscension"
end

local function promoFindDefeatBoss()
    local st = promoGetState()
    if not st then return nil end
    local boss = nil
    pcall(function()
        for _, m in ipairs(st.Missions or {}) do
            if not m.Complete and m.Type == "Defeat" then
                local mm = m.Mission or {}
                local mob = mm.Mob or m.Mob or mm.Enemy or m.Enemy
                if mob and mob ~= "*" and string.lower(tostring(mob)) ~= "any" and string.lower(tostring(mob)) ~= "all" then
                    local e = promoLibrary and promoLibrary.getConfig("EnemyConfig"):GetEnemy(tostring(mob))
                    if e then
                        boss = { mob = tostring(mob), model = e.ModelName, name = e.Name, world = tonumber(e.World) }
                    end
                    break
                end
            end
        end
    end)
    return boss
end

local function promoHasFarmMission()
    local state = promoGetState()
    if not state then return true end
    for _, m in ipairs(state.Missions or {}) do
        if not m.Complete then
            if m.Type == "PlayerLevel" then return true end
            if m.Type == "Defeat" then
                local mm = m.Mission or {}
                local mob = mm.Mob or m.Mob or mm.Enemy or m.Enemy
                if not mob or mob == "*" or string.lower(tostring(mob)) == "any" or string.lower(tostring(mob)) == "all" then
                    return true
                end
            end
        end
    end
    local b = promoFindDefeatBoss()
    if b and b.world and promoWorldUnlocked(b.world) then return true end
    return false
end

local function promoGachaMissionWorld()
    local worldNum = nil
    pcall(function()
        local st = promoGetState()
        if st then
            for _, m in ipairs(st.Missions or {}) do
                if not m.Complete and m.Type == "GachaRoll" and promoIsMissionEnabled(m) then
                    local worldKey = (m.Mission and m.Mission.Gacha) or nil
                    if worldKey then
                        worldNum = tonumber(tostring(worldKey):match("World(%d+)"))
                    end
                    break
                end
            end
        end
    end)
    return worldNum
end

