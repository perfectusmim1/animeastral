    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if visibility and string.find(visibility, "^Dungeon:") then
            inDungeon = true
            local dungeonArenas = workspace:FindFirstChild("DungeonArenas")
            if dungeonArenas then
                local worldName = visibility:match("^Dungeon:(.+)")
                if worldName and dungeonArenas:FindFirstChild(worldName) then
                    folder = dungeonArenas[worldName]:FindFirstChild("Enemies")
                end
                if not folder then
                    for _, arena in ipairs(dungeonArenas:GetChildren()) do
                        local ef = arena:FindFirstChild("Enemies")
                        if ef then folder = ef; break end
                    end
                end
            end
        else
            local dungeonGui = LocalPlayer.PlayerGui:FindFirstChild("DungeonGui")
            if dungeonGui and dungeonGui.Enabled then
                local mainFrame = dungeonGui:FindFirstChild("Main")
                if mainFrame and mainFrame.Visible then
                    local dungeonArenas = workspace:FindFirstChild("DungeonArenas")
                    if dungeonArenas then
                        for _, arena in ipairs(dungeonArenas:GetChildren()) do
                            local ef = arena:FindFirstChild("Enemies")
                            if ef then inDungeon = true; folder = ef; break end
                        end
                    end
                end
            end
        end
    end)
    return inDungeon, folder
end

local function detectGate()
    local inGate = false
    local folder = nil
    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if isTombRaidContext(visibility) then return end
        if isSoulRaidContext(visibility) then return end
        if isCloverRaidContext(visibility) then return end
        if isInfinityCastleContext(visibility) then return end
        if isTimelessRaidContext(visibility) then return end
        if isNinjaRaidContext(visibility) then return end
        if isSinsRaidContext(visibility) then return end
        if visibility and string.find(visibility, "^Raid:") then
            inGate = true
            local raidArenas = workspace:FindFirstChild("RaidArenas")
            if raidArenas then
                local worldName = visibility:match("^Raid:(.+)")
                if worldName and raidArenas:FindFirstChild(worldName) then
                    folder = raidArenas[worldName]:FindFirstChild("Enemies")
                end
                if not folder then
                    for _, arena in ipairs(raidArenas:GetChildren()) do
                        if not string.find(arena.Name, "^World1Aldedo") and not string.find(arena.Name, "^World10") and not string.find(arena.Name, "^World7") and not string.find(arena.Name, "^World6") and not string.find(arena.Name, "^World0") and not string.find(arena.Name, "^World1_") and not string.find(arena.Name, "^World12") then
                            local ef = arena:FindFirstChild("Enemies")
                            if ef then folder = ef; break end
                        end
                    end
                end
            end
        else
            local raidGui = LocalPlayer.PlayerGui:FindFirstChild("RaidGui")
            if raidGui and raidGui.Enabled then
                local mainFrame = raidGui:FindFirstChild("Main")
                if mainFrame and mainFrame.Visible then
                    local raidArenas = workspace:FindFirstChild("RaidArenas")
                    if raidArenas then
                        for _, arena in ipairs(raidArenas:GetChildren()) do
                            if not string.find(arena.Name, "^World1Aldedo") and not string.find(arena.Name, "^World10") and not string.find(arena.Name, "^World12") and arena:FindFirstChild("Enemies") then
                                inGate = true; folder = arena.Enemies; break
                            end
                        end
                    end
                end
            end
        end
    end)
    return inGate, folder
end

local function genericDetectRaidOrDefense(contextCheckFn, containerName, prefixPattern, matchPattern)
    local inMode, folder = false, nil
    pcall(function()
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if contextCheckFn(visibility) then
            inMode = true
            local container = workspace:FindFirstChild(containerName)
            if container then
                local worldName = tostring(visibility):match(prefixPattern)
                if worldName and container:FindFirstChild(worldName) then
                    folder = container[worldName]:FindFirstChild("Enemies")
                end
                if not folder then
                    for _, arena in ipairs(container:GetChildren()) do
                        if string.find(arena.Name, matchPattern) and arena:FindFirstChild("Enemies") then
                            folder = arena.Enemies; break
                        end
                    end
                end
            end
        end
    end)
    return inMode, folder
end

