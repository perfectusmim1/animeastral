task.spawn(function()
    while task.wait(0.4) do
        if isMultiplayerPaused() then continue end
        if State.isJoining then continue end
        if State.currentMode then continue end

        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if not visibility or not string.match(tostring(visibility), "^World:") then continue end

        local tl = getTeleportLoading()
        if tl and tl.Visible then continue end

        local availableInvites = {}

        for _, info in ipairs(GAMEMODE_INVITES) do
            local isEnabled = Options[info.optionKey] and Options[info.optionKey].Value
            if not isEnabled then continue end
            if not State.canJoin[info.mode] then continue end

            if isInviteAvailable(info) then
                table.insert(availableInvites, { info = info, priority = State.priorities[info.mode] })
            end
        end

        if #availableInvites == 0 then continue end

        table.sort(availableInvites, function(a, b) return a.priority < b.priority end)
        local best = availableInvites[1]

        local dominated = false
        for _, other in ipairs(availableInvites) do
            if other.info.mode ~= best.info.mode and other.priority < best.priority then
                dominated = true; break
            end
        end
        if dominated then continue end

        State.isJoining = true

        if Options[best.info.returnKey] and Options[best.info.returnKey].Value then
            saveReturnData()
            task.wait(0.3)
        end

        local fireFn = JOIN_FIRE_MAP[best.info.mode]
        if fireFn then fireFn() end

        if best.info.mode == "Gate" then
            GateBridgeOpen = false
            GateBridgeRank = nil
        end

        State.hasLeft[best.info.mode] = false

        waitForTeleportComplete()
        State.isJoining = false
    end
end)

