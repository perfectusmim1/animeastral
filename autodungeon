-- LOOP 6: CURSED RUSH - AUTO COLLECT SUKUNA (her 0.3s)
-- ══════════════════════════════════════════════════════════════

local isCollectingSukuna = false

local function findFingerPrompt(finger)
    local prompt = finger:FindFirstChild("FingerPrompt", true)
    if prompt and prompt:IsA("ProximityPrompt") then return prompt end
    return finger:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function triggerFingerPrompt(prompt)
    if not prompt then return false end
    if typeof(fireproximityprompt) == "function" then
        if pcall(fireproximityprompt, prompt) then return true end
    end
    local ok = pcall(function()
        prompt.HoldDuration = 0
        VirtualInputManager:SendKeyEvent(true, prompt.KeyboardKeyCode or Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, prompt.KeyboardKeyCode or Enum.KeyCode.E, false, game)
    end)
    return ok
end

local function getFirstAliveMob(arena)
    local enemies = arena and arena:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, e in ipairs(enemies:GetChildren()) do
        if isEnemyAlive(e) then return e end
    end
    return nil
end

local function collectSukunaFinger(arena)
    local finger = arena:FindFirstChild("SukunaFinger")
    if not finger then return false end

    local fingerCF = getObjectCFrame(finger)
    if not fingerCF then return false end

    -- Parmağın birkaç birim üstüne ışınlan
    MovementGoTo(fingerCF + Vector3.new(0, 4, 0))
    task.wait(0.2)

    -- Prompt'u tetikle (E)
    local startTime = tick()
    while finger.Parent and (tick() - startTime < 5) do
        if not (Options.AutoCollectSukuna and Options.AutoCollectSukuna.Value) then return false end
        local prompt = findFingerPrompt(finger)
        if prompt then triggerFingerPrompt(prompt) end
        task.wait(0.2)
    end

    -- Toplandıktan sonra moba geri ışınlan
    local mob = getFirstAliveMob(arena)
    if mob then
        local mobCF = getObjectCFrame(mob)
        if mobCF then
            MovementGoTo(mobCF + Vector3.new(0, 4, 0))
        end
    end
    return true
end

task.spawn(function()
    while task.wait(0.3) do
        if isMultiplayerPaused() then continue end
        if isCollectingSukuna then continue end

        local isEnabled = Options.AutoCollectSukuna and Options.AutoCollectSukuna.Value
        if not isEnabled then continue end

        local inCursed, arena = detectCursedRush()
        if not inCursed or not arena then continue end

        local finger = arena:FindFirstChild("SukunaFinger")
        if not finger then continue end

        isCollectingSukuna = true
        pcall(function() collectSukunaFinger(arena) end)
        isCollectingSukuna = false
    end
end)

