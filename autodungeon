local function enableHover()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root then return end
        if hum and not hum.PlatformStand then hum.PlatformStand = true end
        local bv = root:FindFirstChild("FarmHoverVelocity")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FarmHoverVelocity"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.zero
            bv.Parent = root
        else
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.zero
        end
    end)
end

local function disableHover()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.PlatformStand then hum.PlatformStand = false end
        if root then
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("BodyVelocity") and child.Name == "FarmHoverVelocity" then
                    child:Destroy()
                end
            end
        end
    end)
end

