local function promoWorldFarm()
    local targetBoss = nil
    local defBoss = promoFindDefeatBoss()
    if defBoss and defBoss.world and promoWorldUnlocked(defBoss.world) then
        targetBoss = defBoss
    end
    local worldNum = nil
    local gachaWorld = promoGachaMissionWorld()
    if gachaWorld and promoWorldUnlocked(gachaWorld) then
        worldNum = gachaWorld
    elseif targetBoss then
        worldNum = targetBoss.world
    else
        worldNum = worldFarmSelectedNum()
        if not worldNum then return end
        if not promoWorldUnlocked(worldNum) then return end
    end

    promoTeleportToWorld(worldNum)
    if Options.PromoAutoEquipBest and Options.PromoAutoEquipBest.Value and tick() - worldFarmLastEquip > 30 then
        worldFarmLastEquip = tick()
        promoEquipBest("XP")
    end
    task.wait(0.2)

    local bossName = nil
    if not targetBoss then
        pcall(function()
            local ec = promoLibrary and promoLibrary.getConfig("EnemyConfig")
            local all = ec and ec:GetAllEnemies()
            if type(all) == "table" then
                for _, info in pairs(all) do
                    if type(info) == "table" and tonumber(info.World) == worldNum and info.Type == "Boss" then
                        bossName = info.ModelName or info.Name
                        break
                    end
                end
            end
        end)
    end
    if targetBoss then
        local alivePos = nil
        local folder = activeEnemiesFolder()
        local names = { targetBoss.mob, targetBoss.model, targetBoss.name }
        local questEnemy = promoQuestEnemyInWorld(targetBoss.world)
        if questEnemy then table.insert(names, questEnemy) end
        local relic = promoActiveRelicBoss()
        if relic and tonumber(relic.bossWorld) == tonumber(targetBoss.world) then
            table.insert(names, relic.bossName)
        end
        if folder then
            for _, enemy in ipairs(folder:GetChildren()) do
                if isEnemyAlive(enemy) then
                    for _, nm in ipairs(names) do
                        if nm and matchesEnemy(enemy, nm) then
                            local cf = getObjectCFrame(enemy)
                            if cf then alivePos = cf end
                            break
                        end
                    end
                end
                if alivePos then break end
            end
        end
        if alivePos then
            MovementGoTo(alivePos + Vector3.new(0, 6, 0))
        else
            goToBossArea(targetBoss.world, targetBoss.mob, targetBoss.model)
        end
        enableHover()
        return
    end
    goToBossArea(worldNum, bossName)
    enableHover()
    local targets = selectedEnemyInstances()
    local bossSet = buildWorldFarmBossSet()
    for _, enemy in ipairs(targets) do
        if not (Options.WorldFarmEnabled and Options.WorldFarmEnabled.Value) then break end
        if not (Options.AutoPromotion and Options.AutoPromotion.Value) then break end
        if bossSet[enemy.Name] then continue end
        local cf = getObjectCFrame(enemy)
        if cf then
            MovementGoTo(cf + Vector3.new(0, 6, 0))
            task.wait(0.3)
        end
    end
end

