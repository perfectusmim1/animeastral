-- LOOP 2: INVITE HANDLER (her 0.2s)
-- ══════════════════════════════════════════════════════════════

local GAMEMODE_INVITES = {
    { mode = "Dungeon", notifyName = "Notify_Dungeon_World9Dungeon", optionKey = "AutoDungeon", returnKey = "AutoReturnDungeon" },
    { mode = "Gate", notifyName = "Notify_Raid_World5", optionKey = "AutoGate", returnKey = "AutoReturnGate", rankCheck = true },
    { mode = "TrialEasy", notifyName = "Notify_TimeTrial_Easy", optionKey = "AutoTrialEasy", returnKey = "AutoReturnTrialEasy" },
    { mode = "TrialMedium", notifyName = "Notify_TimeTrial_Medium", optionKey = "AutoTrialMedium", returnKey = "AutoReturnTrialMedium" },
}

task.spawn(function()
    while task.wait(0.2) do
        if isMultiplayerPaused() then continue end
        if State.isJoining then continue end

        local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
        if not hud then continue end
        local gamemodeNotify = hud:FindFirstChild("Main") and hud.Main:FindFirstChild("GamemodeNotify")
        if not gamemodeNotify then continue end

        local visibleInvites = {}
        for _, info in ipairs(GAMEMODE_INVITES) do
            local isEnabled = Options[info.optionKey] and Options[info.optionKey].Value
            if not isEnabled then continue end
            if not State.canJoin[info.mode] then continue end

            if info.rankCheck then
                local allowed, _ = getGateRankIfAllowed()
                if not allowed then continue end
            end

            local notify = gamemodeNotify:FindFirstChild(info.notifyName)
            if notify and notify.Visible then
                local yesBtn = notify:FindFirstChild("Actions") and notify.Actions:FindFirstChild("YES")
                if yesBtn then
                    table.insert(visibleInvites, { info = info, btn = yesBtn, priority = State.priorities[info.mode] })
                end
            end
        end

        if #visibleInvites == 0 then continue end

        table.sort(visibleInvites, function(a, b) return a.priority < b.priority end)
        local best = visibleInvites[1]

        task.wait(0.5)

        local notify = gamemodeNotify:FindFirstChild(best.info.notifyName)
        if not notify or not notify.Visible then continue end

        local dominated = false
        for _, other in ipairs(visibleInvites) do
            if other.info.mode ~= best.info.mode and other.priority < best.priority then
                dominated = true
                break
            end
        end
        if dominated then continue end

        State.isJoining = true

        if Options[best.info.returnKey] and Options[best.info.returnKey].Value then
            saveReturnData()
            task.wait(0.3)
        end

        robustClickObject(best.btn)
        State.hasLeft[best.info.mode] = false

        waitForTeleportComplete()
        State.isJoining = false
    end
end)

