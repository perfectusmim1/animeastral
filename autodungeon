        local isAutoFarmEnabled = Options.AutoFarm and Options.AutoFarm.Value
        if not isAutoFarmEnabled then
            pcall(function()
                local visibility = LocalPlayer:GetAttribute("VisibilityContext")
                if not visibility or string.find(visibility, "^World:") then
                    disableHover()
                end
            end)
            continue
        end

        if State.currentMode then continue end
        if State.isReturning then continue end
        if State.isJoining then continue end

        -- Check if any invite is visible (pause farm for invite handling)
        local hasInvite = false
        pcall(function()
            local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
            local gamemodeNotify = hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("GamemodeNotify")
            if gamemodeNotify then
                for _, child in ipairs(gamemodeNotify:GetChildren()) do
                    if string.match(child.Name, "Notify_") and child.Visible then
                        hasInvite = true
                        break
                    end
                end
            end
        end)
        if hasInvite then continue end

        local targets = selectedEnemyInstances()
        if #targets > 0 then
            farmEnemies(targets, "Farm", "", function()
                return Options.AutoFarm and Options.AutoFarm.Value and not State.currentMode
            end, nil)
        else
            disableHover()
        end
    end
end)

