-- GATE BRIDGE EVENT LISTENER
-- Popups kapalı olsa bile çalışır (sunucu event'i her zaman gelir)
-- ══════════════════════════════════════════════════════════════

local GateBridgeOpen = false
local GateBridgeRank = nil
local GateBridgeTime = 0
local GateBridgeHooked = false

local function hookGateBridge()
    if GateBridgeHooked then return end
    GateBridgeHooked = true
    task.spawn(function()
        pcall(function()
            local Library = require(ReplicatedStorage:WaitForChild("SimpleWorld"):WaitForChild("Library"))
            if not Library or not Library.getBridge then return end

            local RaidAnnouncement = Library.getBridge("RaidAnnouncement")
            if not RaidAnnouncement then return end

            RaidAnnouncement:Connect(function(data)
                if type(data) == "table" and data.NotifyKind == "GamemodeOpen" and data.GateTeleport == true then
                    GateBridgeOpen = true
                    GateBridgeRank = data.GateRank
                    GateBridgeTime = tick()
                end
            end)
        end)
    end)
end

local function isGateBridgeActive()
    if not GateBridgeOpen then return false end
    -- Gate 60 sn açık kalır
    if tick() - GateBridgeTime > 60 then
        GateBridgeOpen = false
        GateBridgeRank = nil
        return false
    end
    -- Rank kontrolü
    if GateBridgeRank then
        local selectedRanks = selectedMultiValues(Options.GateRanks and Options.GateRanks.Value)
        for _, r in ipairs(selectedRanks) do
            if r == GateBridgeRank then return true end
        end
        return false
    end
    return true
end

-- Birleşik kontrol: Arena VEYA Bridge Event VEYA Notify
local function isInviteAvailable(info)
    -- 1. Arena kontrolü (öncelik — en güvenilir)
    if isArenaOpen(info.mode) then return true end
    -- 2. Gate Bridge event kontrolü (popups kapalı olsa da çalışır)
    if info.mode == "Gate" then
        hookGateBridge() -- Auto Gate açık olduğunda ilk kez hook'u başlat
        if isGateBridgeActive() then return true end
        -- Fallback: notify hâlâ ekrandaysa (hook geç kurulduysa yakalar)
        local notifyActive = false
        pcall(function()
            local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
            local gamemodeNotify = hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("GamemodeNotify")
            if gamemodeNotify then
                local notify = gamemodeNotify:FindFirstChild("Notify_Raid_World5")
                if notify and notify.Visible then
                    local allowed, _ = getGateRankIfAllowed()
                    notifyActive = allowed
                end
            end
        end)
        if notifyActive then return true end
    end
    -- 3. Notify kontrolü (Gate hariç — Gate bridge event kullanır)
    if info.notifyName and info.mode ~= "Gate" then
        local notifyActive = false
        pcall(function()
            local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
            local gamemodeNotify = hud and hud:FindFirstChild("Main") and hud.Main:FindFirstChild("GamemodeNotify")
            if gamemodeNotify then
                local notify = gamemodeNotify:FindFirstChild(info.notifyName)
                if notify and notify.Visible then
                    notifyActive = true
                end
            end
        end)
        if notifyActive then return true end
    end
    return false
end

-- Join fire fonksiyonları haritası
local JOIN_FIRE_MAP = {
    Dungeon = fireJoinDungeon,
    Gate = fireJoinGate,
    TrialEasy = fireJoinTrialEasy,
    TrialMedium = fireJoinTrialMedium,
}

local GAMEMODE_INVITES = {
    { mode = "Dungeon", optionKey = "AutoDungeon", returnKey = "AutoReturnDungeon", notifyName = "Notify_Dungeon_World9Dungeon" },
    { mode = "Gate", optionKey = "AutoGate", returnKey = "AutoReturnGate", notifyName = "Notify_Raid_World5", rankCheck = true },
    { mode = "TrialEasy", optionKey = "AutoTrialEasy", returnKey = "AutoReturnTrialEasy", notifyName = "Notify_TimeTrial_Easy" },
    { mode = "TrialMedium", optionKey = "AutoTrialMedium", returnKey = "AutoReturnTrialMedium", notifyName = "Notify_TimeTrial_Medium" },
}

-- LOOP 2: INVITE HANDLER (her 0.5s)
task.spawn(function()
    while task.wait(0.5) do
        if isMultiplayerPaused() then continue end
        if State.isJoining then continue end
        if State.currentMode then continue end

        -- Sadece normal dünyadayken join dene
        local visibility = LocalPlayer:GetAttribute("VisibilityContext")
        if not visibility or not string.match(tostring(visibility), "^World:") then continue end

        local tl = getTeleportLoading()
        if tl and tl.Visible then continue end

        local availableInvites = {}

        for _, info in ipairs(GAMEMODE_INVITES) do
            local isEnabled = Options[info.optionKey] and Options[info.optionKey].Value
            if not isEnabled then continue end
            if not State.canJoin[info.mode] then continue end

            if isInviteAvailable(info) then
                table.insert(availableInvites, { info = info, priority = State.priorities[info.mode] })
            end
        end

        if #availableInvites == 0 then continue end

        table.sort(availableInvites, function(a, b) return a.priority < b.priority end)
        local best = availableInvites[1]

        -- Daha yüksek önceliği olan başka bir davet var mı kontrol et
        local dominated = false
        for _, other in ipairs(availableInvites) do
            if other.info.mode ~= best.info.mode and other.priority < best.priority then
                dominated = true; break
            end
        end
        if dominated then continue end

        State.isJoining = true

        if Options[best.info.returnKey] and Options[best.info.returnKey].Value then
            saveReturnData()
            task.wait(0.3)
        end

        -- Remote ile join
        local fireFn = JOIN_FIRE_MAP[best.info.mode]
        if fireFn then fireFn() end

        -- Gate bridge state sıfırla
        if best.info.mode == "Gate" then
            GateBridgeOpen = false
            GateBridgeRank = nil
        end

        State.hasLeft[best.info.mode] = false

        waitForTeleportComplete()
        State.isJoining = false
    end
end)

