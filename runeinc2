local function buyBestRod()
	local rods = LP:FindFirstChild("Rods")
	if not rods then return end
	local function owned(name)
		local f = rods:FindFirstChild(name)
		return f ~= nil and f.Value == true
	end
	local best, bestScore = nil, -1
	for _, name in ipairs(RodsData.Order or {}) do
		local rod = RodsData.Rods[name]
		if rod then
			local have = owned(name)
			if not have then
				local okBuy, buyable = pcall(RodsData.IsCoinBuyable, name)
				if okBuy and buyable then
					pcall(function() BuyRodEvent:FireServer(name) end)
					for _ = 1, 8 do
						task.wait(0.12)
						have = owned(name)
						if have then break end
					end
				end
			end
			if have then
				local score = (tonumber(rod.LuckMult) or 1) * (tonumber(rod.SpeedMult) or 1)
				if score > bestScore then
					bestScore, best = score, name
				end
			end
		end
	end
	if not best then return end
	local eq = rods:FindFirstChild("Equiped")
	if eq and tostring(eq.Value) == best then return best end
	pcall(function() EquipRodEvent:FireServer(best) end)
	for _ = 1, 5 do
		task.wait(0.12)
		local e = rods:FindFirstChild("Equiped")
		if e and tostring(e.Value) == best then break end
		pcall(function() EquipRodEvent:FireServer(best) end)
	end
	return best
end
