local function makeIcon(parent, shapes, px, color, z)
	local scale = px / 24
	local w = ICON_STROKE
	local box = Instance.new("Frame")
	box.Name = "Icon"
	box.BackgroundTransparency = 1
	box.Size = UDim2.fromOffset(px, px)
	box.ZIndex = z or 1
	box.Parent = parent
	for _, sh in ipairs(shapes) do
		if sh.t == "c" then
			local r = sh.r * scale
			local f = Instance.new("Frame")
			f.BackgroundTransparency = 1
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromOffset(sh.cx * scale, sh.cy * scale)
			f.Size = UDim2.fromOffset(r * 2, r * 2)
			f.ZIndex = (z or 1) + 1
			f.Parent = box
			Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
			local s = Instance.new("UIStroke")
			s.Thickness = w
			s.Color = color
			s.Transparency = 0
			s.ZIndex = (z or 1) + 1
			s.Parent = f
		else
			for _, pts in ipairs(sh.subs or {}) do
				for k = 2, #pts do
					local ax, ay = pts[k - 1][1] * scale, pts[k - 1][2] * scale
					local bx, by = pts[k][1] * scale, pts[k][2] * scale
					local dx, dy = bx - ax, by - ay
					local len = math.sqrt(dx * dx + dy * dy)
					if len > 0.04 then
						local f = Instance.new("Frame")
						f.BackgroundColor3 = color
						f.BorderSizePixel = 0
						f.AnchorPoint = Vector2.new(0.5, 0.5)
						f.Size = UDim2.fromOffset(len + w, w)
						f.Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2)
						f.Rotation = math.deg(math.atan2(dy, dx))
						f.ZIndex = (z or 1) + 1
						f.Parent = box
						Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
					end
				end
			end
		end
	end
