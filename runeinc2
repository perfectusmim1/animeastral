local function buyTycoonUpgraders()
	local ty = LP:FindFirstChild("Tycoon")
	local h = hrp()
	if not ty or not h then return false end
	local cash = statAmount(TycoonConfig.CostStat)
	if cash <= 0 then return false end
	local world = WS:FindFirstChild("Tycoon")
	if not world then return false end
	for _, u in ipairs(TycoonConfig.Upgraders or {}) do
		local flag = ty:FindFirstChild(u.Name)
		local owned = flag ~= nil and flag.Value == true
		local cost = tonumber(u.Cost) or 0
		if not owned and cost > 0 and cash >= cost then
			local model = world:FindFirstChild(u.Button)
			local hb = model and model:FindFirstChild("Hitbox", true)
			local root = hrp()
			if hb and root then
				local back = root.CFrame
				root.CFrame = hb.CFrame * CFrame.new(0, 3, 0)
				task.wait(0.4)
				local now = hrp()
				if now then now.CFrame = back end
				return true
			end
		end
	end
	return false
end
