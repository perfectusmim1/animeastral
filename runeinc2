local CURVE_STEPS = 6
local function cubicPts(x0, y0, x1, y1, x2, y2, x3, y3, out)
	for t = 1, CURVE_STEPS do
		local u = t / CURVE_STEPS
		local m = 1 - u
		out[#out + 1] = {
			m * m * m * x0 + 3 * m * m * u * x1 + 3 * m * u * u * x2 + u * u * u * x3,
			m * m * m * y0 + 3 * m * m * u * y1 + 3 * m * u * u * y2 + u * u * u * y3,
		}
	end
end
local function quadPts(x0, y0, x1, y1, x2, y2, out)
	for t = 1, CURVE_STEPS do
		local u = t / CURVE_STEPS
		local m = 1 - u
		out[#out + 1] = { m * m * x0 + 2 * m * u * x1 + u * u * x2, m * m * y0 + 2 * m * u * y1 + u * u * y2 }
	end
end
local function arcPts(x0, y0, rx, ry, phiDeg, fa, fs, x1, y1, out)
	rx, ry = math.abs(rx), math.abs(ry)
	if rx == 0 or ry == 0 then
		out[#out + 1] = { x1, y1 }
		return
	end
	local phi = math.rad(phiDeg)
	local cp, sp = math.cos(phi), math.sin(phi)
	local dx2, dy2 = (x0 - x1) / 2, (y0 - y1) / 2
	local xp = cp * dx2 + sp * dy2
	local yp = -sp * dx2 + cp * dy2
	local lam = (xp * xp) / (rx * rx) + (yp * yp) / (ry * ry)
	if lam > 1 then
		local s = math.sqrt(lam)
		rx, ry = rx * s, ry * s
	end
	local num = rx * rx * ry * ry - rx * rx * yp * yp - ry * ry * xp * xp
	local den = rx * rx * yp * yp + ry * ry * xp * xp
	if den == 0 then
		out[#out + 1] = { x1, y1 }
		return
	end
	local co = math.sqrt(math.max(0, num / den))
	if fa == fs then co = -co end
	local cxp = co * rx * yp / ry
	local cyp = -co * ry * xp / rx
	local cx = cp * cxp - sp * cyp + (x0 + x1) / 2
	local cy = sp * cxp + cp * cyp + (y0 + y1) / 2
	local function ang(ux, uy, vx, vy)
		local d = (ux * vx + uy * vy) / (math.sqrt(ux * ux + uy * uy) * math.sqrt(vx * vx + vy * vy))
		local a = math.acos(math.clamp(d, -1, 1))
		if ux * vy - uy * vx < 0 then a = -a end
		return a
	end
	local ux, uy = (xp - cxp) / rx, (yp - cyp) / ry
	local vx, vy = (-xp - cxp) / rx, (-yp - cyp) / ry
	local th1 = ang(1, 0, ux, uy)
	local dth = ang(ux, uy, vx, vy)
	if not fs and dth > 0 then dth -= 2 * math.pi end
	if fs and dth < 0 then dth += 2 * math.pi end
	for t = 1, CURVE_STEPS do
		local th = th1 + dth * (t / CURVE_STEPS)
		out[#out + 1] = {
			cx + rx * cp * math.cos(th) - ry * sp * math.sin(th),
			cy + rx * sp * math.cos(th) + ry * cp * math.sin(th),
		}
	end
end
local function readNumbers(s)
	local out = {}
	local i, n = 1, #s
	while i <= n do
		local c = s:sub(i, i)
		if c:match("[%s,]") then
			i += 1
		elseif c:match("[-+%.%d]") then
			local st = i
			if c == "-" or c == "+" then i += 1 end
			while i <= n and s:sub(i, i):match("%d") do i += 1 end
			if i <= n and s:sub(i, i) == "." then
				i += 1
				while i <= n and s:sub(i, i):match("%d") do i += 1 end
			end
			if i <= n and (s:sub(i, i) == "e" or s:sub(i, i) == "E") then
				local save = i
				i += 1
				if i <= n and (s:sub(i, i) == "-" or s:sub(i, i) == "+") then i += 1 end
				if i <= n and s:sub(i, i):match("%d") then
					while i <= n and s:sub(i, i):match("%d") do i += 1 end
				else
					i = save
				end
			end
			local v = tonumber(s:sub(st, i - 1))
			if v then
				out[#out + 1] = v
			else
				i = st + 1
			end
		else
			i += 1
		end
	end
	return out
end
local function parsePath(d)
	local subs = {}
	local cur = nil
	local x, y, sx, sy = 0, 0, 0, 0
	local cpx, cpy, qpx, qpy = nil, nil, nil, nil
	local function open()
		cur = {}
		subs[#subs + 1] = cur
	end
	local function emit(px, py)
		cur[#cur + 1] = { px, py }
	end
	for cmd, body in d:gmatch("([MmLlHhVvCcSsQqTtAaZz])([^MmLlHhVvCcSsQqTtAaZz]*)") do
		local v = readNumbers(body)
		local i = 0
		local rel = cmd:match("%l") ~= nil
		local C = cmd:upper()
		if C == "M" then
			local nx, ny = rel and x + v[1] or v[1], rel and y + v[2] or v[2]
			open()
			emit(nx, ny)
			x, y = nx, ny
		elseif C == "Z" then
			open()
			emit(sx, sy)
		else
			open()
			emit(x, y)
		end
		sx, sy = x, y
		cpx, cpy, qpx, qpy = nil, nil, nil, nil
		while true do
			i += 1
			if C == "M" then
				local j = 1
				while true do
					j += 1
					local a, b = v[j * 2 - 1], v[j * 2]
					if not a then break end
					local nx, ny = rel and x + a or a, rel and y + b or b
					emit(nx, ny)
					x, y = nx, ny
				end
				break
			elseif C == "L" then
				local a, b = v[i * 2 - 1], v[i * 2]
				if not a then break end
				local nx, ny = rel and x + a or a, rel and y + b or b
				emit(nx, ny)
				x, y = nx, ny
			elseif C == "H" then
				local a = v[i]
				if not a then break end
				local nx = rel and x + a or a
				emit(nx, y)
				x = nx
			elseif C == "V" then
				local a = v[i]
				if not a then break end
				local ny = rel and y + a or a
				emit(x, ny)
				y = ny
			elseif C == "C" then
				local a, b, cc, dd, e, f2 = v[i * 6 - 5], v[i * 6 - 4], v[i * 6 - 3], v[i * 6 - 2], v[i * 6 - 1], v[i * 6]
				if not a then break end
				local x1, y1 = rel and x + a or a, rel and y + b or b
				local x2, y2 = rel and x + cc or cc, rel and y + dd or dd
				local x3, y3 = rel and x + e or e, rel and y + f2 or f2
				cubicPts(x, y, x1, y1, x2, y2, x3, y3, cur)
				cpx, cpy = x2, y2
				x, y = x3, y3
			elseif C == "S" then
				local a, b, cc, dd = v[i * 4 - 3], v[i * 4 - 2], v[i * 4 - 1], v[i * 4]
				if not a then break end
				local x1, y1 = cpx and 2 * x - cpx or x, cpy and 2 * y - cpy or y
				local x2, y2 = rel and x + a or a, rel and y + b or b
				local x3, y3 = rel and x + cc or cc, rel and y + dd or dd
				cubicPts(x, y, x1, y1, x2, y2, x3, y3, cur)
				cpx, cpy = x2, y2
				x, y = x3, y3
			elseif C == "Q" then
				local a, b, cc, dd = v[i * 4 - 3], v[i * 4 - 2], v[i * 4 - 1], v[i * 4]
				if not a then break end
				local x1, y1 = rel and x + a or a, rel and y + b or b
				local x2, y2 = rel and x + cc or cc, rel and y + dd or dd
				quadPts(x, y, x1, y1, x2, y2, cur)
				qpx, qpy = x1, y1
				x, y = x2, y2
			elseif C == "T" then
				local a, b = v[i * 2 - 1], v[i * 2]
				if not a then break end
				local x1, y1 = qpx and 2 * x - qpx or x, qpy and 2 * y - qpy or y
				local nx, ny = rel and x + a or a, rel and y + b or b
				quadPts(x, y, x1, y1, nx, ny, cur)
				qpx, qpy = x1, y1
				x, y = nx, ny
			elseif C == "A" then
				local b0 = (i - 1) * 7
				local rx, ry, rot, fa, fs = v[b0 + 1], v[b0 + 2], v[b0 + 3], v[b0 + 4], v[b0 + 5]
				local ex, ey = v[b0 + 6], v[b0 + 7]
				if not rx then break end
				local nx, ny = rel and x + ex or ex, rel and y + ey or ey
				arcPts(x, y, rx, ry, rot, fa ~= 0, fs ~= 0, nx, ny, cur)
				x, y = nx, ny
			else
				break
			end
		end
		if C == "Z" then
			x, y = sx, sy
		end
	end
	return subs
end
