local function runeRowText(pool, name, info)
	local owned = "0"
	pcall(function()
		local rf = LP:FindFirstChild("Runes")
		local pf = rf and rf:FindFirstChild(pool)
		local vf = pf and pf:FindFirstChild(name)
		if vf then owned = shortOwned(vf.Value) end
	end)
	local odds
	if info.Percent then
		odds = info.Percent .. "%"
	else
		local w = tonumber(info.Weight) or 0
		odds = "1/" .. shortOwned(tostring(w))
		if w > 0 and w <= 100000 then
			odds ..= " · " .. string.format("%.3g", 100 / w) .. "%"
		end
	end
	local extra = ""
	if info.Luck == false then extra ..= " · Deity" end
	pcall(function()
		local rf = LP:FindFirstChild("Runes")
		local dp = rf and rf:FindFirstChild("DietyPity")
		local pv = dp and dp:FindFirstChild(name)
		if pv then extra ..= " · Pity " .. shortOwned(pv.Value) end
	end)
	return name .. "  x" .. owned, odds .. extra
end
