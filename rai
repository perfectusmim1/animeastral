-- OPENROUTER CLIENT (OpenAI-style chat completions)
--══════════════════════════════════════════════════════════════════════

-- Converts Gemini-style tool declarations to OpenAI-style tools.
function AI.toOpenAITools()
    local function convert(node)
        if type(node) ~= "table" then
            return node
        end
        local out = {}
        for k, v in pairs(node) do
            if k == "type" and type(v) == "string" then
                out[k] = v:lower()
            elseif type(v) == "table" then
                out[k] = convert(v)
            else
                out[k] = v
            end
        end
        return out
    end
    local tools = {}
    for _, decl in ipairs(Tools.declarations or {}) do
        local fn = { name = decl.name, description = decl.description }
        if decl.parameters ~= nil then
            fn.parameters = convert(decl.parameters)
        else
            -- The Stealth provider behind stealth/space-bunny-alpha answers 502
            -- ("JSON error injected into SSE stream" / provider_unavailable) as soon as ANY
            -- tool declaration in the array omits `parameters`, which kills the whole
            -- request. Tools declared as decl("name", "desc") with no props have none, so
            -- always send an empty object schema.
            fn.parameters = { type = "object", properties = {} }
        end
        if type(fn.parameters.properties) ~= "table" then
            fn.parameters.properties = {}
        end
        tools[#tools + 1] = { type = "function", ["function"] = fn }
    end
    return tools
end

-- Builds an OpenAI-style request body from the provider-agnostic history.
function AI.buildOpenAIBody()
    local messages = {}
    messages[#messages + 1] = { role = "system", content = Prompt.system(Agent.lib) }
    local n = 0
    local pending = {} -- generated call ids awaiting their tool result
    local head = 1
    local function newId()
        n += 1
        return "call_" .. n
    end
    for _, entry in ipairs(Agent.history or {}) do
        if entry.role == "model" then
            local texts = {}
            local calls = {}
            for _, p in ipairs(entry.parts or {}) do
                if type(p) == "table" then
                    if type(p.functionCall) == "table" then
                        local fc = p.functionCall
                        local id = fc.id
                        if type(id) ~= "string" or id == "" then
                            id = newId()
                            pending[#pending + 1] = id
                        end
                        local argsStr = "{}"
                        if fc.args ~= nil then
                            local okJ, j = pcall(function()
                                return HttpService:JSONEncode(fc.args)
                            end)
                            if okJ and type(j) == "string" then
                                argsStr = j
                            end
                        end
                        calls[#calls + 1] = { id = id, type = "function", ["function"] = { name = fc.name, arguments = argsStr } }
                    elseif type(p.text) == "string" and not p.thought and U.trim(p.text) ~= "" then
                        texts[#texts + 1] = p.text
                    end
                end
            end
            local msg = { role = "assistant" }
            if #texts > 0 then
                msg.content = table.concat(texts, "\n")
            end
            if #calls > 0 then
                msg.tool_calls = calls
            end
            if msg.content ~= nil or msg.tool_calls ~= nil then
                messages[#messages + 1] = msg
            end
        elseif entry.role == "user" then
            local texts = {}
            local tools = {}
            for _, p in ipairs(entry.parts or {}) do
                if type(p) == "table" then
                    if type(p.functionResponse) == "table" then
                        local fr = p.functionResponse
                        local id = fr.id
                        if type(id) ~= "string" or id == "" then
                            if head <= #pending then
                                id = pending[head]
                                head += 1
                            else
                                id = newId()
                            end
                        end
                        local resp = fr.response
                        local r = type(resp) == "table" and resp.result or nil
                        if type(r) ~= "string" then
                            r = tostring(r or "")
                        end
                        tools[#tools + 1] = { role = "tool", tool_call_id = id, content = r }
                    elseif type(p.text) == "string" and U.trim(p.text) ~= "" then
                        texts[#texts + 1] = p.text
                    end
                end
            end
            if #texts > 0 then
                messages[#messages + 1] = { role = "user", content = table.concat(texts, "\n") }
            end
            for _, t in ipairs(tools) do
                messages[#messages + 1] = t
            end
        end
    end
    local body = {
        model = AI.orModel,
        messages = messages,
    }
    -- Reasoning: this model family declares reasoning as mandatory, so omitting the
    -- field falls back to its default effort ("max"), which produces enormous traces on
    -- a 33-tool prompt and blows past the request timeout. Send an explicit bounded
    -- effort instead, and cap the completion so a runaway trace cannot hang the agent.
    if not AI.skipReasoning then
        local effort = AI.orEffort
        if type(effort) ~= "string" or effort == "" then
            effort = AI.orEffortDefault or "medium"
        end
        body.reasoning = { effort = effort }
    end
    if not AI.skipTools then
        body.tools = AI.toOpenAITools()
        body.tool_choice = "auto"
    end
    -- max_tokens is left unset by default. Reasoning is mandatory on this model and
    -- reasoning tokens count against max_tokens, so a tight cap makes the provider cut
    -- the reply off mid-flight. Set AI.orMaxTokens > 0 to cap it explicitly.
    local cap = tonumber(AI.orMaxTokens) or 0
    if cap > 0 then
        body.max_tokens = math.floor(cap)
    end
    -- Streaming is what makes this model usable here. With reasoning mandatory, a
    -- non-streaming call emits no bytes at all while the model thinks, the upstream
    -- connection goes idle and dies, and OpenRouter reports
    -- "JSON error injected into SSE stream". Streaming keeps bytes flowing.
    if not AI.skipStream then
        body.stream = true
    end
    return body
end

-- Rebuilds a single chat.completion object from an SSE body. Tool-call arguments
-- arrive in fragments keyed by index, so they are concatenated per index.
function AI.parseSSE(body)
    local out = {
        id = "chatcmpl-sse",
        object = "chat.completion",
        model = AI.orModel,
        choices = { { index = 0, message = { role = "assistant" }, finish_reason = "STOP" } },
    }
    local content, reasoning = {}, {}
    local calls, order = {}, {}
    local got, usage = false, nil
    for line in tostring(body or ""):gmatch("[^\r\n]+") do
        if line:sub(1, 6) == "data: " then
            local payload = line:sub(7)
            if payload ~= "[DONE]" then
                local ok, chunk = pcall(function()
                    return HttpService:JSONDecode(payload)
                end)
                if ok and type(chunk) == "table" then
                    got = true
                    if type(chunk.error) == "table" and out.error == nil then
                        out.error = chunk.error
                    end
                    if type(chunk.usage) == "table" then
                        usage = chunk.usage
                    end
                    local ch = type(chunk.choices) == "table" and chunk.choices[1] or nil
                    if type(ch) == "table" then
                        local d = type(ch.delta) == "table" and ch.delta
                            or (type(ch.message) == "table" and ch.message) or {}
                        if type(d.content) == "string" and d.content ~= "" then
                            content[#content + 1] = d.content
                        end
                        if type(d.reasoning) == "string" and d.reasoning ~= "" then
                            reasoning[#reasoning + 1] = d.reasoning
                        end
                        if type(d.tool_calls) == "table" then
                            for _, tc in ipairs(d.tool_calls) do
                                if type(tc) == "table" then
                                    local idx = tonumber(tc.index) or (#order + 1)
                                    if calls[idx] == nil then
                                        calls[idx] = {
                                            id = nil,
                                            type = "function",
                                            ["function"] = { name = "", arguments = "" },
                                        }
                                        order[#order + 1] = idx
                                    end
                                    local slot = calls[idx]
                                    if type(tc.id) == "string" and tc.id ~= "" then
                                        slot.id = tc.id
                                    end
                                    local fn = tc["function"]
                                    if type(fn) == "table" then
                                        if type(fn.name) == "string" and fn.name ~= "" then
                                            slot["function"].name = fn.name
                                        end
                                        if type(fn.arguments) == "string" then
                                            slot["function"].arguments = slot["function"].arguments .. fn.arguments
                                        end
                                    end
                                end
                            end
                        end
                        if type(ch.finish_reason) == "string" and ch.finish_reason ~= "" then
                            out.choices[1].finish_reason = ch.finish_reason
                        end
                    end
                end
            end
        end
    end
    if not got then
        return nil
    end
    local msg = out.choices[1].message
    if #content > 0 then
        msg.content = table.concat(content)
    end
    if #reasoning > 0 then
        msg.reasoning = table.concat(reasoning)
    end
    if #order > 0 then
        local list = {}
        for _, idx in ipairs(order) do
            list[#list + 1] = calls[idx]
        end
        msg.tool_calls = list
    end
    if type(usage) == "table" then
        out.usage = usage
    end
    return out
end

-- Converts an OpenAI-style chat completion into a Gemini-shaped response.
function AI.normalizeOpenAI(data)
    if type(data) == "table" and data.error ~= nil then
        local e = data.error
        local msg = type(e) == "table" and (e.message or e.code) or e
        return nil, tostring(msg or "OpenRouter error")
    end
    local choice = type(data) == "table" and type(data.choices) == "table" and data.choices[1] or nil
    if type(choice) ~= "table" then
        choice = {}
    end
    local mop = type(choice.message) == "table" and choice.message or {}
    local parts = {}
    local contentStr = ""
    if type(mop.content) == "string" then
        contentStr = mop.content
    elseif type(mop.content) == "table" then
        local bits = {}
        for _, c in ipairs(mop.content) do
            if type(c) == "string" then
                bits[#bits + 1] = c
            elseif type(c) == "table" and type(c.text) == "string" then
                bits[#bits + 1] = c.text
            end
        end
        contentStr = table.concat(bits, "\n")
    end
    if contentStr ~= "" then
        parts[#parts + 1] = { text = contentStr }
    end
    if type(mop.reasoning) == "string" and mop.reasoning ~= "" then
        parts[#parts + 1] = { text = mop.reasoning, thought = true }
    end
    if type(mop.tool_calls) == "table" then
        for _, tc in ipairs(mop.tool_calls) do
            if type(tc) == "table" and type(tc["function"]) == "table" then
                local fn = tc["function"]
                local args = {}
                if type(fn.arguments) == "string" and fn.arguments ~= "" then
                    local okD, dec = pcall(function()
                        return HttpService:JSONDecode(fn.arguments)
                    end)
                    if okD and type(dec) == "table" then
                        args = dec
                    end
                elseif type(fn.arguments) == "table" then
                    args = fn.arguments
                end
                parts[#parts + 1] = { functionCall = { name = fn.name, args = args, id = tc.id } }
            end
        end
    end
    local total = 0
    local promptTokens = 0
    if type(data) == "table" and type(data.usage) == "table" then
        total = tonumber(data.usage.total_tokens) or 0
        promptTokens = tonumber(data.usage.prompt_tokens) or 0
    end
    return {
        candidates = { { content = { role = "model", parts = parts }, finishReason = choice.finish_reason or "STOP" } },
        usageMetadata = { totalTokenCount = total, promptTokenCount = promptTokens },
    }
end

-- Extracts a retry delay (seconds) from an OpenRouter rate-limit message.
function AI.parseOpenRouterRetry(msg)
    local m = tostring(msg or "")
    return tonumber(m:match("[Rr]etry in ([%d%.]+)"))
        or tonumber(m:match("[Rr]etry[^%d]*([%d%.]+)%s*[Ss]ec"))
        or tonumber(m:match("([%d%.]+)%s*[Ss]ec"))
end

-- OpenRouter equivalent of generateGemini (same rotation semantics).
function AI.generateOpenRouter(body)
    local okJ, payload = pcall(function()
        return HttpService:JSONEncode(body)
    end)
    if not okJ then
        return nil, "JSON encode error: " .. tostring(payload)
    end
    local attempts, waits, hiccups = 0, 0, 0
    while true do
        if Agent.stopRequested then
            return nil, "Stopped"
        end
        local key, info = Keys.acquire()
        if not key then
            if info == "dead" then
                return nil, "No usable API key — all invalid/unauthorized. Add a new OpenRouter key."
            end
            waits += 1
            if waits > 8 then
                return nil, "All OpenRouter keys are over quota/rate limit. Wait a bit and retry, or add a new key."
            end
            local waitFor = math.clamp(math.ceil(info), 1, 90)
            for s = waitFor, 1, -1 do
                if Agent.stopRequested then
                    return nil, "Stopped"
                end
                UI.setStatus(("All keys rate-limited · waiting %d s"):format(s), "warn")
                UI.refreshKeyStatus()
                task.wait(1)
            end
        else
            attempts += 1
            local res, err = Http.post(AI.orBase, payload, 300, {
                Authorization = "Bearer " .. key.key,
                ["X-Title"] = "Script Creator",
            })
            if Agent.stopRequested then
                return nil, "Stopped"
            end
            if not res then
                key.fails += 1
                AI.connFails += 1
                local wait = AI.connDelay()
                if AI.timedOutText(res) then
                    -- A 30s executor timeout is per request, so retrying the same slow turn
                    -- forever can never succeed. Step the reasoning effort down instead; the
                    -- final rung drops reasoning, which always returns fast. Only if even
                    -- that times out twice is the request genuinely hopeless, and then we say
                    -- so rather than spinning.
                    AI.connFails += 1
                    local rung = AI.stepTimeoutLadder()
                    if rung then
                        local okR, payloadR = pcall(function()
                            return HttpService:JSONEncode(AI.buildOpenAIBody())
                        end)
                        if okR then
                            payload = payloadR
                        end
                        UI.setStatus(("Turn too slow for the executor's 30s limit · dropping to %s · retry in %ds")
                            :format(rung, wait), "warn")
                    elseif AI.connFails > 6 then
                        return nil, ("The model cannot answer within your executor's request timeout (~30s), "
                            .. "even with reasoning disabled. This is a client-side limit, not an API problem. "
                            .. "Your session is saved — use a shorter request, a different model, or an "
                            .. "executor without a request timeout."):format()
                    else
                        UI.setStatus(("Request timed out (%d) · retry in %ds"):format(AI.connFails, wait), "warn")
                    end
                else
                    UI.setStatus(("Connection issue (%s) · retry %d in %ds"):format(
                        tostring(err), AI.connFails, wait), "warn")
                end
                task.wait(wait)
            else
                local http = tonumber(res.StatusCode) or 0
                local okD, data = pcall(function()
                    return HttpService:JSONDecode(res.Body or "")
                end)
                if not okD then
                    data = nil
                end
                -- A streaming reply is SSE text, not JSON, so decoding fails. Rebuild the
                -- completion from the chunks before deciding whether this is an error.
                if type(data) ~= "table" and http >= 200 and http < 300 then
                    local sse = AI.parseSSE(res.Body)
                    if sse ~= nil then
                        data = sse
                    end
                end
                if http >= 200 and http < 300 and type(data) == "table" and data.error == nil then
                    key.uses += 1
                    hiccups = 0
                    AI.connFails = 0
                    AI.timeoutStep = 0
                    UI.refreshKeyStatus()
                    return data
                end
                local msg = (type(data) == "table" and type(data.error) == "table" and data.error.message)
                    or (type(data) == "table" and type(data.error) == "string" and data.error)
                    or tostring(res.Body or res.StatusMessage or "")
                msg = U.truncate(tostring(msg), 400)
                -- OpenRouter answers 200 and puts the real failure in the body once the
                -- model has started producing. The transport status is therefore useless
                -- for routing decisions: prefer error.code from the payload.
                local code = http
                if type(data) == "table" and type(data.error) == "table" then
                    local inner = tonumber(data.error.code)
                    if inner and inner >= 400 then
                        code = inner
                    end
                end
                if code == 200 then
                    code = 0
                end
                -- "JSON error injected into SSE stream" is OpenRouter reporting that the
                -- upstream call failed mid-flight. The wrapper text hides the real cause,
                -- so pull the provider detail out of metadata before anything else.
                local injected = tostring(msg):lower():find("injected into sse stream", 1, true) ~= nil
                -- ponytail: computed once, reused by the fallback chain below. An injected
                -- error whose cause is transient (provider_unavailable / 5xx) is a hiccup,
                -- not a streaming incompatibility: retrying fixes it, turning streaming off
                -- does not — and this model family dies without streaming.
                local transient = code == 0 or code == 408 or code >= 500 or AI.isTransientProviderError(data, msg)
                if injected and not transient then
                    -- Genuine non-transient rejection while streaming: drop back to a plain
                    -- request instead of giving up. Cheap to try, and it rescues endpoints
                    -- that dislike streaming for large tool payloads.
                    if not AI.skipStream then
                        AI.skipStream = true
                        local okS, payloadS = pcall(function()
                            return HttpService:JSONEncode(AI.buildOpenAIBody())
                        end)
                        if okS then
                            payload = payloadS
                        end
                        UI.setStatus("Stream dropped by provider · retrying without streaming", "warn")
                    else
                        local meta = type(data) == "table" and type(data.error) == "table" and data.error.metadata or nil
                        local native = type(meta) == "table" and (meta.native_finish_reason or meta.provider_error) or nil
                        if type(native) == "table" then
                            native = native.message or native.error or native.type
                        end
                        local detail = (type(native) == "string" and U.truncate(tostring(native), 300) or nil)
                            or U.truncate(tostring(msg), 300)
                        return nil, ("OpenRouter could not complete the request (%s). "
                            .. "The provider for this model rejected or dropped the call. "
                            .. "Try a different model, or retry in a few minutes."):format(detail)
                    end
                elseif code == 429 then
                    -- Rate limits first: a 429 must never be mistaken for a generic hiccup,
                    -- and the free-model cap needs its own explanation.
                    local low = msg:lower()
                    local quota = low:find("daily", 1, true) or low:find("per day", 1, true)
                        or low:find("quota", 1, true) or low:find("month", 1, true)
                    local delay = AI.retryDelayFor(res, msg, attempts)
                    if quota then
                        -- Daily cap: retrying is pointless until UTC midnight, so fail fast.
                        return nil, ("OpenRouter daily limit reached for this key (%s). "
                            .. "The model keeps answering after the quota resets, or add another key."):format(msg)
                    end
                    key.cooldown = os.clock() + math.clamp(delay, 5, 300)
                    key.lastError = "limit"
                    if AI.isFreeModel(AI.orModel) then
                        UI.setStatus(("Free model rate limit (20/min, 50/day) · waiting %ds"):format(
                            math.ceil(key.cooldown - os.clock())), "warn")
                    else
                        UI.setStatus(("Key %s rate-limited · waiting %ds"):format(
                            Keys.mask(key.key), math.ceil(key.cooldown - os.clock())), "warn")
                    end
                elseif code == 401 or code == 403 then
                    key.dead = true
                    key.lastError = "unauthorized"
                    UI.setStatus("Skipped unauthorized key: " .. Keys.mask(key.key), "warn")
                elseif code == 402 then
                    return nil, "OpenRouter: insufficient credits (" .. msg
                        .. "). Add credits at openrouter.ai/credits, or switch to a free model."
                elseif code == 404 then
                    return nil, "Model not found: " .. msg
                        .. " — check the model id (currently \"" .. tostring(AI.orModel) .. "\")."
                elseif code == 400 or code == 413 then
                    if AI.isContextOverflow(msg) then
                        local extra = ""
                        local lowMsg = msg:lower()
                        if lowMsg:find("reasoning", 1, true) or lowMsg:find("effort", 1, true) then
                            extra = " Check the reasoning effort value (try low/medium/high/xhigh, or leave it empty for the model default)."
                        end
                        return nil, "Context window exceeded by the provider. Start a new session." .. extra
                    end
                    local lowMsg = msg:lower()
                    -- Some endpoints reject tool_choice / tools; drop them and keep the
                    -- conversation going instead of failing the whole run.
                    if not AI.skipTools and (lowMsg:find("tool_choice", 1, true)
                            or lowMsg:find("tools", 1, true)
                            or lowMsg:find("function calling", 1, true)
                            or lowMsg:find("function_call", 1, true)) then
                        AI.skipTools = true
                        local okT, payloadT = pcall(function()
                            return HttpService:JSONEncode(AI.buildOpenAIBody())
                        end)
                        if okT then
                            payload = payloadT
                        end
                        UI.setStatus("Tool calling rejected by this model · retrying without tools", "warn")
                    elseif not AI.skipReasoning and (lowMsg:find("reasoning", 1, true) or lowMsg:find("effort", 1, true)) then
                        AI.skipReasoning = true
                        local okR, payload2 = pcall(function()
                            return HttpService:JSONEncode(AI.buildOpenAIBody())
                        end)
                        if okR then
                            payload = payload2
                        end
                        UI.setStatus("Reasoning not supported by this model · retrying without it", "warn")
                    else
                        return nil, "OpenRouter rejected the request (400): " .. msg
                    end
                elseif transient then
                    -- Show the real status and a slice of the provider message so a dead
                    -- endpoint is diagnosable instead of looping behind a generic label.
                    -- Capped at 3 tries / 8s each: a 5xx usually clears in seconds, and a
                    -- person waiting on the UI should not sit through a minute of backoff.
                    hiccups += 1
                    local delay = math.min(AI.retryDelayFor(res, msg, hiccups), 8)
                    UI.setStatus(("Provider error %d: %s · retry %d/3 in %ds"):format(
                        code, U.truncate(tostring(msg), 90), hiccups, math.ceil(delay)), "warn")
                    if hiccups > 3 then
                        return nil, ("OpenRouter provider error after %d tries (last code %d): %s"):format(
                            hiccups - 1, code, msg)
                    end
                    task.wait(delay)
                else
                    return nil, ("HTTP %d: %s"):format(code, msg)
                end
                UI.refreshKeyStatus()
            end
        end
    end
end

-- Provider dispatcher: OpenRouter path builds its own body and normalizes.
function AI.generate(body)
    -- A fresh call starts with a fresh transport-failure budget, so a run that gave up on a
    -- dead connection does not poison the next one.
    AI.connFails = 0
    AI.timeoutStep = 0
    if Agent.provider == "openrouter" then
        local data, err = AI.generateOpenRouter(AI.buildOpenAIBody())
        if not data then
            return nil, err
        end
        return AI.normalizeOpenAI(data)
    end
    return AI.generateGemini(body)
end

-- The bottom bar carries a single short state word only. Which model is running is already
-- shown by the model chip next to the composer, and how long a turn took is reported in the
-- chat feed, so repeating either here was pure clutter.
function AI.thinkingLabel()
    return "Thinking"
end

-- Restores provider/model/effort from persisted store data (with validation).
function AI.restoreConfig(data)
    data = type(data) == "table" and data or {}
    if data.provider == "gemini" or data.provider == "openrouter" then
        Agent.provider = data.provider
    else
        Agent.provider = "gemini"
    end
    if type(data.or_model) == "string" and data.or_model ~= "" then
        AI.orModel = data.or_model
    end
    AI.model = DEFAULT_MODEL
    if type(data.or_effort) == "string" then
        AI.orEffort = data.or_effort
    end
    if type(data.think_level) == "string" then
        AI.thinkLevel = data.think_level
    end
end

--══════════════════════════════════════════════════════════════════════
-- AGENT LOOP
--══════════════════════════════════════════════════════════════════════
-- Recon budget. The prompt asks for "≤ 22 tool calls before writing", but that is a request,
-- not a rule: the model kept announcing "one final probe, then I'll write" for 40+ turns and
-- nothing stopped it. Enforcement lives here instead. Investigation tools stop working once
-- the budget is gone, so the only way forward is write_script / edit_script / finish.
Agent.PROBE_SOFT = 14
Agent.PROBE_HARD = 22

-- Tools that only gather information. Locked out when the budget runs out; the authoring
-- tools below stay available so the agent can still produce and repair the script.
Agent.PROBE_TOOLS = {
    explore = true, get_properties = true, search_instances = true, find_interactables = true,
    get_player_data = true, list_players = true, inspect_gui = true, list_scripts = true,
    decompile = true, grep_scripts = true, script_constants = true, get_script_env = true,
    index_scripts = true, find_remote_callers = true, get_connections = true,
    get_nil_instances = true, find_remotes = true, remote_spy = true, observe = true,
    watch_value = true, inspect_module = true, gc_search = true, run_lua = true,
    console_output = true, get_game_info = true, spy_closure = true, fire_remote = true,
    anticheat_scan = true, get_script_source = true,
}

function Agent.probeLeft()
    return math.max(0, Agent.PROBE_HARD - (Agent.probes or 0))
end

-- Builds the closing message shown in the feed when a run finishes: what was built, which
-- remotes drive it, and what could not be verified. Falls back to an honest note when the
-- model handed finish an empty summary, rather than saying nothing at all.
function Agent.announceFinish()
    local title = tostring(Draft.title or "")
    if title == "" then
        title = U.gameName() .. " Script"
    end
    local lines = {}
    lines[#lines + 1] = ("**%s** — done. %d lines, syntax %s."):format(
        title, Draft.lineCount(), Draft.syntaxOk and "clean" or "not verified")
    local summary = U.trim(tostring(Draft.summary or ""))
    if summary ~= "" then
        lines[#lines + 1] = summary
    end
    if type(Draft.features) == "table" and #Draft.features > 0 then
        local f = {}
        for i, v in ipairs(Draft.features) do
            if i > 12 then
                f[#f + 1] = ("+%d more"):format(#Draft.features - 12)
                break
            end
            f[#f + 1] = tostring(v)
        end
        lines[#lines + 1] = "**Features**\n- " .. table.concat(f, "\n- ")
    end
    if summary == "" then
        lines[#lines + 1] = "_The model did not write a summary for this run, so there is no "
            .. "detailed write-up here — the script itself is on the Script tab._"
    end
    if UI and UI.addAssistant then
        UI.addAssistant(table.concat(lines, "\n\n"))
    end
end

Agent.running = false
Agent.stopRequested = false
Agent.history = {}
Agent.step = 0
Agent.ctxWindow = 1000000
Agent.ctxUsed = 0
Agent.stepCap = 200
Agent.probes = 0
Agent.probeWarned = false
Agent.lib = "rayfield"
Agent.instruction = ""
Agent.tokens = 0
Agent.session = false
Agent.provider = "gemini"
Agent.currentSessionId = nil
Agent.queue = {}

function Agent.pushUser(text)
    local last = Agent.history[#Agent.history]
    if last and last.role == "user" then
        local onlyText = true
        for _, p in ipairs(last.parts) do
            if p.text == nil then
                onlyText = false
                break
            end
        end
        if onlyText then
            last.parts[#last.parts + 1] = { text = text }
            return
        end
    end
    Agent.history[#Agent.history + 1] = { role = "user", parts = { { text = text } } }
end

-- Keeps the model content (incl. thoughtSignature) as-is; only drops empty args that would be [] in JSON
function Agent.sanitize(content)
    local clean = {}
    for _, p in ipairs(content.parts or {}) do
        if type(p) == "table" then
            local fc = p.functionCall
            if type(fc) == "table" and type(fc.args) == "table" and next(fc.args) == nil then
                fc.args = nil
            end
            if next(p) ~= nil then
                clean[#clean + 1] = p
            end
        end
    end
    content.parts = clean
    return content
end

-- Trims old tool outputs to keep context light (last 8 turns stay intact)
function Agent.compact()
    local turns = {}
    for i, c in ipairs(Agent.history) do
        if c.role == "user" and c.parts[1] and c.parts[1].functionResponse then
            turns[#turns + 1] = i
        end
    end
    for j = 1, #turns - 8 do
        local c = Agent.history[turns[j]]
        for _, p in ipairs(c.parts) do
            local fr = p.functionResponse
            local r = fr and fr.response
            if type(r) == "table" and type(r.result) == "string" and #r.result > 1600 and not r.compacted then
                r.result = U.truncate(r.result, 1200) .. "\n[old output trimmed — re-run the tool if needed]"
                r.compacted = true
            end
        end
    end
end

function Agent.estimateCtx()
    local ok, total = pcall(function()
        local sum = 0
        local function countStr(s)
            if type(s) ~= "string" then
                return
            end
            if #s > 200000 then
                sum += 200000
                return
            end
            sum += #s
        end
        local function walk(v, depth, seen)
            if depth > 6 then
                return
            end
            if type(v) == "string" then
                countStr(v)
            elseif type(v) == "table" then
                if seen[v] then
                    return
                end
                seen[v] = true
                for k, val in pairs(v) do
                    if type(k) == "string" then
                        countStr(k)
                    end
                    walk(val, depth + 1, seen)
                end
            else
                local s = tostring(v)
                countStr(s)
            end
        end
        local seen = {}
        for _, entry in ipairs(Agent.history or {}) do
            walk(entry, 0, seen)
        end
        return sum
    end)
    if not ok or type(total) ~= "number" then
        return 0
    end
    return math.floor(total / 4)
end

function Agent.compactForBudget()
    local ok, err = pcall(function()
        local history = Agent.history or {}
        local window = tonumber(Agent.ctxWindow) or 1000000
        -- (a) force-trim every tool-output older than the last 4 turns
        local keepFrom = math.max(1, #history - 3)
        for i = 1, keepFrom - 1 do
            local entry = history[i]
            if type(entry) == "table" and type(entry.parts) == "table" then
                for _, p in ipairs(entry.parts) do
                    if type(p) == "table" and type(p.functionResponse) == "table" then
                        local resp = p.functionResponse.response
                        if type(resp) == "table" and type(resp.result) == "string" and #resp.result > 600 then
                            resp.result = resp.result:sub(1, 600) .. " [trimmed for context]"
                        end
                    end
                end
            end
        end
        -- (b) drop oldest droppable turn-pair while over 90% of window
        local guard = 0
        while Agent.estimateCtx() > 0.9 * window and guard < 100 do
            guard += 1
            local dropIdx = nil
            for i = 2, #history do
                if type(history[i]) == "table" and history[i].role == "model" then
                    dropIdx = i
                    break
                end
            end
            if not dropIdx then
                break
            end
            table.remove(history, dropIdx)
            if dropIdx <= #history then
                local nxt = history[dropIdx]
                if type(nxt) == "table" and nxt.role == "user" then
                    table.remove(history, dropIdx)
                end
            end
            if #history <= 1 then
                break
            end
        end
        -- (c) if still over, halve the largest remaining tool-output (max 5 times)
        for _ = 1, 5 do
            if Agent.estimateCtx() <= 0.9 * window then
                break
            end
            local best, bestLen = nil, 500
            for _, entry in ipairs(history) do
                if type(entry) == "table" and type(entry.parts) == "table" then
                    for _, p in ipairs(entry.parts) do
                        if type(p) == "table" and type(p.functionResponse) == "table" then
                            local resp = p.functionResponse.response
                            if type(resp) == "table" and type(resp.result) == "string" and #resp.result > bestLen then
                                best = resp
                                bestLen = #resp.result
                            end
                        end
                    end
                end
            end
            if not best then
                break
            end
            local half = math.max(500, math.floor(#best.result / 2))
            best.result = best.result:sub(1, half) .. " [trimmed for context]"
        end
    end)
    if not ok then
        return
    end
end

function Agent.buildBody()
    local gen = { maxOutputTokens = 65536 }
    if type(AI.thinkLevel) == "string" and AI.thinkLevel ~= "" and not AI.skipThinking then
        gen.thinkingConfig = { thinkingLevel = string.upper(AI.thinkLevel) }
    end
    return {
        systemInstruction = { parts = { { text = Prompt.system(Agent.lib) } } },
        contents = Agent.history,
        tools = { { functionDeclarations = Tools.declarations } },
        toolConfig = { functionCallingConfig = { mode = "AUTO" } },
        generationConfig = gen,
    }
end

function Agent.spawn(fn)
    Agent.running = true
    Agent.stopRequested = false
    Agent.session = true
    UI.onAgentStart()
    task.spawn(function()
        local ok, res = xpcall(fn, function(e)
            return tostring(e) .. "\n" .. debug.traceback()
        end)
        Agent.running = false
        if not ok then
            UI.addError("Unexpected error: " .. U.truncate(tostring(res), 700))
            res = "error"
        end
        UI.onAgentEnd(res)
    end)
end

function Agent.start(instruction, lib)
    if Agent.running then
        return
    end
    local freshOk = false
    if Sessions ~= nil and type(Sessions.newCurrent) == "function" then
        local okC, sid = pcall(Sessions.newCurrent, instruction or "")
        if okC and type(sid) == "string" and sid ~= "" then
            freshOk = true
        end
    end
    if not freshOk then
        Agent.history = {}
        Agent.step = 0
        Agent.ctxUsed = 0
        Agent.stepCap = 200
        Agent.probes, Agent.probeWarned = 0, false
        Agent.tokens = 0
        Agent.queue = {}
        Agent.currentSessionId = ("%d-%04d"):format(os.time(), math.random(0, 9999))
        Draft.reset()
    end
    Agent.instruction = instruction or ""
    Agent.lib = lib or "rayfield"
    Agent.history = {}
    Agent.step = 0
    Agent.ctxUsed = 0
    Agent.stepCap = 200
    Agent.probes, Agent.probeWarned = 0, false
    Agent.tokens = 0
    AI.skipReasoning, AI.skipThinking, AI.skipTools, AI.skipStream = nil, nil, nil, nil
    if Agent.provider ~= "openrouter" then
        AI.model = DEFAULT_MODEL
    end
    Agent.spawn(function()
        UI.setStatus("Preparing RemoteSpy and listeners", "tool")
        Spy.install()
        Spy.listenIncoming()
        local snapshot = Tools.execute("get_game_info", {})
        Agent.pushUser(Prompt.initial(Agent.instruction, Agent.lib, snapshot))
        return Agent.loop()
    end)
end

function Agent.followUp(text)
    if Agent.running or not Agent.session then
        return
    end
    Agent.stepCap = Agent.step + 100
    Draft.finished = false
    Draft.finishRefusals = 0
    Agent.spawn(function()
        Agent.pushUser(Prompt.followUp(text))
        return Agent.loop()
    end)
end

function Agent.enqueue(text)
    text = U.trim(text or "")
    if text == "" then
        return nil
    end
    if type(Agent.queue) ~= "table" then
        Agent.queue = {}
    end
    Agent.queue[#Agent.queue + 1] = { text = text, t = os.clock() }
    if UI ~= nil and type(UI.renderQueue) == "function" then
        pcall(UI.renderQueue)
    end
    return #Agent.queue
end

function Agent.dequeueCancel(i)
    if type(Agent.queue) ~= "table" or #Agent.queue == 0 then
        return nil
    end
    i = tonumber(i) or #Agent.queue
    i = math.clamp(math.floor(i), 1, #Agent.queue)
    local removed = table.remove(Agent.queue, i)
    if UI ~= nil and type(UI.renderQueue) == "function" then
        pcall(UI.renderQueue)
    end
    if type(removed) == "table" then
        return removed.text
    end
    return true
end

function Agent.nextQueued()
    if type(Agent.queue) ~= "table" or #Agent.queue == 0 then
        return false
    end
    local text = ""
    while #Agent.queue > 0 do
        local item = table.remove(Agent.queue, 1)
        if type(item) == "table" then
            text = U.trim(item.text or "")
        else
            text = U.trim(item or "")
        end
        if text ~= "" then
            break
        end
        text = ""
    end
    if text == "" then
        if UI ~= nil and type(UI.renderQueue) == "function" then
            pcall(UI.renderQueue)
        end
        return false
    end
    Agent.pushUser(text)
    Draft.finished = false
    Draft.finishRefusals = 0
    Agent.stepCap = (tonumber(Agent.stepCap) or 200) + 40
    if UI ~= nil and type(UI.renderQueue) == "function" then
        pcall(UI.renderQueue)
    end
    return true
end

function Agent.stop()
    if Agent.running then
        Agent.stopRequested = true
        UI.setStatus("Stopping…", "warn")
        if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
            pcall(Sessions.saveCurrent)
        end
    end
end

function Agent.startFromCode(code, instruction, lib)
    if Agent.running then
        return
    end
    if Sessions ~= nil and type(Sessions.newCurrent) == "function" then
        pcall(Sessions.newCurrent, instruction or "")
    end
    Draft.reset()
    Draft.code = Draft.clean(code)
    Draft.version = 1
    if type(Draft.check) == "function" then
        pcall(Draft.check)
    end
    if UI ~= nil and type(UI.onDraftUpdated) == "function" then
        pcall(UI.onDraftUpdated)
    end
    Agent.instruction = instruction or ""
    Agent.lib = lib or "rayfield"
    Agent.history = {}
    Agent.step = 0
    Agent.ctxUsed = 0
    Agent.stepCap = 200
    Agent.probes, Agent.probeWarned = 0, false
    Agent.tokens = 0
    AI.skipReasoning, AI.skipThinking, AI.skipTools, AI.skipStream = nil, nil, nil, nil
    Agent.spawn(function()
        UI.setStatus("Preparing RemoteSpy and listeners", "tool")
        Spy.install()
        Spy.listenIncoming()
        local snapshot = Tools.execute("get_game_info", {})
        Agent.pushUser(Prompt.initial(Agent.instruction, Agent.lib, snapshot))
        Agent.pushUser(("You are continuing an EXISTING script (already loaded as the script.lua draft — use read_script to view parts, edit_script to change it). User request: %s\n\nScript preview (first 6000 chars):\n%s"):format(
            tostring(instruction or ""),
            tostring(code or ""):sub(1, 6000)
        ))
        return Agent.loop()
    end)
end

function Agent.loop()
    local nudges = 0
    while true do
        if Agent.stopRequested then
            return "stopped"
        end
        if Agent.step >= Agent.stepCap then
            UI.addNotice("Safety step cap reached.")
            if Draft.code then
                Draft.finish({})
                if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                    pcall(Sessions.saveCurrent)
                end
                if Agent.nextQueued() then
                    nudges = 0
                else
                    return "finished"
                end
            else
                return "cap"
            end
        end
        Agent.step += 1
        if Agent.step % 5 == 0 and Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
            pcall(Sessions.saveCurrent)
        end
        UI.setCtx()
        UI.setStatus(AI.thinkingLabel(), "think")
        Agent.compact()
        if (Agent.ctxUsed or 0) > 0.9 * ((Agent.ctxWindow or 1000000)) then
            Agent.compactForBudget()
            if Agent.estimateCtx() > 0.98 * ((Agent.ctxWindow or 1000000)) then
                UI.addNotice("Context budget exhausted.")
                if Draft.code then
                    Draft.finish({})
                    if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                        pcall(Sessions.saveCurrent)
                    end
                    if Agent.nextQueued() then
                        nudges = 0
                    else
                        return "finished"
                    end
                else
                    return "ctxfull"
                end
            end
        end
        UI.beginThinking()
        local data, err = AI.generate(Agent.buildBody())
        if Agent.stopRequested then
            UI.endThinking()
            return "stopped"
        end
        if not data then
            UI.endThinking()
            UI.addError(err or "Unknown API error")
            return "error"
        end
        -- One-shot warning once most of the recon budget is gone. The hard lock above is what
        -- actually enforces this; the warning exists so the agent can wrap up on its own terms
        -- instead of being cut off mid-investigation.
        if not Agent.probeWarned and not Draft.code and (Agent.probes or 0) >= Agent.PROBE_SOFT then
            Agent.probeWarned = true
            local left = Agent.probeLeft()
            Agent.pushUser(("[SYSTEM] You have used %d of %d recon calls (%d left). "
                .. "Stop investigating and start writing. Call write_script with the COMPLETE script now, "
                .. "then check_script and finish. Only the authoring tools work once the budget is gone.")
                :format(Agent.probes, Agent.PROBE_HARD, left))
        end
        local usage = data.usageMetadata
        if type(usage) == "table" then
            Agent.tokens += tonumber(usage.totalTokenCount) or 0
            Agent.ctxUsed = tonumber(usage.promptTokenCount) or Agent.ctxUsed
        end
        local cand = type(data.candidates) == "table" and data.candidates[1] or nil
        local content = cand and cand.content
        if type(content) ~= "table" or type(content.parts) ~= "table" or #content.parts == 0 then
            UI.endThinking()
            local reason = (type(data.promptFeedback) == "table" and data.promptFeedback.blockReason)
                or (cand and cand.finishReason) or "empty response"
            nudges += 1
            if nudges > 3 then
                UI.addError("Model produced no response (" .. tostring(reason) .. ").")
                if Draft.code then
                    Draft.finish({})
                    if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                        pcall(Sessions.saveCurrent)
                    end
                    if Agent.nextQueued() then
                        nudges = 0
                    else
                        return "finished"
                    end
                else
                    return "error"
                end
            end
            if nudges > 0 then
                if reason == "MALFORMED_FUNCTION_CALL" then
                    Agent.pushUser("Your last function call was malformed (invalid JSON arguments). Call the tool again with valid arguments. Long code goes into write_script's `code` string.")
                else
                    Agent.pushUser("Your previous response was empty (" .. tostring(reason) .. "). Continue the task using the tools.")
                end
                UI.setStatus("Empty response · retrying", "warn")
            end
        else
            content.role = "model"
            Agent.sanitize(content)
            Agent.history[#Agent.history + 1] = content
            local calls = {}
            for _, p in ipairs(content.parts) do
                if type(p.functionCall) == "table" then
                    calls[#calls + 1] = p.functionCall
                elseif type(p.text) == "string" and not p.thought and U.trim(p.text) ~= "" then
                    UI.addAssistant(p.text)
                end
            end
            -- Close the turn's thinking line now that the call names are known, so it reads
            -- chronologically above the reply and above the tool rows it produced.
            if #calls > 0 then
                local names = {}
                for i, c in ipairs(calls) do
                    if i > 3 then
                        names[#names + 1] = "+" .. (#calls - 3) .. " more"
                        break
                    end
                    names[#names + 1] = tostring(c.name)
                end
                UI.endThinking(table.concat(names, ", "))
            else
                UI.endThinking()
            end
            if #calls == 0 then
                if Draft.finished then
                    if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                        pcall(Sessions.saveCurrent)
                    end
                    if Agent.nextQueued() then
                        nudges = 0
                    else
                        return "finished"
                    end
                else
                    local justQueued = false
                    local pasted = Draft.extract(content)
                    if pasted and not Draft.code then
                        Draft.code = Draft.clean(pasted)
                        Draft.version += 1
                        local _, ok = Draft.check()
                        UI.onDraftUpdated()
                        if ok then
                            Draft.finish({})
                            if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                                pcall(Sessions.saveCurrent)
                            end
                            if Agent.nextQueued() then
                                nudges = 0
                                justQueued = true
                            else
                                return "finished"
                            end
                        end
                    end
                    if not justQueued then
                        nudges += 1
                        if nudges > 3 then
                            if Draft.code then
                                Draft.finish({})
                                if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                                    pcall(Sessions.saveCurrent)
                                end
                                if Agent.nextQueued() then
                                    nudges = 0
                                else
                                    return "finished"
                                end
                            else
                                return "error"
                            end
                        end
                        if nudges > 0 then
                            Agent.pushUser(Draft.code
                                and "Continue. If script.lua is complete and the syntax check is clean, call finish now; otherwise fix it with edit_script."
                                or "Continue working with the tools. When ready, call write_script with the complete script, then finish.")
                        end
                    end
                end
            else
                nudges = 0
                local responses = {}
                local finishedNow = false
                for idx, call in ipairs(calls) do
                    local result
                    local isProbe = Agent.PROBE_TOOLS[tostring(call.name)] == true
                    if Agent.stopRequested then
                        result = "Cancelled by the user."
                    elseif isProbe and Agent.probeLeft() <= 0 then
                        -- Budget spent. Refuse the recon instead of running it, so the run
                        -- always ends in a written script rather than a hundredth probe.
                        result = ("Recon budget spent (%d/%d calls). Stop investigating. "
                            .. "Call write_script now with the complete script, then check_script, then finish. "
                            .. "If script.lua already exists, use edit_script for what is missing."):format(
                            Agent.probes, Agent.PROBE_HARD)
                    else
                        if isProbe then
                            Agent.probes += 1
                        end
                        result = Tools.execute(call.name, type(call.args) == "table" and call.args or {})
                    end
                    if idx == #calls and not Draft.finished then
                        local frac = (Agent.ctxUsed or 0) / math.max(Agent.ctxWindow or 1, 1)
                        if frac > 0.85 then
                            result ..= ("\n\n[SYSTEM] Context is %d%% full. %s"):format(math.floor(frac * 100),
                                Draft.code and "Fix remaining issues and call finish."
                                    or "Write the COMPLETE script now with write_script, then call finish.")
                        end
                    end
                    local fr = { name = call.name, response = { result = result } }
                    if call.id then
                        fr.id = call.id
                    end
                    responses[#responses + 1] = { functionResponse = fr }
                    if call.name == "finish" and Draft.finished then
                        finishedNow = true
                    end
                end
                -- The run used to end silently: finish carried a summary, but the loop just
                -- stopped, so the chat gave the user nothing explaining the delivered script.
                -- Drop the write-up into the feed as a real closing message.
                if finishedNow then
                    Agent.announceFinish()
                end
                Agent.history[#Agent.history + 1] = { role = "user", parts = responses }
                if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                    pcall(Sessions.saveCurrent)
                end
                if Agent.stopRequested then
                    return "stopped"
                end
                if finishedNow then
                    if Sessions ~= nil and type(Sessions.saveCurrent) == "function" then
                        pcall(Sessions.saveCurrent)
                    end
                    if Agent.nextQueued() then
                        nudges = 0
                    else
                        return "finished"
                    end
                end
            end
        end
    end
end
