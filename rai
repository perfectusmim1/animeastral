-- Resolves Lua string escapes (for ["..."] and ("...") args inside paths)
function U.unescape(str)
    if not str:find("\\", 1, true) then
        return str
    end
    str = str:gsub("\\(%d%d?%d?)", function(d)
        local n = tonumber(d)
        return (n and n < 256) and string.char(n) or ""
    end)
    str = str:gsub("\\n", "\n"):gsub("\\t", "\t"):gsub('\\"', '"'):gsub("\\'", "'"):gsub("\\\\", "\\")
    return str
end

function U.childNames(inst, max)
    max = max or 25
    local ok, kids = pcall(function()
        return inst:GetChildren()
    end)
    if not ok then
        return "?"
    end
    local t = {}
    for i, k in ipairs(kids) do
        if i > max then
            t[#t + 1] = ("…+%d"):format(#kids - max)
            break
        end
        t[#t + 1] = k.Name
    end
    return #t > 0 and table.concat(t, ", ") or "(none)"
end

-- Builds a re-resolvable, portable path for an instance
function U.indexSeg(parent, child)
    local name = child.Name
    local ok, v = pcall(function()
        return parent[name]
    end)
    if ok and v == child then
        if U.isIdent(name) then
            return "." .. name
        end
        return "[" .. Ser.str(name) .. "]"
    end
    return ":FindFirstChild(" .. Ser.str(name) .. ")"
end

function U.path(inst)
    if typeof(inst) ~= "Instance" then
        return tostring(inst)
    end
    if inst == game then
        return "game"
    end
    if inst == Workspace then
        return "workspace"
    end
    local segs = {}
    local cur = inst
    local char = LocalPlayer.Character
    local guard = 0
    while cur do
        guard += 1
        if guard > 200 then
            break
        end
        if cur == game then
            return "game" .. table.concat(segs)
        elseif cur == Workspace then
            return "workspace" .. table.concat(segs)
        elseif cur == LocalPlayer then
            return 'game:GetService("Players").LocalPlayer' .. table.concat(segs)
        elseif char and cur == char then
            return 'game:GetService("Players").LocalPlayer.Character' .. table.concat(segs)
        end
        local parent = cur.Parent
        if parent == nil then
            return "getnil(" .. Ser.str(cur.Name) .. ", " .. Ser.str(cur.ClassName) .. ")" .. table.concat(segs)
        end
        if parent == game then
            local okS, svc = pcall(function()
                return game:FindService(cur.ClassName)
            end)
            if okS and svc == cur then
                return 'game:GetService("' .. cur.ClassName .. '")' .. table.concat(segs)
            end
        end
        table.insert(segs, 1, U.indexSeg(parent, cur))
        cur = parent
    end
    return table.concat(segs)
end

