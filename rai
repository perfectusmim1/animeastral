    end
    id = U.trim(tostring(id or ""))
    if id == "" then
        return
    end
    provider = (provider == "openrouter") and "openrouter" or "gemini"
    local n = 0
    if Keys ~= nil and Keys.byProvider ~= nil and type(Keys.byProvider[provider]) == "table" then
        n = #Keys.byProvider[provider]
    elseif UI.provider == provider and Keys ~= nil and type(Keys.list) == "table" then
        n = #Keys.list
    end
    if n == 0 then
        UI.toast(provider == "openrouter" and "Add an OpenRouter API key first" or "Add a Gemini API key first", "error")
        return
    end
    UI.selectProvider(provider)
    if AI ~= nil then
        AI.skipReasoning, AI.skipThinking, AI.skipTools, AI.skipStream = nil, nil, nil, nil
    end
    if Store.data == nil then
        Store.data = {}
    end
    if provider == "gemini" then
        if AI ~= nil then
            AI.model = id
        end
        Store.data.gemini_model = id
    else
        if AI ~= nil then
            AI.orModel = id
        end
        Store.data.or_model = id
        UI.rememberOrModel(id)
    end
    pcall(Store.save)
    UI.renderModelLabel()
    UI.toggleModelMenu(false)
    UI.toggleQModelMenu(false)
    UI.flyHoverRow, UI.flyHover = false, false
    UI.flyHide()
    UI.toast("Model: " .. id)
end

function UI.rebuildFeed()
    if UI.dead or not UI.feed then
        return
    end
    UI.clearFeed()
    UI.bulk = true
    local hist = (type(Agent.history) == "table") and Agent.history or {}
    local function argsSummary(args)
        if type(args) ~= "table" then
            return "from history"
        end
        local bits = {}
        for k, v in pairs(args) do
            local t = type(v)
            if (t == "string" and v ~= "") or t == "number" or t == "boolean" then
                bits[#bits + 1] = tostring(k) .. "=" .. U.truncate(tostring(v), 40)
                if #bits >= 2 then
                    break
                end
            end
        end
        if #bits == 0 then
            return "from history"
        end
        return table.concat(bits, ", ")
    end
    local function findResponse(idx, name, id)
        local nxt = hist[idx + 1]
        if type(nxt) ~= "table" or type(nxt.parts) ~= "table" then
            return nil
        end
        for _, p in ipairs(nxt.parts) do
            local fr = type(p) == "table" and p.functionResponse or nil
            if type(fr) == "table" then
                local sameName = tostring(fr.name or "") == tostring(name or "")
                local sameId = (id == nil and fr.id == nil) or (id ~= nil and tostring(fr.id) == tostring(id))
                if sameName and sameId then
                    local r = fr.response
                    local res = type(r) == "table" and r.result or r
                    if type(res) == "string" and res ~= "" then
                        return res
                    end
                    return nil
                end
            end
        end
        return nil
    end
    local first = true
    for i, c in ipairs(hist) do
        if type(c) == "table" and type(c.parts) == "table" then
            if c.role == "user" then
                for _, p in ipairs(c.parts) do
                    if type(p) == "table" and type(p.text) == "string" and p.text ~= "" and p.functionResponse == nil then
                        if first then
                            first = false
                            UI.addNotice("Session started — " .. U.truncate(p.text, 140))
                        else
                            UI.addUser(U.truncate(p.text, 800))
                        end
                    end
                end
            elseif c.role == "model" then
                for _, p in ipairs(c.parts) do
                    if type(p) == "table" then
                        if type(p.text) == "string" and p.text ~= "" and not p.thought then
                            UI.addAssistant(U.truncate(p.text, 800))
                        elseif type(p.functionCall) == "table" then
                            local fc = p.functionCall
                            local preview = findResponse(i, fc.name, fc.id)
                            if type(preview) == "string" and #preview > 4000 then
                                preview = preview:sub(1, 4000) .. "\n…[trimmed]"
                            end
                            local row = UI.toolStart(tostring(fc.name or "tool"), argsSummary(fc.args), "wand")
                            UI.toolDone(row, true, "done", preview)
                        end
                    end
                end
            end
        end
    end
    UI.bulk = false
    task.defer(UI.scrollBottom)
end

function UI.openSession(id, title)
    if UI.dead then
        return
    end
    if Agent.running then
        UI.toast("Stop the agent first", "error")
        return
    end
    if not (Sessions and Sessions.load) then
        return
    end
    local ok = pcall(Sessions.load, id)
    if not ok then
        UI.toast("Couldn't load session", "error")
        return
    end
    local turns = 0
    if type(Agent.history) == "table" then
        turns = #Agent.history
    end
    local t2 = tostring(title or "Session")
    UI.toggleSidePanel(false)
    if UI.selectProvider and Agent.provider ~= nil then
        pcall(function()
            UI.selectProvider(Agent.provider)
        end)
    end
    Agent.session = turns > 0
    if turns > 0 then
        UI.rebuildFeed()
        UI.setMode("session")
        UI.showPage("agent")
        UI.addNotice(("Session '%s' opened — context restored. Type to continue."):format(t2))
    else
        UI.showPage("setup")
        UI.toast(("Session '%s' is empty — press START"):format(t2))
    end
    pcall(function()
        UI.onDraftUpdated()
    end)
    UI.updateComposer()
end

function UI.applyOrField(kind)
    if UI.dead then
        return
    end
    local box = (kind == "model") and UI.orModelBox or UI.orEffortBox
    if not box then
        return
    end
    if Agent.running then
        UI.toast("Stop the agent first to change model settings", "error")
        if AI ~= nil then
            if kind == "model" and AI.orModel ~= nil then
                box.Text = tostring(AI.orModel)
            elseif kind == "effort" and AI.orEffort ~= nil then
                box.Text = tostring(AI.orEffort)
            end
        end
        return
    end
    local v = U.trim(box.Text)
    if kind == "model" then
        local prev = (AI ~= nil and AI.orModel ~= nil) and tostring(AI.orModel) or ""
        if v == "" then
            box.Text = prev
            UI.toast("Model id can't be empty", "error")
            return
        end
        if v ~= prev then
            if AI ~= nil then
                AI.orModel = v
                AI.skipReasoning = nil
            end
            Store.data.or_model = v
            Store.save()
            UI.rememberOrModel(v)
            UI.renderModelLabel()
            UI.toast("Model set to " .. v)
        end
    else
        local prev = (AI ~= nil and AI.orEffort ~= nil) and tostring(AI.orEffort) or ""
        if v ~= prev then
            -- Validate against the levels OpenRouter actually accepts; a typo here
            -- otherwise only surfaces as an opaque 400 on the next run.
            local valid = { low = true, medium = true, high = true, xhigh = true, max = true }
            if v ~= "" and not valid[v:lower()] then
                box.Text = prev
                UI.toast("Effort must be empty, low, medium, high, xhigh or max", "error")
                return
            end
            if AI ~= nil then
                AI.orEffort = v
                AI.skipReasoning = nil
            end
            Store.data.or_effort = v
            Store.save()
            UI.renderModelLabel()
            UI.toast(v == "" and "Reasoning effort: model default" or ("Reasoning effort set to " .. v))
        end
    end
end

