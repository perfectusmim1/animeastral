-- SYNTAX HIGHLIGHTING (RichText, per line)
--══════════════════════════════════════════════════════════════════════
local Highlight = {}
local HL = { kw = "#c792ea", str = "#c3e88d", num = "#f78c6c", com = "#6b7280", fn = "#82aaff", builtin = "#ffcb6b" }
local BUILTINS = {}
for _, k in ipairs({ "game", "workspace", "script", "Instance", "Vector3", "Vector2", "CFrame", "Color3", "UDim2", "UDim",
    "Enum", "task", "math", "string", "table", "pcall", "xpcall", "loadstring", "print", "warn", "typeof", "type",
    "tostring", "tonumber", "ipairs", "pairs", "next", "require", "getgenv", "self", "error", "select", "setmetatable",
    "TweenInfo", "BrickColor", "Ray", "RaycastParams", "OverlapParams", "NumberSequence", "ColorSequence", "os", "tick" }) do
    BUILTINS[k] = true
end

local function esc(s)
    return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function Highlight.lines(code)
    local lines, cur = {}, {}
    local function emit(text, color)
        local first = true
        for seg in (text .. "\n"):gmatch("(.-)\n") do
            if not first then
                lines[#lines + 1] = table.concat(cur)
                cur = {}
            end
            first = false
            if seg ~= "" then
                if color then
                    cur[#cur + 1] = '<font color="' .. color .. '">' .. esc(seg) .. "</font>"
                else
                    cur[#cur + 1] = esc(seg)
                end
            end
        end
    end
    local i, n = 1, #code
    while i <= n do
        local c = code:sub(i, i)
        if c == "-" and code:sub(i + 1, i + 1) == "-" then
            local lvl = code:match("^%-%-%[(=*)%[", i)
            local j
            if lvl then
                local close = "]" .. lvl .. "]"
                local e = code:find(close, i + 4 + #lvl, true)
                j = e and (e + #close - 1) or n
            else
                local e = code:find("\n", i, true)
                j = e and (e - 1) or n
            end
            emit(code:sub(i, j), HL.com)
            i = j + 1
        elseif c == '"' or c == "'" then
            local j = i + 1
            while j <= n do
                local d = code:sub(j, j)
                if d == "\\" then
                    j += 2
                elseif d == c or d == "\n" then
                    break
                else
                    j += 1
                end
            end
            if j > n then
                j = n
            end
            emit(code:sub(i, j), HL.str)
            i = j + 1
        elseif c == "`" then
            local e = code:find("`", i + 1, true)
            local j = e or n
            emit(code:sub(i, j), HL.str)
            i = j + 1
        elseif c == "[" and code:match("^%[=*%[", i) then
            local lvl = code:match("^%[(=*)%[", i)
            local close = "]" .. lvl .. "]"
            local e = code:find(close, i + 2 + #lvl, true)
            local j = e and (e + #close - 1) or n
            emit(code:sub(i, j), HL.str)
            i = j + 1
        elseif c:match("%d") then
            local num = code:match("^0[xX]%x+", i) or code:match("^%d+%.?%d*[eE][%+%-]?%d+", i) or code:match("^%d+%.?%d*", i) or c
            emit(num, HL.num)
            i += #num
        elseif c:match("[%a_]") then
            local word = code:match("^[%a_][%w_]*", i)
            local j = i + #word - 1
            local color
            if KEYWORDS[word] then
                color = HL.kw
            elseif BUILTINS[word] then
                color = HL.builtin
            else
                local nextc = code:match("^%s*(.)", j + 1)
                if nextc == "(" then
                    color = HL.fn
                end
            end
            emit(word, color)
            i = j + 1
        elseif c == "\n" then
            emit("\n")
            i += 1
        else
            local run = code:match("^[^%w_\"'%-%[`\n]+", i)
            if run and #run > 0 then
                emit(run)
                i += #run
            else
                emit(c)
                i += 1
            end
        end
    end
    lines[#lines + 1] = table.concat(cur)
    return lines
end

local function md(s)
    s = U.trim(s)
    if #s > 1600 then
        s = s:sub(1, 1600) .. "…"
    end
    s = esc(s)
    s = s:gsub("```[%w]*\n?(.-)```", '<font color="#bdbdbd">%1</font>')
    s = s:gsub("%*%*(.-)%*%*", "<b>%1</b>")
    s = s:gsub("`([^`\n]+)`", '<font color="#d9d9d9">%1</font>')
    s = s:gsub("\n%s*[%-%*] ", "\n• "):gsub("^%s*[%-%*] ", "• ")
    s = s:gsub("\n#+%s*", "\n"):gsub("^#+%s*", "")
    return s
end

