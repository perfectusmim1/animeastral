function UI.renderQueue()
    if UI.dead or not UI.queueBar then
        return
    end
    for _, ch in ipairs(UI.queueBar:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextButton") then
            ch:Destroy()
        end
    end
    local q = (Agent and Agent.queue) or nil
    if type(q) ~= "table" or #q == 0 then
        UI.queueBar.Visible = false
        return
    end
    UI.queueBar.Visible = UI.bottom and UI.bottom.Visible or true
    for i, item in ipairs(q) do
        local txt = ""
        if type(item) == "string" then
            txt = item
        elseif type(item) == "table" then
            txt = tostring(item.text or item.prompt or item.msg or "")
        else
            txt = tostring(item)
        end
        if #txt > 60 then
            txt = txt:sub(1, 60) .. "..."
        end
        local chip = New("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = C.surface2, LayoutOrder = i, Parent = UI.queueBar })
        Corner(14, chip)
        Stroke(C.soft, chip)
        Text({ Text = ("#%d  %s"):format(i, txt), TextSize = 13, TextColor3 = C.text2,
            Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -44, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = chip })
        local x = New("TextButton", { Text = "x", Font = FONT.medium, TextSize = 14, TextColor3 = C.muted,
            AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(24, 24), Parent = chip })
        local idx = i
        x.MouseButton1Click:Connect(function()
            if UI.dead then
                return
            end
            if Agent and Agent.dequeueCancel then
                pcall(function()
                    Agent.dequeueCancel(idx)
                end)
            end
            UI.renderQueue()
        end)
    end
end

