-- SCRIPT DISCOVERY / DECOMPILE / CONSTANTS
--══════════════════════════════════════════════════════════════════════
local ROBLOX_SCRIPTS = {
    PlayerModule = true, RbxCharacterSounds = true, ChatScript = true, BubbleChat = true, ChatMain = true,
    PlayerScriptsLoader = true, Animate = true, Health = true, CameraScript = true, ControlScript = true,
    ChatServiceRunner = true, ClientChatModules = true, ChatModules = true,
}

Scripts.cache = setmetatable({}, { __mode = "k" })
Scripts.closureCache = setmetatable({}, { __mode = "k" })

function Scripts.isRoblox(s)
    if ROBLOX_SCRIPTS[s.Name] then
        return true
    end
    local okA, anc = pcall(function()
        return s:FindFirstAncestor("PlayerModule") or s:FindFirstAncestor("ChatScript") or s:FindFirstAncestor("BubbleChat")
    end)
    if okA and anc then
        return true
    end
    local okC, inCore = pcall(function()
        return s:IsDescendantOf(CoreGui) or s:IsDescendantOf(game:GetService("CorePackages"))
    end)
    if okC and inCore then
        return true
    end
    return false
end

function Scripts.collect(includeRoblox)
    local seen, list = {}, {}
    local function add(s)
        if typeof(s) ~= "Instance" or seen[s] then
            return
        end
        seen[s] = true
        local okc, isScript = pcall(function()
            return s:IsA("LuaSourceContainer")
        end)
        if not okc or not isScript then
            return
        end
        local cls = s.ClassName
        if cls == "Script" then
            local okR, rc = pcall(function()
                return s.RunContext
            end)
            if not (okR and rc == Enum.RunContext.Client) then
                return
            end
        elseif cls ~= "LocalScript" and cls ~= "ModuleScript" then
            return
        end
        if not includeRoblox and Scripts.isRoblox(s) then
            return
        end
        list[#list + 1] = s
    end
    local function each(fn)
        if fn then
            pcall(function()
                for _, s in ipairs(fn()) do
                    add(s)
                end
            end)
        end
    end
    each(Env.getscripts)
    each(Env.getloadedmodules)
    each(Env.getrunningscripts)
    each(Env.getnilinstances)
    for _, root in ipairs({ ReplicatedStorage, ReplicatedFirst, LocalPlayer, Workspace, StarterGui, StarterPlayer, StarterPack, Lighting }) do
        if root then
            pcall(function()
                for _, d in ipairs(root:GetDescendants()) do
                    add(d)
                end
            end)
        end
    end
    return list
end

function Scripts.statusMaps()
    local loaded, running = {}, {}
    if Env.getloadedmodules then
        pcall(function()
            for _, m in ipairs(Env.getloadedmodules()) do
                loaded[m] = true
            end
        end)
    end
    if Env.getrunningscripts then
        pcall(function()
            for _, s in ipairs(Env.getrunningscripts()) do
                running[s] = true
            end
        end)
    end
    return loaded, running
end

function Scripts.priority(s)
    local p = 0
    if Scripts.cache[s] then
        p += 4
    end
    if s.ClassName == "LocalScript" then
        p += 2
    end
    local ok, inGood = pcall(function()
        return s:IsDescendantOf(ReplicatedStorage) or s:IsDescendantOf(LocalPlayer) or s:IsDescendantOf(ReplicatedFirst)
    end)
    if ok and inGood then
        p += 1
    end
    return p
end

function Scripts.decompile(s)
    local cached = Scripts.cache[s]
    if cached then
        return cached
    end
    if not Env.decompile then
        return nil, "executor does not support decompile"
    end
    local done, ok, res = false, nil, nil
    task.spawn(function()
        ok, res = pcall(Env.decompile, s)
        done = true
    end)
    local t0 = os.clock()
    while not done do
        if os.clock() - t0 > 25 then
            return nil, "decompile timed out (25s)"
        end
        task.wait(0.05)
    end
    if not ok then
        return nil, "decompile error: " .. tostring(res)
    end
    if type(res) ~= "string" or res == "" then
        return nil, "decompile returned an empty result"
    end
    res = U.safeStr(res)
    Scripts.cache[s] = res
    return res
end

function Scripts.closureInfo(s)
    if Scripts.closureCache[s] then
        return Scripts.closureCache[s]
    end
    if not Env.getscriptclosure then
        return nil, "getscriptclosure missing"
    end
    local ok, cl = pcall(Env.getscriptclosure, s)
    if not ok or type(cl) ~= "function" then
        return nil, "could not get script closure (bytecode may be unavailable)"
    end
    local strings, seenS, numbers, protos = {}, {}, {}, {}
    local visited = 0
    local function walk(fn, depth)
        visited += 1
        if visited > 500 then
            return
        end
        if Env.getconstants then
            local okc, consts = pcall(Env.getconstants, fn)
            if okc and type(consts) == "table" then
                for _, c in pairs(consts) do
                    if type(c) == "string" then
                        if not seenS[c] and #c > 0 and #c < 200 then
                            seenS[c] = true
                            strings[#strings + 1] = c
                        end
                    elseif type(c) == "number" then
                        numbers[c] = true
                    end
                end
            end
        end
        if Env.getprotos and depth < 12 then
            local okp, ps = pcall(Env.getprotos, fn)
            if okp and type(ps) == "table" then
                for _, p in pairs(ps) do
                    if type(p) == "function" then
                        local name, line = U.fnInfo(p)
                        if name ~= "" then
                            protos[#protos + 1] = name .. ":" .. tostring(line)
                        end
                        walk(p, depth + 1)
                    end
                end
            end
        end
    end
    pcall(walk, cl, 0)
    local info = { strings = strings, numbers = numbers, protos = protos, closure = cl }
    Scripts.closureCache[s] = info
    return info
end

function Scripts.formatConstants(info)
    local L = {}
    local strs = {}
    for i, s in ipairs(info.strings) do
        if i > 260 then
            strs[#strs + 1] = ("…+%d"):format(#info.strings - 260)
            break
        end
        strs[#strs + 1] = Ser.str(s)
    end
    L[#L + 1] = ("Strings (%d): %s"):format(#info.strings, table.concat(strs, " | "))
    if #info.protos > 0 then
        local p = {}
        for i, name in ipairs(info.protos) do
            if i > 90 then
                p[#p + 1] = "…"
                break
            end
            p[#p + 1] = name
        end
        L[#L + 1] = ("Functions (%d): %s"):format(#info.protos, table.concat(p, ", "))
    end
    local nums = {}
    for n in pairs(info.numbers) do
        if n ~= 0 and n ~= 1 and n ~= -1 and n ~= 2 then
            nums[#nums + 1] = n
        end
    end
    table.sort(nums)
    if #nums > 0 then
        local s = {}
        for i, n in ipairs(nums) do
            if i > 50 then
                break
            end
            s[#s + 1] = Ser.num(n)
        end
        L[#L + 1] = "Numbers: " .. table.concat(s, ", ")
    end
    return table.concat(L, "\n")
end

