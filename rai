function UI.sendFollowUp()
    if Agent.running then
        local text = ""
        if UI.input then
            text = U.trim(UI.input.Text)
        end
        if text ~= "" and Agent.enqueue then
            local ok, pos = pcall(function()
                return Agent.enqueue(text)
            end)
            if ok then
                UI.input.Text = ""
                UI.updateComposer()
                UI.toast("Queued (#" .. tostring(pos or "?") .. ")")
                UI.renderQueue()
            else
                UI.toast("Queue failed", "error")
            end
            return
        end
        Agent.stop()
        return
    end
    local text = U.trim(UI.input.Text)
    if text == "" or not Agent.session then
        return
    end
    if #Keys.list == 0 then
        UI.toast("No API key", "error")
        return
    end
    UI.input.Text = ""
    UI.showPage("agent")
    UI.addUser(text)
    Agent.followUp(text)
end

function UI.start()
    if Agent.running then
        return
    end
    if UI.startBtn and UI.startBtn.Parent then
        local orig = UI.startBtn.Size
        pcall(function()
            UI.startBtn.Size = UDim2.new(orig.X.Scale, orig.X.Offset, orig.Y.Scale, math.max(orig.Y.Offset - 3, 1))
        end)
        Tween(UI.startBtn, 0.12, { Size = orig })
    end
    if #Keys.list == 0 then
        UI.toast(UI.provider == "openrouter" and "Add your OpenRouter API key first" or "Add at least one Gemini API key first", "error")
        return
    end
    if not Env.request then
        UI.toast("This executor doesn't support HTTP requests", "error")
        return
    end
    local instruction = ""
    if UI.instrBox then
        instruction = U.trim(UI.instrBox.Text)
    end
    Store.data.instruction = instruction
    Store.data.library = UI.lib
    Store.save()
    local pending = UI.pendingCode
    local pendingName = UI.pendingName
    UI.clearFeed()
    UI.renderedVersion = -1
    UI.setMode("session")
    UI.showPage("agent")
    UI.progressFill.Size = UDim2.new(0, 0, 1, 0)
    UI.addNotice(("%s · %s · %s"):format(U.gameName(), Docs.names[UI.lib], UI.currentModel()))
    if pending and type(pending) == "string" and pending ~= "" then
        UI.addUser(("Continue %s · %s%s"):format(tostring(pendingName or "script.lua"), Docs.names[UI.lib], instruction ~= "" and ("\n" .. instruction) or ""))
        UI.pendingCode = nil
        UI.pendingName = nil
        UI.refreshPendingChip()
        if Agent and Agent.startFromCode then
            Agent.startFromCode(pending, instruction, UI.lib)
            return
        end
    end
    UI.addUser(("Generate a script for this game · %s%s"):format(Docs.names[UI.lib], instruction ~= "" and ("\n" .. instruction) or ""))
    Agent.start(instruction, UI.lib)
end

function UI.setVisible(v)
    if UI.dead then
        return
    end
    UI.visible = v
    if not UI.win or not UI.root then
        pcall(function()
            UI.root.Visible = v
        end)
        pcall(function()
            UI.pill.Visible = not v
        end)
        return
    end
    -- Apple-style: morph into the pill footprint (176x36, top-center) while drifting up.
    UI.visToken = (UI.visToken or 0) + 1
    local token = UI.visToken
    if UI.visTweens then
        for _, tw in ipairs(UI.visTweens) do
            pcall(function()
                tw:Cancel()
            end)
        end
    end
    UI.visTweens = {}
    local pillSize = UDim2.fromOffset(176, 36)
    local pillCenter = UDim2.new(0.5, 0, 0, 32)
    local function setContentVisible(v)
        -- win itself is the shell (bg + stroke); hide only inner content so nothing squishes mid-morph
        pcall(function()
            UI.top.Visible = v
        end)
        pcall(function()
            UI.body.Visible = v
        end)
        pcall(function()
            UI.sidePanel.Visible = v and (UI.sideOpen or false)
        end)
        pcall(function()
            UI.modelMenu.Visible = false
        end)
        pcall(function()
            UI.modelDim.Visible = false
        end)
    end
    if not v then
        UI.minSize = UI.root.Size
        UI.minPos = UI.root.Position
        setContentVisible(false)
        pcall(function()
            UI.root.ClipsDescendants = true
        end)
        UI.visTweens[#UI.visTweens + 1] = Tween(UI.root, 0.3, { Size = pillSize, Position = pillCenter })
        task.delay(0.3, function()
            if UI.dead or UI.visible or token ~= UI.visToken then
                return
            end
            UI.root.Visible = false
            UI.pill.Visible = true
            pcall(function()
                UI.root.ClipsDescendants = false
            end)
        end)
    else
        UI.root.Visible = true
        UI.pill.Visible = false
        UI.root.Size = pillSize
        UI.root.Position = pillCenter
        UI.visTweens[#UI.visTweens + 1] = Tween(UI.root, 0.32, {
            Size = UI.minSize or UDim2.fromOffset(W, H),
            Position = UI.minPos or UDim2.fromScale(0.5, 0.5),
        })
        task.delay(0.33, function()
            if UI.dead or token ~= UI.visToken then
                return
            end
            setContentVisible(true)
            pcall(function()
                UI.root.ClipsDescendants = false
            end)
        end)
    end
end

function UI.toggleSidePanel(open)
    if UI.dead or not UI.sidePanel then
