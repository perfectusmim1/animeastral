-- HTTP (executor request + timeout)
--══════════════════════════════════════════════════════════════════════
function Http.post(url, body, timeout, headers)
    local req = Env.request
    if not req then
        return nil, "executor does not support HTTP requests (no request / http_request)"
    end
    local merged = { ["Content-Type"] = "application/json" }
    if type(headers) == "table" then
        for k, v in pairs(headers) do
            merged[k] = v
        end
    end
    local done, ok, res = false, nil, nil
    task.spawn(function()
        -- No Timeout field on purpose: it was tried and Real ignores it (measured — a request
        -- with Timeout = 300000 still died at exactly 30000 ms). Real's CPR layer enforces a
        -- hard 30s TOTAL cap: streaming with 46KB of live data still failed at 30.001s, and
        -- HttpService:RequestAsync is blacklisted there, so nothing in this file can raise it.
        ok, res = pcall(req, {
            Url = url,
            Method = "POST",
            Headers = merged,
            Body = body,
        })
        done = true
    end)
    -- os.clock() is CPU time, not wall time, so it barely advances while task.wait() sleeps
    -- and the timeout below could never fire. tick() is the monotonic wall clock.
    local t0 = tick()
    while not done do
        if tick() - t0 > (timeout or 120) then
            return nil, "timeout"
        end
        if Agent.stopRequested then
            return nil, "stopped"
        end
        task.wait(0.1)
    end
    if not ok then
        return nil, tostring(res)
    end
    if type(res) ~= "table" then
        -- request() handed back something that is not a response table. Keep the real value
        -- in the message: nil, a boolean and a string each point at a different cause, and
        -- a bare "invalid HTTP response" says nothing about which one actually happened.
        local kind = type(res)
        local extra = ""
        if kind == "string" then
            extra = ": " .. U.truncate(res, 160)
        elseif kind ~= "nil" then
            extra = ": " .. U.truncate(tostring(res), 80)
        end
        return nil, ("invalid HTTP response (%s%s)"):format(kind, extra)
    end
    return res
end


