local function New(class, props, children)
    local inst = Instance.new(class)
    local parent
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then
                parent = v
            else
                inst[k] = v
            end
        end
    end
    if children then
        for _, ch in ipairs(children) do
            ch.Parent = inst
        end
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

