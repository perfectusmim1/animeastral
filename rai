function AI.parseRetry(data)
    local err = type(data) == "table" and data.error or nil
    if type(err) ~= "table" then
        return nil
    end
    if type(err.details) == "table" then
        for _, d in ipairs(err.details) do
            if type(d) == "table" and type(d.retryDelay) == "string" then
                local s = tonumber(d.retryDelay:match("([%d%.]+)"))
                if s then
                    return s
                end
            end
        end
    end
    if type(err.message) == "string" then
        local s = tonumber(err.message:match("retry in ([%d%.]+)"))
        if s then
            return s
        end
    end
    return nil
end

-- Reads a response header case-insensitively (executors return either a map or a
-- list of {Name, Value} entries depending on the implementation).
function AI.header(res, name)
    local headers = type(res) == "table" and res.Headers or nil
    if type(headers) ~= "table" then
        return nil
    end
    local want = tostring(name):lower()
    for k, v in pairs(headers) do
        if type(k) == "string" and k:lower() == want then
            return tostring(v)
        end
    end
    for _, pair in ipairs(headers) do
        if type(pair) == "table" then
            local n = pair.Name or pair.name or pair[1]
            local v = pair.Value or pair.value or pair[2]
            if type(n) == "string" and n:lower() == want then
                return tostring(v)
            end
        end
    end
    return nil
end

-- Seconds to wait before the next try: prefers the server's Retry-After /
-- X-RateLimit-Reset, then any delay in the message, then exponential backoff.
function AI.retryDelayFor(res, msg, attempts)
    local h = tonumber(AI.header(res, "Retry-After"))
    if h and h > 0 then
        return math.clamp(math.ceil(h), 1, 120)
    end
    local reset = tonumber(AI.header(res, "X-RateLimit-Reset"))
    if reset and reset > 0 then
        local delta = math.ceil(reset - os.time())
        if delta > 0 then
            return math.clamp(delta, 1, 120)
        end
    end
    return AI.parseOpenRouterRetry(msg) or math.min(2 ^ math.min(attempts, 4), 15)
end

-- Transport-level failure: the request never produced an HTTP response. This is not rate
-- limiting, so a fixed short wait is the right shape — but there is deliberately no attempt
-- cap. The common cause on executors is a hard client-side request timeout
-- (CPR ErrorCode=18: "Operation timed out after 30000 milliseconds"), which fires on slow
-- model turns rather than on a broken network, so giving up after N tries just killed runs
-- that would have succeeded on a retry. The wait is fixed because the failure mode is a
-- long-running turn, not a burst: backing off longer only wastes the user's time.
AI.CONN_RETRY = 3
AI.connFails = 0

function AI.connDelay()
    return AI.CONN_RETRY
end

-- Retry ladder for request timeouts. The executor kills any request that has not finished
-- in ~30s, and that timer is per request, so a turn the model needs 127s for fails the
-- same way no matter how often it is retried. Retrying alone therefore cannot fix a slow
-- model. Stepping the reasoning effort down can: the last rung drops reasoning entirely,
-- which this model accepts and which returns instantly. So a turn always has a faster mode
-- to fall back to and the loop is not an unbounded failure.
AI.TIMEOUT_LADDER = { "low", "minimal", false } -- false = reasoning excluded
AI.timeoutStep = 0

-- Applies rung `n` of the ladder. Returns the new effort label for the status line.
function AI.stepTimeoutLadder()
    local n = AI.timeoutStep
    if n >= #AI.TIMEOUT_LADDER then
        return nil
    end
    AI.timeoutStep = n + 1
    local target = AI.TIMEOUT_LADDER[n + 1]
    if target == false then
        AI.skipReasoning = true
        return "no reasoning"
    end
    AI.skipReasoning = false
    AI.orEffort = target
    return ("reasoning: %s"):format(target)
end

-- Recognises the executor's own request-timeout string so the message can name the real
-- cause instead of a generic transport failure.
function AI.timedOutText(res)
    if type(res) ~= "string" then
        return nil
    end
    local low = string.lower(res)
    if low:find("operation timed out", 1, true) or low:find("errorcode=18", 1, true)
        or low:find("timeout", 1, true) or low:find("timed out", 1, true) then
        return res
    end
    return nil
end

-- Zero-cost models: OpenRouter caps these at 20 req/min and 50 req/day unless the
-- account has ever bought >= 10 credits. Worth detecting so a 429 can be explained
-- instead of looking like a random provider failure.
AI.freeModels = {
    ["stealth/space-bunny-alpha"] = true,
}

function AI.isFreeModel(id)
    id = tostring(id or ""):lower()
    if id:find(":free", 1, true) then
        return true
    end
    for m in pairs(AI.freeModels) do
        if m:lower() == id then
            return true
        end
    end
    return false
end

function AI.isTransientProviderError(data, msg)
    local low = tostring(msg or ""):lower()
    local needles = {
        "provider_unavailable",
        "provider is overloaded",
        "network connection lost",
        "overloaded",
        "try again later",
        "temporarily",
        "service unavailable",
        "upstream error",
        "connection reset",
        "bad gateway",
        "gateway timeout",
    }
    for _, n in ipairs(needles) do
        if low:find(n, 1, true) then
            return true
        end
    end
    local err = type(data) == "table" and data.error or nil
    if type(err) == "table" then
        local code = tonumber(err.code)
        if code == 502 or code == 503 or code == 529 or code == 524 then
            return true
        end
        local meta = err.metadata
        if type(meta) == "table" and type(meta.error_type) == "string" then
            if meta.error_type:lower():find("unavailable", 1, true) then
                return true
            end
        end
    end
    return false
end

function AI.isContextOverflow(msg)
    local low = tostring(msg or ""):lower()
    local needles = {
        "maximum context length",
        "too many tokens",
        "context_length_exceeded",
        "context window",
        "token limit",
    }
    for _, n in ipairs(needles) do
        if low:find(n, 1, true) then
            return true
        end
    end
    if low:find("context", 1, true) then
        local quals = { "exceed", "too many", "full", "length", "limit" }
        for _, q in ipairs(quals) do
            if low:find(q, 1, true) then
                return true
            end
        end
    end
    return false
end

function AI.nextModel()
    for i, m in ipairs(AI.fallbacks) do
        if m == AI.model then
            local nxt = AI.fallbacks[i + 1]
            if nxt then
                AI.model = nxt
            end
            return nxt
        end
    end
    AI.model = AI.fallbacks[1]
    return AI.model
end

function AI.generateGemini(body)
    local okJ, payload = pcall(function()
        return HttpService:JSONEncode(body)
    end)
    if not okJ then
        return nil, "JSON encode error: " .. tostring(payload)
    end
    local attempts, waits, switches = 0, 0, 0
    while true do
        if Agent.stopRequested then
            return nil, "Stopped"
        end
        local key, info = Keys.acquire()
        if not key then
            if info == "dead" then
                return nil, "No usable API key — all invalid/unauthorized. Add a new Gemini key."
            end
            waits += 1
            if waits > 8 then
                return nil, "All API keys are over quota/rate limit. Wait a bit and retry, or add a new key."
            end
            local waitFor = math.clamp(math.ceil(info), 1, 90)
            for s = waitFor, 1, -1 do
                if Agent.stopRequested then
                    return nil, "Stopped"
                end
                UI.setStatus(("All keys rate-limited · waiting %d s"):format(s), "warn")
                UI.refreshKeyStatus()
                task.wait(1)
            end
        else
            attempts += 1
            local url = AI.base .. AI.model .. ":generateContent?key=" .. HttpService:UrlEncode(key.key)
            local res, err = Http.post(url, payload, 180)
            if Agent.stopRequested then
                return nil, "Stopped"
            end
            if not res then
                key.fails += 1
                AI.connFails += 1
                local wait = AI.connDelay()
                local slow = AI.timedOutText(res)
                if slow then
                    UI.setStatus(("Request timed out (%d tries) · retrying in %ds"):format(AI.connFails, wait), "warn")
                else
                    UI.setStatus(("Connection issue (%s) · retry %d in %ds"):format(
                        tostring(err), AI.connFails, wait), "warn")
                end
                task.wait(wait)
            else
                local code = tonumber(res.StatusCode) or 0
                local okD, data = pcall(function()
                    return HttpService:JSONDecode(res.Body or "")
                end)
                if not okD then
                    data = nil
                end
                if code >= 200 and code < 300 and type(data) == "table" then
                    key.uses += 1
                    AI.connFails = 0
                    UI.refreshKeyStatus()
                    return data
                end
                local msg = (type(data) == "table" and type(data.error) == "table" and data.error.message)
                    or tostring(res.Body or res.StatusMessage or "")
                msg = U.truncate(tostring(msg), 400)
                if code == 429 then
                    local daily = msg:find("PerDay", 1, true) or msg:lower():find("per day", 1, true)
                    local delay = AI.parseRetry(data) or 30
                    key.cooldown = os.clock() + (daily and 3600 or delay)
                    key.lastError = daily and "daily quota" or "limit"
                    UI.setStatus(("Key %s rate-limited · switching to another key"):format(Keys.mask(key.key)), "warn")
                elseif code == 400 and (msg:find("API key not valid", 1, true) or msg:find("API_KEY_INVALID", 1, true) or msg:find("expired", 1, true)) then
                    key.dead = true
                    key.lastError = "invalid key"
                    UI.setStatus("Skipped invalid key: " .. Keys.mask(key.key), "warn")
                elseif code == 401 or code == 403 then
                    key.dead = true
                    key.lastError = "unauthorized (" .. code .. ")"
                    UI.setStatus("Skipped unauthorized key: " .. Keys.mask(key.key), "warn")
                elseif code == 404 then
                    switches += 1
                    local nxt = switches <= 3 and AI.nextModel() or nil
                    if not nxt then
                        return nil, "Model not found: " .. msg
                    end
                    UI.setStatus("Model not found → " .. nxt, "warn")
                elseif code == 400 or code == 413 then
                    if AI.isContextOverflow(msg) then
                        return nil, "Context window exceeded by the provider. Start a new session."
                    end
                    local lowMsg = msg:lower()
                    if not AI.skipThinking and lowMsg:find("thinking", 1, true) then
                        AI.skipThinking = true
                        local okR, payload2 = pcall(function()
                            return HttpService:JSONEncode(Agent.buildBody())
                        end)
                        if okR then
                            payload = payload2
                        end
                        UI.setStatus("Thinking level not supported here · retrying without it", "warn")
                    else
                        return nil, "Gemini rejected the request (400): " .. msg
                    end
                elseif code == 0 or code == 408 or code >= 500 then
                    UI.setStatus(("Gemini busy (%d) · retrying"):format(code), "warn")
                    task.wait(math.min(1.5 * attempts, 10))
                else
                    return nil, ("HTTP %d: %s"):format(code, msg)
                end
                UI.refreshKeyStatus()
            end
        end
    end
end

