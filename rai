T.inspect_gui = function(a)
    local root, err = resolveArg(a.path or "PlayerGui")
    if not root then
        return err, "not found"
    end
    local onlyVisible = a.only_visible ~= false
    local max = clampNum(a.max_items, 10, 400, 150)
    local withPos = a.with_positions == true
    local lines = {}
    local function isVisible(g)
        if g:IsA("LayerCollector") then
            return g.Enabled
        elseif g:IsA("GuiObject") then
            return g.Visible
        end
        return true
    end
    local function buttonConns(b)
        if not Env.getconnections then
            return ""
        end
        local n = 0
        for _, sig in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down" }) do
            local ok, c = pcall(function()
                return Env.getconnections(b[sig])
            end)
            if ok and type(c) == "table" then
                n += #c
            end
        end
        return " conns=" .. n
    end
    local function walk(inst, indent, depth)
        for _, k in ipairs(inst:GetChildren()) do
            if #lines >= max then
                return
            end
            local okV, vis = pcall(isVisible, k)
            local visible = okV and vis
            if k:IsA("GuiBase2d") then
                if visible or not onlyVisible then
                    local desc = k.Name .. " [" .. k.ClassName .. "]"
                    if k:IsA("TextLabel") or k:IsA("TextButton") or k:IsA("TextBox") then
                        local t = tostring(k.Text):gsub("%s+", " ")
                        if #t > 0 then
                            desc ..= ' "' .. t:sub(1, 50) .. '"'
                        end
                    end
                    if k:IsA("GuiButton") then
                        desc ..= " <btn" .. buttonConns(k) .. ">"
                    end
                    if withPos and k:IsA("GuiObject") then
                        local okP, pp = pcall(function()
                            return k.AbsolutePosition
                        end)
                        local okS, ss = pcall(function()
                            return k.AbsoluteSize
                        end)
                        if okP and okS then
                            desc ..= (" pos=%d,%d size=%dx%d"):format(pp.X, pp.Y, ss.X, ss.Y)
                        end
                    end
                    if not visible then
                        desc ..= " (hidden)"
                    end
                    lines[#lines + 1] = indent .. desc
                    if depth < 14 then
                        walk(k, indent .. "  ", depth + 1)
                    end
                end
            elseif k:IsA("LuaSourceContainer") then
                lines[#lines + 1] = indent .. k.Name .. " [" .. k.ClassName .. "]"
            end
        end
    end
    lines[1] = U.path(root)
    walk(root, "  ", 0)
    if #lines >= max then
        lines[#lines + 1] = "…(limit; provide a narrower path)"
    end
    return table.concat(lines, "\n"), (#lines - 1) .. " items"
end

T.list_scripts = function(a)
    local filter = argStr(a.filter)
    filter = filter and filter:lower()
    local max = clampNum(a.max_results, 10, 300, 150)
    local list = Scripts.collect(a.include_roblox == true)
    local loaded, running = Scripts.statusMaps()
    local rows = {}
    for _, s in ipairs(list) do
        local p = U.path(s)
        if not filter or p:lower():find(filter, 1, true) then
            local tag = s.ClassName == "ModuleScript" and "M" or (s.ClassName == "LocalScript" and "L" or "S")
            local flags = {}
            if running[s] then
                flags[#flags + 1] = "running"
            end
            if loaded[s] then
                flags[#flags + 1] = "loaded"
            end
            rows[#rows + 1] = ("[%s] %s%s"):format(tag, p, #flags > 0 and ("  (" .. table.concat(flags, ",") .. ")") or "")
        end
    end
    table.sort(rows)
    local total = #rows
    if total > max then
        local cut = {}
        for i = 1, max do
            cut[i] = rows[i]
        end
        cut[#cut + 1] = ("… +%d (use a filter)"):format(total - max)
        rows = cut
    end
    return ("%d scripts ([L]=LocalScript [M]=ModuleScript [S]=client Script)\n"):format(total) .. table.concat(rows, "\n"), total .. " scripts"
end

T.decompile = function(a)
    local s, err = resolveArg(a.path)
    if not s then
        return err, "not found"
    end
    if not s:IsA("LuaSourceContainer") then
        return "ERROR: not a script (" .. s.ClassName .. ")", "not a script"
    end
    local src, derr = Scripts.decompile(s)
    if not src then
        local info = Scripts.closureInfo(s)
        if info then
            return ("decompile failed (%s). Constants instead:\n%s"):format(tostring(derr), Scripts.formatConstants(info)), "constants"
        end
        return "ERROR: " .. tostring(derr), "failed"
    end
    local lines = U.splitLines(src)
    local start = clampNum(a.start_line, 1, math.max(#lines, 1), 1)
    local maxLines = clampNum(a.max_lines, 20, 600, 300)
    local stop = math.min(#lines, start + maxLines - 1)
    local out, chars = {}, 0
    for i = start, stop do
        local line = lines[i]
        chars += #line + 1
        if chars > 16000 then
            stop = i - 1
            break
        end
        out[#out + 1] = line
    end
    local more = stop < #lines and (" | continued: start_line=" .. (stop + 1)) or ""
    local header = ("-- %s | lines %d-%d / %d%s\n"):format(U.short(U.path(s)), start, stop, #lines, more)
    return header .. table.concat(out, "\n"), ("%d lines"):format(#lines)
end

T.grep_scripts = function(a)
    local pattern = argStr(a.pattern)
    if not pattern then
        return "ERROR: pattern required", "error"
    end
    local needle = pattern:lower()
    local maxScripts = clampNum(a.max_scripts, 5, 150, 60)
    local maxResults = clampNum(a.max_results, 5, 120, 50)
    local offset = clampNum(a.offset, 0, 1000, 0)
    if a.use_index ~= false and Scripts.index then
        local keys = {}
        for p in pairs(Scripts.index) do
            keys[#keys + 1] = p
        end
        table.sort(keys)
        local found, skipped = {}, 0
        for _, p in ipairs(keys) do
            if #found >= maxResults or Agent.stopRequested then
                break
            end
            local lines = Scripts.index[p]
            if type(lines) == "table" then
                for ln, line in ipairs(lines) do
                    if line:lower():find(needle, 1, true) then
                        if skipped < offset then
                            skipped += 1
                        else
                            found[#found + 1] = ("%s:%d: %s"):format(U.short(p), ln, U.trim(line):sub(1, 180))
                            if #found >= maxResults then
                                break
                            end
                        end
                    end
                end
            end
        end
        return (('"%s": %d matches · index (%d scripts), offset %d\n'):format(pattern, #found, #keys, offset)) .. table.concat(found, "\n"), #found .. " matches"
    end
    maxResults += offset
    local list = Scripts.collect(false)
    local prio = {}
    for _, s in ipairs(list) do
        prio[s] = Scripts.priority(s)
    end
    table.sort(list, function(x, y)
        return prio[x] > prio[y]
    end)
    local results, scanned, failed = {}, 0, 0
    local t0 = os.clock()
    local useDecompile = Env.decompile ~= nil
    local total = math.min(#list, maxScripts)
    for _, s in ipairs(list) do
        if scanned >= maxScripts or #results >= maxResults or Agent.stopRequested or os.clock() - t0 > 60 then
            break
        end
        scanned += 1
        UI.setStatus(('Code search "%s" · %d/%d scripts'):format(pattern, scanned, total), "tool")
        local short = U.short(U.path(s))
        if useDecompile then
            local src = Scripts.decompile(s)
            if src then
                local ln = 0
                for line in (src .. "\n"):gmatch("(.-)\n") do
                    ln += 1
                    if line:lower():find(needle, 1, true) then
                        results[#results + 1] = ("%s:%d: %s"):format(short, ln, U.trim(line):sub(1, 180))
                        if #results >= maxResults then
                            break
                        end
                    end
                end
            else
                failed += 1
            end
        else
            local info = Scripts.closureInfo(s)
            if info then
                for _, str in ipairs(info.strings) do
                    if str:lower():find(needle, 1, true) then
                        results[#results + 1] = ("%s: const %s"):format(short, Ser.str(str:sub(1, 120)))
                        if #results >= maxResults then
                            break
                        end
                    end
                end
            else
                failed += 1
            end
        end
        task.wait()
    end
    local shown = {}
    for i = offset + 1, #results do
        shown[#shown + 1] = results[i]
    end
    local head = ('"%s": %d matches · %d/%d scripts scanned%s%s%s\n'):format(pattern, #shown, scanned, #list,
        failed > 0 and (" · " .. failed .. " unreadable") or "", useDecompile and "" or " · (no decompile: string constants only)",
        offset > 0 and (" · offset " .. offset) or "")
    return head .. table.concat(shown, "\n"), #shown .. " matches"
end

T.script_constants = function(a)
    local s, err = resolveArg(a.path)
    if not s then
        return err, "not found"
    end
    local info, e2 = Scripts.closureInfo(s)
    if info then
        return U.short(U.path(s)) .. "\n" .. Scripts.formatConstants(info), #info.strings .. " string"
    end
    local GSB = Env.getscriptbytecode
    if GSB == nil then
        local okG, v = pcall(function()
            return (genv ~= nil and genv.getscriptbytecode) or (_G ~= nil and _G.getscriptbytecode) or nil
        end)
        if okG then
            GSB = v
        end
    end
    if GSB then
        local okB, bc = pcall(GSB, s)
        if okB and type(bc) == "string" then
            local strs, seenS = {}, {}
            for run in bc:gmatch("[ -~][ -~][ -~][ -~]+") do
                if #strs >= 260 then
                    break
                end
                if #run <= 200 and not seenS[run] then
                    seenS[run] = true
                    strs[#strs + 1] = Ser.str(run)
                end
            end
            return ("%s (bytecode strings, getscriptclosure unavailable)\nStrings (%d): %s"):format(U.short(U.path(s)), #strs, table.concat(strs, " | ")), #strs .. " string"
        end
    end
    return "ERROR: " .. tostring(e2), "failed"
end

T.get_script_env = function(a)
    if not Env.getsenv then
        return "ERROR: executor does not support getsenv", "unsupported"
    end
    local s, err = resolveArg(a.path)
    if not s then
        return err, "not found"
    end
    local ok, env = pcall(Env.getsenv, s)
    if not ok or type(env) ~= "table" then
        return "ERROR: getsenv failed (script may not be running): " .. tostring(env), "failed"
    end
    local rows = {}
    for k, v in next, env do
        if #rows >= 160 then
            rows[#rows + 1] = "…"
            break
        end
        local desc
        if type(v) == "function" then
            local name, line = U.fnInfo(v)
            desc = ("function %s (line %s)"):format(name ~= "" and name or tostring(k), tostring(line))
        else
            desc = typeof(v) .. " " .. U.preview(v, 100)
        end
        rows[#rows + 1] = ("  %s: %s"):format(tostring(k), desc)
    end
    table.sort(rows)
    return U.short(U.path(s)) .. " env:\n" .. table.concat(rows, "\n"), #rows .. " variables"
end

function Tools.describe(v, maxDepth, out, indent, depth, budget)
    if #out >= budget then
        return
    end
    if type(v) ~= "table" then
        out[#out + 1] = indent .. U.show(v, 200)
        return
    end
    local n = 0
    for k, val in next, v do
        n += 1
        if n > 80 or #out >= budget then
            out[#out + 1] = indent .. "…"
            break
        end
        local key = tostring(k)
        if type(val) == "table" then
            local cnt = 0
            for _ in next, val do
                cnt += 1
                if cnt > 999 then
                    break
                end
            end
            out[#out + 1] = ("%s%s: table(%d)"):format(indent, key, cnt)
            if depth < maxDepth then
                Tools.describe(val, maxDepth, out, indent .. "  ", depth + 1, budget)
            end
        else
            out[#out + 1] = ("%s%s: %s"):format(indent, key, U.preview(val, 120))
        end
    end
end

T.inspect_module = function(a)
    local m, err = resolveArg(a.path)
    if not m then
        return err, "not found"
    end
    if not m:IsA("ModuleScript") then
        return "ERROR: not a ModuleScript (" .. m.ClassName .. ")", "error"
    end
    local loaded = Scripts.statusMaps()
    local wasLoaded = loaded[m]
    local done, ok, res = false, nil, nil
    task.spawn(function()
        ok, res = pcall(require, m)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < 6 do
        task.wait(0.05)
    end
    if not done then
        return "ERROR: require timed out (module is yielding)", "timeout"
    end
    if not ok then
        return "ERROR: require error: " .. tostring(res), "error"
    end
    local depth = clampNum(a.depth, 1, 3, 2)
    local out = { ("%s → %s%s"):format(U.short(U.path(m)), typeof(res),
        wasLoaded and "" or "  (NOTE: module was not loaded before, it is now required)") }
    Tools.describe(res, depth, out, "  ", 1, 420)
    return table.concat(out, "\n"), typeof(res)
end

T.gc_search = function(a)
    if not Env.getgc then
        return "ERROR: executor does not support getgc", "unsupported"
    end
    local mode = (argStr(a.mode) or "table_key"):lower()
    local q = argStr(a.query)
    if not q then
        return "ERROR: query required", "error"
    end
    local ql = q:lower()
    local max = clampNum(a.max_results, 1, 50, 15)
    local ok, gc = pcall(Env.getgc, mode ~= "function_name")
    if not ok or type(gc) ~= "table" then
        return "ERROR: getgc failed", "error"
    end
    local out, found = {}, 0
    for i, v in ipairs(gc) do
        if found >= max then
            break
        end
        local tv = type(v)
        if mode == "function_name" and tv == "function" then
            local name = U.fnInfo(v)
            if name ~= "" and name:lower():find(ql, 1, true) and (not Env.islclosure or Env.islclosure(v)) then
                found += 1
                local _, line, src = U.fnInfo(v)
                local scr = ""
                local okE, fenv = pcall(getfenv, v)
                if okE and type(fenv) == "table" then
                    local sc = rawget(fenv, "script")
                    if typeof(sc) == "Instance" then
                        scr = " script=" .. U.short(U.path(sc))
                    end
                end
                local ups = ""
                if Env.getupvalues then
                    local okU, u = pcall(Env.getupvalues, v)
                    if okU and type(u) == "table" then
                        local parts = {}
                        for k, uv in pairs(u) do
                            if #parts >= 6 then
                                break
                            end
                            parts[#parts + 1] = tostring(k) .. "=" .. U.preview(uv, 30)
                        end
                        ups = " upvalues{" .. table.concat(parts, ", ") .. "}"
                    end
                end
                local consts = ""
                if Env.getconstants then
                    local okK, cs = pcall(Env.getconstants, v)
                    if okK and type(cs) == "table" then
                        local strs = {}
                        for _, cv in pairs(cs) do
                            if type(cv) == "string" and #strs < 20 then
                                strs[#strs + 1] = cv:sub(1, 60)
                            end
                        end
                        if #strs > 0 then
                            consts = " consts[" .. table.concat(strs, ", ") .. "]"
                        end
                    end
                end
                out[#out + 1] = ("function %s (%s:%s)%s%s%s"):format(name, src, tostring(line), scr, ups, consts)
            end
        elseif mode ~= "function_name" and tv == "table" then
            local okR, val = pcall(rawget, v, q)
            if okR and val ~= nil then
                found += 1
                local keys, n = {}, 0
                for k, kv in next, v do
                    n += 1
                    if n <= 14 then
                        keys[#keys + 1] = tostring(k) .. "=" .. U.preview(kv, 40)
                    end
                    if n > 300 then
                        break
                    end
                end
                out[#out + 1] = ("table{%d keys} %s = %s | %s"):format(n, q, U.preview(val, 60), table.concat(keys, ", "))
            end
        end
        if i % 30000 == 0 then
            task.wait()
        end
    end
    if #out == 0 then
        return ("no results for '%s' (mode=%s, %d objects scanned)"):format(q, mode, #gc), "0 results"
    end
    return table.concat(out, "\n"), found .. " results"
end

T.get_connections = function(a)
    if not Env.getconnections then
        return "ERROR: executor does not support getconnections", "unsupported"
    end
    local inst, err = resolveArg(a.path)
    if not inst then
        return err, "not found"
    end
    local sigName = argStr(a.signal) or "MouseButton1Click"
    local okS, sig = pcall(function()
        return inst[sigName]
    end)
    if not okS or typeof(sig) ~= "RBXScriptSignal" then
        return ("ERROR: '%s' is not a signal on this instance"):format(sigName), "error"
    end
    local okC, conns = pcall(Env.getconnections, sig)
    if not okC or type(conns) ~= "table" then
        return "ERROR: getconnections failed", "error"
    end
    local out = { ("%s.%s → %d connections"):format(U.short(U.path(inst)), sigName, #conns) }
    for i, c in ipairs(conns) do
        if i > 25 then
            out[#out + 1] = "…"
            break
        end
        local fn
        pcall(function()
            fn = c.Function
        end)
        if type(fn) == "function" then
            local name, line, src = U.fnInfo(fn)
            local scr = src
            local okE, fenv = pcall(getfenv, fn)
            if okE and type(fenv) == "table" then
                local sc = rawget(fenv, "script")
                if typeof(sc) == "Instance" then
                    scr = U.short(U.path(sc))
                end
            end
            local consts = ""
            if Env.getconstants then
                local okK, cs = pcall(Env.getconstants, fn)
                if okK and type(cs) == "table" then
                    local strs = {}
                    for _, cv in pairs(cs) do
                        if type(cv) == "string" and #strs < 14 then
                            strs[#strs + 1] = cv
                        end
                    end
                    if #strs > 0 then
                        consts = " consts[" .. table.concat(strs, ", ") .. "]"
                    end
                end
            end
            out[#out + 1] = ("#%d %s (line %s) in %s%s"):format(i, name ~= "" and name or "anonymous", tostring(line), scr, consts)
        else
            out[#out + 1] = ("#%d [C/engine connection]"):format(i)
        end
    end
    return table.concat(out, "\n"), #conns .. " connections"
end

T.get_nil_instances = function(a)
    if not Env.getnilinstances then
        return "ERROR: executor does not support getnilinstances", "unsupported"
    end
    local filter = argStr(a.filter)
    filter = filter and filter:lower()
    local ok, list = pcall(Env.getnilinstances)
    if not ok or type(list) ~= "table" then
        return "ERROR: getnilinstances failed", "error"
    end
    local rows = {}
    for _, v in ipairs(list) do
        if typeof(v) == "Instance" then
            local label = v.Name .. " " .. v.ClassName
            if not filter or label:lower():find(filter, 1, true) then
                rows[#rows + 1] = ('getnil("%s", "%s")  children=%d'):format(v.Name, v.ClassName, #v:GetChildren())
                if #rows >= 150 then
                    rows[#rows + 1] = "…"
                    break
                end
            end
        end
    end
    return ("%d nil instances (total %d)\n"):format(#rows, #list) .. table.concat(rows, "\n"), #rows .. " items"
end

T.find_remotes = function(a)
    local filter = argStr(a.filter)
    filter = filter and filter:lower()
    local roots
    if argStr(a.root) then
        local r, err = resolveArg(a.root)
        if not r then
            return err, "not found"
        end
        roots = { r }
    else
        roots = { ReplicatedStorage, ReplicatedFirst, Workspace, LocalPlayer, StarterGui, StarterPlayer, Lighting }
    end
    local SHORT = { RemoteEvent = "RE", RemoteFunction = "RF", UnreliableRemoteEvent = "URE", BindableEvent = "BE", BindableFunction = "BF" }
    local rows, seen = {}, {}
    local function consider(d)
        local tag = SHORT[d.ClassName]
        if not tag or seen[d] then
            return
        end
        seen[d] = true
        local p = U.path(d)
        if not filter or p:lower():find(filter, 1, true) then
            local o, n = Spy.counts["out|" .. p] or 0, Spy.counts["in|" .. p] or 0
            rows[#rows + 1] = ("[%s] %s%s"):format(tag, p, (o + n > 0) and ("  (spy: out %d, in %d)"):format(o, n) or "")
        end
    end
    for _, r in ipairs(roots) do
        if r then
            local ok, desc = pcall(function()
                return r:GetDescendants()
            end)
            if ok then
                for i, d in ipairs(desc) do
                    consider(d)
                    if i % 25000 == 0 then
                        task.wait()
                    end
                end
            end
        end
    end
    if not argStr(a.root) and Env.getnilinstances then
        pcall(function()
            for _, d in ipairs(Env.getnilinstances()) do
                if typeof(d) == "Instance" then
                    consider(d)
                end
            end
        end)
    end
    table.sort(rows)
    local total = #rows
    if total > 250 then
        local cut = {}
        for i = 1, 250 do
            cut[i] = rows[i]
        end
        cut[#cut + 1] = ("… +%d (use a filter)"):format(total - 250)
        rows = cut
    end
    return ("%d remotes/bindables\n"):format(total) .. table.concat(rows, "\n"), total .. " remotes"
end

T.remote_spy = function(a)
    local action = (argStr(a.action) or "summary"):lower()
    if not Spy.hooked then
        local ok, err = Spy.install()
        if not ok then
            return "ERROR: could not install RemoteSpy: " .. tostring(err), "unsupported"
        end
    end
    if Spy.setMethods then
        local mraw = argStr(a.methods)
        if mraw then
            local arr = {}
            for m in mraw:gmatch("[^,]+") do
                m = U.trim(m)
                if m ~= "" then
                    arr[#arr + 1] = m
                end
            end
            pcall(Spy.setMethods, (#arr > 0) and arr or nil)
        else
            pcall(Spy.setMethods, nil)
        end
    end
    if action == "clear" then
        Spy.clear()
        return "RemoteSpy logs cleared.", "cleared"
    end
    local filter = argStr(a.filter)
    filter = filter and filter:lower()
    local dir = (argStr(a.direction) or "all"):lower()
    local function pass(e)
        if dir ~= "all" and e.direction ~= dir then
            return false
        end
        if filter and not (e.path:lower():find(filter, 1, true) or e.name:lower():find(filter, 1, true)) then
            return false
        end
        return true
    end
    if action == "summary" then
        local groups, order = {}, {}
        for _, e in ipairs(Spy.logs) do
            if pass(e) then
                local key = e.direction .. "|" .. e.path .. "|" .. e.method
                local g = groups[key]
                if not g then
                    g = { e = e, n = 0 }
                    groups[key] = g
                    order[#order + 1] = g
                end
                g.n += 1
                g.e = e
            end
        end
        table.sort(order, function(x, y)
            return x.n > y.n
        end)
        local L = { ("RemoteSpy summary: %d logs, %d unique remotes (within %.0f s)"):format(#Spy.logs, #order, os.clock() - Spy.startTime) }
        if Spy.seenLine then
            local okS, sl = pcall(Spy.seenLine)
            if okS and type(sl) == "string" then
                table.insert(L, 1, sl)
            end
        end
        for i, g in ipairs(order) do
            if i > 40 then
                L[#L + 1] = "…"
                break
            end
            local e = g.e
            local caller = ""
            if e.caller then
                local ok, p = pcall(U.path, e.caller)
                if ok then
                    caller = " caller=" .. U.short(p)
                end
            end
            L[#L + 1] = ("%s ×%d %s%s\n   last: %s"):format(e.direction == "in" and "IN " or (e.direction == "call" and "CALL" or "OUT"), g.n, U.short(e.path), caller,
                e.direction == "in" and ("OnClientEvent(" .. Spy.argsCode(e) .. ")") or (e.path .. ":" .. e.method .. "(" .. Spy.argsCode(e) .. ")"))
        end
        if #order == 0 then
            L[#L + 1] = "No logs yet. Interact in the game first (use the observe tool)."
        end
        return table.concat(L, "\n"), #order .. " remotes"
    end
    local limit = clampNum(a.limit, 1, 80, 25)
    local out = {}
    for i = #Spy.logs, 1, -1 do
        local e = Spy.logs[i]
        if pass(e) then
            table.insert(out, 1, Spy.format(e))
            if #out >= limit then
                break
            end
        end
    end
    local head = ("RemoteSpy: %d logs total, showing %d (chronological)\n"):format(#Spy.logs, #out)
    return head .. table.concat(out, "\n"), #out .. " logs"
end

T.observe = function(a)
    local secs = clampNum(a.seconds, 2, 20, 8)
    local hint = argStr(a.hint)
    if not Spy.hooked then
        Spy.install()
    end
    local getters = nil
    if type(a.watch) == "table" and #a.watch > 0 then
        if not Env.loadstring then
            return "ERROR: watch needs loadstring (unsupported executor)", "unsupported"
        end
        getters = {}
        for _, expr in ipairs(a.watch) do
            if #getters >= 8 then
                break
            end
            if type(expr) == "string" and expr ~= "" then
                local fn = Env.loadstring("return (" .. expr .. ")", "=observe_watch")
                if fn then
                    local ok, v = pcall(fn)
                    getters[#getters + 1] = { expr = expr, fn = fn, prev = ok and U.preview(v, 120) or "?" }
                end
            end
        end
        if #getters == 0 then
            return "ERROR: no valid watch expressions", "error"
        end
    end
    local startSeq = Spy.seq
    UI.addNotice(("Observing: watching remote traffic for %d s%s"):format(secs, hint and (" — " .. hint) or ""))
    local t0 = os.clock()
    local events = {}
    while os.clock() - t0 < secs do
        if Agent.stopRequested then
            break
        end
        UI.setStatus(("Observing · %d s left%s"):format(math.ceil(secs - (os.clock() - t0)), hint and (" · " .. hint) or ""), "tool")
        task.wait(0.25)
        if getters then
            for _, g in ipairs(getters) do
                local ok, v = pcall(g.fn)
                if ok then
                    local s = U.preview(v, 120)
                    if s ~= g.prev then
                        g.prev = s
                        events[#events + 1] = { t = os.clock() - t0, s = ("t+%.1fs value %s = %s"):format(os.clock() - t0, g.expr, s) }
                    end
                end
            end
        end
    end
    local list = Spy.since(startSeq)
    if not getters then
        local out = {}
        for i, e in ipairs(list) do
            if i > 40 then
                out[#out + 1] = ("… +%d"):format(#list - 40)
                break
            end
            out[#out + 1] = Spy.format(e)
        end
        if #out == 0 then
            return ("no remote calls captured within %d s."):format(secs), "0 calls"
        end
        return ("%d s, %d calls:\n"):format(secs, #list) .. table.concat(out, "\n"), #list .. " calls"
    end
    for _, e in ipairs(list) do
        events[#events + 1] = { t = math.max(0, e.t - t0), s = ("t+%.1fs %s"):format(math.max(0, e.t - t0), Spy.format(e)) }
    end
    table.sort(events, function(x, y)
        return x.t < y.t
    end)
    local out = {}
    for i, ev in ipairs(events) do
        if i > 60 then
            out[#out + 1] = ("… +%d"):format(#events - 60)
            break
        end
        out[#out + 1] = ev.s
    end
    if #out == 0 then
        return ("no remote calls or value changes within %d s."):format(secs), "0 events"
    end
    return ("%d s, %d calls + value changes:\n"):format(secs, #list) .. table.concat(out, "\n"), #events .. " events"
end

local function gfn(name)
    if Env[name] ~= nil then
        return Env[name]
    end
    local ok, v = pcall(function()
        return (genv ~= nil and genv[name]) or (_G ~= nil and _G[name]) or nil
    end)
    if ok then
        return v
    end
    return nil
end

local CSpy = { items = {}, nextId = 0 }
local LogRing = { items = {}, connected = false }

T.watch_value = function(a)
    if not Env.loadstring then
        return "ERROR: executor does not support loadstring", "unsupported"
    end
    local expr = argStr(a.expression)
    if not expr then
        return "ERROR: expression required", "error"
    end
    local secs = clampNum(a.seconds, 1, 30, 5)
    local iv = tonumber(a.interval) or 0.5
    if iv < 0.2 then
        iv = 0.2
    elseif iv > 5 then
        iv = 5
    end
    local getter, gerr = Env.loadstring("return (" .. expr .. ")", "=watch_value")
    if not getter then
        return "SyntaxError: " .. tostring(gerr), "syntax error"
    end
    local function read()
        local ok, v = pcall(getter)
        if not ok then
            return false, tostring(v)
        end
        return true, U.preview(v, 120)
    end
    local ok0, cur = read()
    if not ok0 then
        return "ERROR: expression failed: " .. tostring(cur), "error"
    end
    local t0 = os.clock()
    local L = { ("t+0.0s %s"):format(cur) }
    local prev = cur
    while os.clock() - t0 < secs do
        if Agent.stopRequested then
            break
        end
        task.wait(iv)
        local ok, s = read()
        if ok and s ~= prev then
            prev = s
            L[#L + 1] = ("t+%.1fs %s"):format(os.clock() - t0, s)
            if #L >= 60 then
                L[#L + 1] = "…(change limit)"
                break
            end
        end
    end
    L[#L + 1] = "final = " .. prev
    return table.concat(L, "\n"), #L .. " lines"
end

T.fire_remote = function(a)
    local path = argStr(a.path)
    if not path then
        return "ERROR: path required", "error"
    end
    local inst, err = resolveArg(path)
    if not inst then
        return err, "not found"
    end
    local cls = inst.ClassName
    if cls == "BindableEvent" or cls == "BindableFunction" then
        return "ERROR: refusing to fire Bindable (" .. cls .. "); Bindables are same-machine only, not FireServer/InvokeServer targets", "error"
    end
    local method = nil
    if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
        method = "FireServer"
    elseif cls == "RemoteFunction" then
        method = "InvokeServer"
    else
        return "ERROR: not a remote (" .. cls .. ")", "error"
    end
    local rawArgs = type(a.args) == "table" and a.args or {}
    local n = #rawArgs
    if n > 20 then
        return "ERROR: too many args (max 20)", "error"
    end
    local enc = {}
    for i = 1, n do
        local v = rawArgs[i]
        if type(v) == "table" then
            local ipath = rawget(v, "__instance")
            local vec = rawget(v, "__vector3")
            if type(ipath) == "string" then
                local ri, re = U.resolve(ipath)
                if not ri then
                    return "ERROR: args[" .. i .. "] bad __instance: " .. tostring(re), "error"
                end
                enc[i] = ri
            elseif type(vec) == "table" then
                local x, y, z = tonumber(vec.x), tonumber(vec.y), tonumber(vec.z)
                if not (x and y and z) then
                    return "ERROR: args[" .. i .. "] bad __vector3 (need x,y,z numbers)", "error"
                end
                local okV, vv = pcall(function()
                    return Vector3.new(x, y, z)
                end)
                if not okV then
                    return "ERROR: args[" .. i .. "] bad __vector3: " .. tostring(vv), "error"
                end
                enc[i] = vv
            else
                enc[i] = v
            end
        else
            enc[i] = v
        end
    end
    if method == "FireServer" then
        local ok, e = pcall(function()
            inst:FireServer(table.unpack(enc, 1, n))
        end)
        if not ok then
            return "ERROR: FireServer failed: " .. tostring(e), "error"
        end
        return ("OK: %s:FireServer(%d args)"):format(U.short(U.path(inst)), n), "OK"
    end
    local rets = table.pack(pcall(function()
        return inst:InvokeServer(table.unpack(enc, 1, n))
    end))
    if not rets[1] then
        return "ERROR: InvokeServer failed: " .. tostring(rets[2]), "error"
    end
    local parts = {}
    for i = 2, rets.n do
        parts[#parts + 1] = U.preview(rets[i], 200)
    end
    return ("OK: %s:InvokeServer(%d args) returned: %s"):format(U.short(U.path(inst)), n, table.concat(parts, ", ")), "OK"
end

T.spy_closure = function(a)
    local action = (argStr(a.action) or "logs"):lower()
    local limit = clampNum(a.limit, 1, 50, 25)
    local function pickSpy()
        local id = tonumber(a.id)
        if id and CSpy.items[id] then
            return CSpy.items[id]
        end
        local lab = argStr(a.label)
        if lab then
            for _, e in pairs(CSpy.items) do
                if e.label == lab then
                    return e
                end
            end
        end
        local best = nil
        for _, e in pairs(CSpy.items) do
            if not best or e.id > best.id then
                best = e
            end
        end
        return best
    end
    if action == "logs" then
        local e = pickSpy()
        if not e then
            return "ERROR: no closure spies running (start one first)", "error"
        end
        local t = e.logs
        local L = { ("spy #%d '%s' · %d calls"):format(e.id, e.label, e.ncalls) }
        for i = math.max(1, #t - limit + 1), #t do
            L[#L + 1] = t[i]
        end
        if #t == 0 then
            L[#L + 1] = "No calls yet. Trigger the function in-game first."
        end
        return table.concat(L, "\n"), e.ncalls .. " calls"
    end
    if action == "stop" then
        local e = pickSpy()
        if not e then
            return "ERROR: no closure spies running", "error"
        end
        local HF = gfn("hookfunction")
        if HF then
            pcall(HF, e.fn, e.orig)
        end
        CSpy.items[e.id] = nil
        return ("spy #%d '%s' stopped (%d calls logged)"):format(e.id, e.label, e.ncalls), "stopped"
    end
    if action ~= "start" then
        return "ERROR: action must be start, logs or stop", "error"
    end
    local HF = gfn("hookfunction")
    if not HF then
        return "ERROR: executor does not support hookfunction", "unsupported"
    end
    local target = argStr(a.target)
    if not target then
        return "ERROR: target required (gc:<name> | conn:<path>:<signal>:<index> | global:<dotted.path>)", "error"
    end
    local fn, how = nil, nil
    if target:sub(1, 3) == "gc:" then
        local sub = target:sub(4):lower()
        if sub == "" then
            return "ERROR: gc: needs a name substring", "error"
        end
        local GGC = gfn("getgc")
        if not GGC then
            return "ERROR: executor does not support getgc", "unsupported"
        end
        local okG, gc = pcall(GGC, false)
        if not okG or type(gc) ~= "table" then
            return "ERROR: getgc failed", "error"
        end
        for _, v in ipairs(gc) do
            if type(v) == "function" and (not Env.islclosure or Env.islclosure(v)) then
                local nm = U.fnInfo(v)
                if nm ~= "" and nm:lower():find(sub, 1, true) then
                    fn, how = v, "gc:" .. nm
                    break
                end
            end
        end
        if not fn then
            return "ERROR: no function matching gc:" .. sub, "not found"
        end
    elseif target:sub(1, 5) == "conn:" then
        local ppath, sig, idx = target:sub(6):match("^(.*):([^:]+):([^:]+)$")
        idx = tonumber(idx)
        if not (ppath and sig and idx) then
            return "ERROR: conn: needs <instance-path>:<signal>:<index>", "error"
        end
        local GC = gfn("getconnections")
        if not GC then
            return "ERROR: executor does not support getconnections", "unsupported"
        end
        local inst2, rerr = resolveArg(ppath)
        if not inst2 then
            return rerr, "not found"
        end
        local okS, signal = pcall(function()
            return inst2[sig]
        end)
        if not okS or typeof(signal) ~= "RBXScriptSignal" then
            return ("ERROR: '%s' is not a signal on this instance"):format(sig), "error"
        end
        local okC, conns = pcall(GC, signal)
        if not okC or type(conns) ~= "table" or not conns[idx] then
            return "ERROR: connection not found (index out of range?)", "error"
        end
        pcall(function()
            fn = conns[idx].Function
        end)
        if type(fn) ~= "function" then
            return "ERROR: connection has no Lua function", "error"
        end
        how = "conn:" .. sig .. "#" .. idx
    elseif target:sub(1, 7) == "global:" then
        local dotted = target:sub(8)
        if dotted == "" then
            return "ERROR: global: needs a dotted path", "error"
        end
        if not Env.loadstring then
            return "ERROR: executor does not support loadstring", "unsupported"
        end
        local chunk, cerr = Env.loadstring("return (" .. dotted .. ")", "=spy_closure")
        if not chunk then
            return "SyntaxError: " .. tostring(cerr), "syntax error"
        end
        local okR, rv = pcall(chunk)
        if not okR or type(rv) ~= "function" then
            return "ERROR: global path did not resolve to a function", "error"
        end
        fn, how = rv, "global:" .. dotted
    else
        return "ERROR: target must start with gc:, conn: or global:", "error"
    end
    local label = argStr(a.label) or how
    CSpy.nextId += 1
    local id = CSpy.nextId
    local e = { id = id, label = label, fn = fn, orig = fn, logs = {}, ncalls = 0, t0 = os.clock() }
    CSpy.items[id] = e
    local NCC = gfn("newcclosure")
    local GCS = gfn("getcallingscript")
    local wrapper = function(...)
        local args = table.pack(...)
        local caller = nil
        if GCS then
            local okC, c = pcall(GCS)
            if okC then
                caller = c
            end
        end
        local t = os.clock()
        local rets = table.pack(e.orig(...))
        local n, cs, r1 = args.n, caller, rets[1]
        task.defer(function()
            local ap = {}
            for i = 1, math.min(n, 8) do
                local okS, s = pcall(U.preview, args[i], 120)
                ap[i] = "#" .. i .. "=" .. (okS and s or "?")
            end
            local callerS = ""
            pcall(function()
                if typeof(cs) == "Instance" then
                    callerS = " caller=" .. U.short(U.path(cs))
                end
            end)
            local rp = ""
            local okR, rs = pcall(U.preview, r1, 120)
            if okR then
                rp = " -> " .. rs
            end
            e.ncalls += 1
            e.logs[#e.logs + 1] = ("[+%.1fs]%s args(%d): %s%s"):format(t - e.t0, callerS, n, table.concat(ap, " "), rp)
            if #e.logs > 50 then
                table.remove(e.logs, 1)
            end
        end)
        return table.unpack(rets, 1, rets.n)
    end
    local hook = (NCC and NCC(wrapper)) or wrapper
    local okH, herr = pcall(HF, fn, hook)
    if not okH then
        CSpy.items[id] = nil
        return "ERROR: hookfunction failed: " .. tostring(herr), "error"
    end
    return ("spy #%d started on '%s' (%s)"):format(id, label, how), "spy " .. id
end

T.console_output = function(a)
    local typ = (argStr(a.types) or "error"):lower()
    if typ ~= "error" and typ ~= "warn" and typ ~= "all" then
        typ = "error"
    end
    local limit = clampNum(a.limit, 1, 100, 30)
    local okS, LS = pcall(function()
        return game:GetService("LogService")
    end)
    if not okS or not LS then
        return "ERROR: executor does not support LogService", "unsupported"
    end
    if not LogRing.connected then
        local okC = pcall(function()
            LS.MessageOut:Connect(function(msg, mt)
                LogRing.items[#LogRing.items + 1] = { m = tostring(msg), t = tostring(mt), c = os.clock() }
                if #LogRing.items > 200 then
                    table.remove(LogRing.items, 1)
                end
            end)
        end)
        if okC then
            LogRing.connected = true
        else
            return "ERROR: could not connect to LogService.MessageOut", "unsupported"
        end
    end
    local L = {}
    local shown = 0
    for i = #LogRing.items, 1, -1 do
        local en = LogRing.items[i]
        local tl = en.t:lower()
        local keep = typ == "all" or (typ == "error" and tl:find("error", 1, true) ~= nil) or (typ == "warn" and tl:find("warn", 1, true) ~= nil)
        if keep then
            shown += 1
            L[#L + 1] = ("[%s] %s"):format(en.t, en.m:sub(1, 300))
            if shown >= limit then
                break
            end
        end
    end
    if shown == 0 then
        return "No console messages captured yet (only messages after the first call are recorded).", "0 messages"
    end
    return table.concat(L, "\n"), shown .. " messages"
end

T.anticheat_scan = function()
    local L = {}
    local GRT = gfn("getrawmetatable")
    local ISC = gfn("iscclosure")
    if not GRT then
        L[#L + 1] = "metatable check skipped: unsupported getrawmetatable"
    else
        for _, mm in ipairs({ "__namecall", "__index", "__newindex" }) do
            local ok, fn = pcall(function()
                local mt = GRT(game)
                return mt and rawget(mt, mm) or nil
            end)
            if ok and type(fn) == "function" then
                local isC = true
                if ISC then
                    local okC, r = pcall(ISC, fn)
                    if okC then
                        isC = r
                    end
                end
                if not isC then
                    local nm, ln, src = "?", "?", "?"
                    pcall(function()
                        nm, ln, src = U.fnInfo(fn)
                    end)
                    L[#L + 1] = ("HOOK? game metatable %s is a Lua closure (%s line %s in %s)"):format(mm, tostring(nm), tostring(ln), tostring(src))
                end
            end
        end
    end
    local GC = gfn("getconnections")
    if not GC then
        L[#L + 1] = "connection scan skipped: unsupported getconnections"
    else
        local GF = gfn("getfenv")
        local okR, RS = pcall(function()
            return game:GetService("RunService")
        end)
        if okR and RS then
            for _, sig in ipairs({ "Heartbeat", "RenderStepped", "Stepped" }) do
                pcall(function()
                    local conns = GC(RS[sig])
                    for _, c in ipairs(conns) do
                        local fn = nil
                        pcall(function()
                            fn = c.Function
                        end)
                        if type(fn) == "function" then
                            local nm, src = "", ""
                            pcall(function()
                                local n2, _, s2 = U.fnInfo(fn)
                                nm, src = n2, s2
                            end)
                            local scr = nil
                            if GF then
                                pcall(function()
                                    local fe = GF(fn)
                                    local sc = fe and rawget(fe, "script")
                                    if typeof(sc) == "Instance" then
                                        scr = U.short(U.path(sc))
                                    end
                                end)
                            end
                            if not scr and (src == nil or src == "" or src == "[C]") then
                                L[#L + 1] = ("SUSPICIOUS? RunService.%s connection with no source script (func %s)"):format(sig, tostring(nm) ~= "" and tostring(nm) or "anonymous")
                            end
                        end
                    end
                end)
            end
        end
    end
    if #L == 0 then
        return "no hooks detected", "clean"
    end
    return table.concat(L, "\n"), #L .. " findings"
end

T.index_scripts = function(a)
    local t0 = os.clock()
    if Scripts.index and not (a.refresh == true) then
        local n = 0
        for _ in pairs(Scripts.index) do
            n += 1
        end
        return ("index fresh: %d scripts (%.1fs ago, use refresh=true to rebuild)"):format(n, os.clock() - (Scripts.indexAt or t0)), n .. " scripts"
    end
    local filter = argStr(a.filter)
    filter = filter and filter:lower()
    local list = Scripts.collect(false)
    local lines, failed, scanned = {}, 0, 0
    for _, s in ipairs(list) do
        if Agent.stopRequested or os.clock() - t0 > 60 then
            break
        end
        local okP, p = pcall(U.path, s)
        if okP and (not filter or p:lower():find(filter, 1, true)) then
            scanned += 1
            UI.setStatus(("Indexing scripts · %d/%d"):format(scanned, #list), "tool")
            local src = Scripts.decompile(s)
            if src then
                lines[p] = U.splitLines(src)
            else
                failed += 1
            end
        end
        if scanned % 10 == 0 then
            task.wait()
        end
    end
    Scripts.index = lines
    Scripts.indexAt = os.clock()
    local n = 0
    for _ in pairs(lines) do
        n += 1
    end
    return ("indexed %d scripts (%d unreadable, %.1fs)"):format(n, failed, os.clock() - t0), n .. " scripts"
end

T.find_remote_callers = function(a)
    local name = argStr(a.remote)
    if not name then
        return "ERROR: remote required (name substring)", "error"
    end
    local needle = name:lower()
    local max = clampNum(a.max_results, 1, 120, 50)
    local out = {}
    local function check(p, lines)
        for ln, line in ipairs(lines) do
            local l = line:lower()
            if l:find(needle, 1, true) and (l:find("fireserver", 1, true) or l:find("invokeserver", 1, true) or l:find(":fire(", 1, true) or l:find(":invoke(", 1, true)) then
                out[#out + 1] = ("%s:%d: %s"):format(U.short(p), ln, U.trim(line):sub(1, 180))
                if #out >= max then
                    return true
                end
            end
        end
        return false
    end
    if Scripts.index then
        local keys = {}
        for p in pairs(Scripts.index) do
            keys[#keys + 1] = p
        end
        table.sort(keys)
        for _, p in ipairs(keys) do
            if check(p, Scripts.index[p]) then
                break
            end
        end
    else
        if Env.decompile == nil then
            return "ERROR: executor does not support decompile (run index_scripts on a supported executor first)", "unsupported"
        end
        local list = Scripts.collect(false)
        local t0 = os.clock()
        for _, s in ipairs(list) do
            if #out >= max or Agent.stopRequested or os.clock() - t0 > 60 then
                break
            end
            local src = Scripts.decompile(s)
            if src then
                if check(U.path(s), U.splitLines(src)) then
                    break
                end
            end
            task.wait()
        end
    end
    if #out == 0 then
        return ("no callers found for '%s'"):format(name), "0 callers"
    end
    return (("callers of '%s': %d\n"):format(name, #out)) .. table.concat(out, "\n"), #out .. " callers"
end

T.run_lua = function(a)
    local code = argStr(a.code)
    if not code then
        return "ERROR: code required", "error"
    end
    if not Env.loadstring then
        return "ERROR: executor does not support loadstring", "unsupported"
    end
    local fn, err = Env.loadstring(code, "=run_lua")
    if not fn then
        return "SyntaxError: " .. tostring(err), "syntax error"
    end
    local output = {}
    local function out(prefix, ...)
        local parts = {}
        for i = 1, select("#", ...) do
            local v = select(i, ...)
            parts[i] = type(v) == "string" and v or U.show(v, 600)
        end
        output[#output + 1] = prefix .. table.concat(parts, " ")
    end
    local baseEnv = genv
    if Env.getfenv then
        local okE, e = pcall(Env.getfenv, 0)
        if okE and type(e) == "table" then
            baseEnv = e
        end
    end
    local sandbox = setmetatable({
        print = function(...)
            out("", ...)
        end,
        warn = function(...)
            out("[warn] ", ...)
        end,
        getnil = U.getnil,
        pathof = U.path,
        ser = function(v)
            return Ser.value(v)
        end,
    }, { __index = baseEnv })
    if Env.setfenv then
        pcall(Env.setfenv, fn, sandbox)
    end
    local timeout = clampNum(a.timeout, 1, 20, 6)
    local done, results = false, nil
    local t0 = os.clock()
    local th = task.spawn(function()
        results = table.pack(xpcall(fn, function(e)
            return tostring(e)
        end))
        done = true
    end)
    while not done and os.clock() - t0 < timeout do
        task.wait(0.05)
    end
    local lines = {}
    if not done then
        pcall(task.cancel, th)
        lines[1] = ("TIMEOUT: did not finish within %d s (thread cancelled)"):format(timeout)
    elseif results[1] then
        lines[1] = ("OK (%.2f s)"):format(os.clock() - t0)
        if results.n > 1 then
            local rets = {}
            for i = 2, results.n do
                rets[#rets + 1] = U.show(results[i], 3000)
            end
            lines[#lines + 1] = "return: " .. table.concat(rets, ", ")
        end
    else
        lines[1] = "ERROR: " .. tostring(results[2])
    end
    if #output > 0 then
        lines[#lines + 1] = "output:\n" .. table.concat(output, "\n")
    end
    local summary = (not done and "timeout") or (results[1] and "OK" or "error")
    return U.truncate(table.concat(lines, "\n"), 8000), summary
end

T.write_script = function(a)
    local code = Draft.clean(a.code)
    if #U.trim(code) < 20 then
        return "ERROR: code is empty or too short", "empty"
    end
    Draft.code = code
    Draft.version += 1
    if argStr(a.title) then
        Draft.title = a.title
    end
    local report, ok = Draft.check()
    UI.onDraftUpdated()
    local lines = Draft.lineCount()
    return ("script.lua saved (v%d, %d lines, %d characters).\n%s"):format(Draft.version, lines, #code, report),
        ok and (lines .. " lines ✓") or "syntax error"
end

T.edit_script = function(a)
    if not Draft.code then
        return "ERROR: create a script with write_script first", "no script"
    end
    local find, rep = tostring(a.find or ""), tostring(a.replace or "")
    find = find:gsub("\r\n", "\n")
    rep = rep:gsub("\r\n", "\n")
    if find == "" then
        return "ERROR: 'find' cannot be empty", "error"
    end
    local code, count = Draft.code, 0
    if a.replace_all then
        local parts, i = {}, 1
        while true do
            local s, e = code:find(find, i, true)
            if not s then
                break
            end
            parts[#parts + 1] = code:sub(i, s - 1)
            parts[#parts + 1] = rep
            i = e + 1
            count += 1
        end
        parts[#parts + 1] = code:sub(i)
        code = table.concat(parts)
    else
        local s, e = code:find(find, 1, true)
        if s then
            code = code:sub(1, s - 1) .. rep .. code:sub(e + 1)
            count = 1
        end
    end
    if count == 0 then
        return "ERROR: 'find' text not found verbatim in script.lua. Check current lines with read_script (including indentation).", "not found"
    end
    Draft.code = code
    Draft.version += 1
    local report, ok = Draft.check()
    UI.onDraftUpdated()
    return ("%d change(s) applied (v%d, %d lines).\n%s"):format(count, Draft.version, Draft.lineCount(), report),
        ok and "edited ✓" or "syntax error"
end

T.read_script = function(a)
    if not Draft.code then
        return "No script.lua yet (create it with write_script).", "empty"
    end
    local lines = U.splitLines(Draft.code)
    local s = clampNum(a.start_line, 1, math.max(#lines, 1), 1)
    local e = clampNum(a.end_line, s, math.max(#lines, s), math.min(#lines, s + 199))
    if e - s > 400 then
        e = s + 400
    end
    local out = {}
    for i = s, e do
        out[#out + 1] = ("%4d| %s"):format(i, lines[i] or "")
    end
    return ("script.lua lines %d-%d / %d\n"):format(s, e, #lines) .. table.concat(out, "\n"), ("%d-%d"):format(s, e)
end

T.check_script = function()
    if not Draft.code then
        return "ERROR: no script.lua", "no script"
    end
    local report, ok = Draft.check()
    return report, ok and "OK ✓" or "has errors"
end

T.finish = function(a)
    if not Draft.code then
        return "ERROR: no script. Call write_script first.", "no script"
    end
    if not Draft.syntaxOk and Env.loadstring and Draft.finishRefusals < 2 then
        Draft.finishRefusals += 1
        return "ERROR: script.lua contains syntax errors. Fix it with edit_script first, then call finish.\n" .. Draft.lastReport, "fix first"
    end
    Draft.finish(a)
    return "Done. Script shown to the user (Copy / Execute / Save).", "ready"
end

