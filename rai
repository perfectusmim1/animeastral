--══════════════════════════════════════════════════════════════════════
-- SESSIONS (persisted agent sessions + workspace scripts)
-- All functions are pcall-guarded and degrade to no-op/false when the
-- executor lacks listfiles/delfile/readfile/writefile.
--══════════════════════════════════════════════════════════════════════
Sessions.dir = "ScriptCreator/sessions"
Sessions.scriptsDir = "ScriptCreator/scripts"
Sessions._maxIndex = 30
Sessions._maxBytes = 512000

function Sessions.ensure()
    if not (Env.makefolder and Env.isfolder) then
        return false
    end
    local ok = pcall(function()
        Store.ensureFolder(Store.folder)
        Store.ensureFolder(Sessions.dir)
    end)
    if not ok then
        return false
    end
    local ready = pcall(function()
        return Env.isfolder(Sessions.dir)
    end)
    return ready == true
end

local function _sessionIndex()
    if type(Store.data) ~= "table" then
        return {}
    end
    if type(Store.data.sessions) ~= "table" then
        Store.data.sessions = {}
    end
    return Store.data.sessions
end

local function _freshSessionId()
    local ok, t = pcall(os.time)
    local base = (ok and tonumber(t)) or 0
    local okR, r = pcall(math.random, 0, 9999)
    if not okR or type(r) ~= "number" then
        r = 0
    end
    return ("%d-%04d"):format(base, r)
end

local function _deepCopy(v, seen)
    local t = type(v)
    if t == "table" then
        seen = seen or {}
        if seen[v] then
            return seen[v]
        end
        local out = {}
        seen[v] = out
        for k, val in next, v do
            local ck = _deepCopy(k, seen)
            local cv = _deepCopy(val, seen)
            pcall(function()
                out[ck] = cv
            end)
        end
        return out
    elseif t == "string" or t == "number" or t == "boolean" or t == "nil" then
        return v
    end
    local ok, s = pcall(tostring, v)
    return ok and s or ""
end

local function _trimResults(history)
    if type(history) ~= "table" then
        return
    end
    for _, entry in ipairs(history) do
        if type(entry) == "table" and type(entry.parts) == "table" then
            for _, p in ipairs(entry.parts) do
                if type(p) == "table" and type(p.functionResponse) == "table" then
                    local resp = p.functionResponse.response
                    if type(resp) == "table" and type(resp.result) == "string" and #resp.result > 3000 then
                        resp.result = resp.result:sub(1, 3000) .. " [trimmed]"
                    end
                end
            end
        end
    end
end

function Sessions.list()
    local ok, out = pcall(function()
        local idx = _sessionIndex()
        local items = {}
        for _, e in ipairs(idx) do
            if type(e) == "table" and type(e.id) == "string" and e.id ~= "" then
                items[#items + 1] = e
            end
        end
        if Env.listfiles then
            local okL, files = pcall(Env.listfiles, Sessions.dir)
            if okL and type(files) == "table" then
                local present = {}
                for _, f in ipairs(files) do
                    if type(f) == "string" then
                        local base = f:gsub("\\", "/"):match("([^/]+)$") or f
                        local id = base:gsub("%.json$", "")
                        present[id] = true
                    end
                end
                local kept = {}
                for _, e in ipairs(items) do
                    if present[e.id] then
                        kept[#kept + 1] = e
                    end
                end
                items = kept
            end
        end
        table.sort(items, function(a, b)
            return (tonumber(a.updated) or 0) > (tonumber(b.updated) or 0)
        end)
        while #items > Sessions._maxIndex do
            table.remove(items)
        end
        return items
    end)
    if ok and type(out) == "table" then
        return out
    end
    return {}
end

function Sessions.saveCurrent()
    local ok, id = pcall(function()
        if not Env.writefile then
            return nil
        end
        if type(Agent) ~= "table" or type(Draft) ~= "table" then
            return nil
        end
        local sid = nil
        if type(Agent.currentSessionId) == "string" and Agent.currentSessionId ~= "" then
            sid = Agent.currentSessionId
        else
            sid = _freshSessionId()
            pcall(function()
                Agent.currentSessionId = sid
            end)
        end
        local histCopy = _deepCopy(Agent.history or {})
        if type(histCopy) ~= "table" then
            histCopy = {}
        end
        _trimResults(histCopy)
        local draftCopy = {
            code = type(Draft.code) == "string" and Draft.code or nil,
            version = tonumber(Draft.version) or 0,
            title = type(Draft.title) == "string" and Draft.title or nil,
            summary = type(Draft.summary) == "string" and Draft.summary or "",
            features = _deepCopy(type(Draft.features) == "table" and Draft.features or {}),
            finished = Draft.finished == true,
            syntaxOk = Draft.syntaxOk == true,
            finishRefusals = tonumber(Draft.finishRefusals) or 0,
            lastReport = type(Draft.lastReport) == "string" and Draft.lastReport or "",
        }
        local savedProvider = "gemini"
        pcall(function()
            if Agent.provider == "openrouter" then
                savedProvider = "openrouter"
            end
        end)
        local orModel, orEffort = nil, nil
        pcall(function()
            if type(AI) == "table" then
                if type(AI.orModel) == "string" then
                    orModel = AI.orModel
                end
                if type(AI.orEffort) == "string" then
                    orEffort = AI.orEffort
                end
            end
        end)
        local payload = {
            id = sid,
            history = histCopy,
            draft = draftCopy,
            provider = savedProvider,
            lib = type(Agent.lib) == "string" and Agent.lib or "rayfield",
            instruction = type(Agent.instruction) == "string" and Agent.instruction or "",
            step = tonumber(Agent.step) or 0,
            tokens = tonumber(Agent.tokens) or 0,
            ctxUsed = tonumber(Agent.ctxUsed) or 0,
            orModel = orModel,
            orEffort = orEffort,
        }
        local encoded = nil
        local okJ, first = pcall(function()
            return HttpService:JSONEncode(payload)
        end)
        if not okJ or type(first) ~= "string" then
            return nil
        end
        encoded = first
        local guard = 0
        while #encoded > Sessions._maxBytes and type(payload.history) == "table" and #payload.history > 9 and guard < 100 do
            guard += 1
            table.remove(payload.history, 2)
            local okE, re = pcall(function()
                return HttpService:JSONEncode(payload)
            end)
            if not okE or type(re) ~= "string" then
                return nil
            end
            encoded = re
        end
        if #encoded > Sessions._maxBytes then
            return nil
        end
        Sessions.ensure()
        local okW = pcall(function()
            Env.writefile(Sessions.dir .. "/" .. sid .. ".json", encoded)
        end)
        if not okW then
            return nil
        end
        local title = ""
        pcall(function()
            if type(Draft.title) == "string" and U.trim(Draft.title) ~= "" then
                title = Draft.title
            else
                title = U.gameName() .. " Script"
            end
        end)
        local model = DEFAULT_MODEL
        pcall(function()
            if savedProvider == "openrouter" and type(AI) == "table" and type(AI.orModel) == "string" then
                model = AI.orModel
            end
        end)
        local lines = 0
        pcall(function()
            lines = Draft.lineCount()
        end)
        local updated = 0
        pcall(function()
            updated = os.time()
        end)
        local entry = { id = sid, title = title, updated = updated, model = model, lines = tonumber(lines) or 0 }
        local idx = _sessionIndex()
        local found = false
        for i, e in ipairs(idx) do
            if type(e) == "table" and e.id == sid then
                idx[i] = entry
                found = true
                break
            end
        end
        if not found then
            idx[#idx + 1] = entry
        end
        table.sort(idx, function(a, b)
            local ta = (type(a) == "table" and tonumber(a.updated)) or 0
            local tb = (type(b) == "table" and tonumber(b.updated)) or 0
            return ta > tb
        end)
        while #idx > Sessions._maxIndex do
            table.remove(idx)
        end
        pcall(function()
            Store.save()
        end)
        return sid
    end)
    if ok and type(id) == "string" and id ~= "" then
        return id
    end
    return nil
end

function Sessions.load(id)
    local ok, good, msg = pcall(function()
        if type(id) ~= "string" or id == "" then
            return false, "Invalid session id"
        end
        if not Env.readfile then
            return false, "Filesystem unavailable"
        end
        local raw = nil
        local okR = pcall(function()
            raw = Env.readfile(Sessions.dir .. "/" .. id .. ".json")
        end)
        if not okR or type(raw) ~= "string" or raw == "" then
            return false, "Session file not found"
        end
        local okD, data = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not okD or type(data) ~= "table" then
            return false, "Session file is corrupt"
        end
        pcall(function()
            if type(data.history) == "table" then
                Agent.history = data.history
            else
                Agent.history = {}
            end
        end)
        pcall(function()
            if data.provider == "openrouter" or data.provider == "gemini" then
                if type(Keys) == "table" and type(Keys.useProvider) == "function" then
                    Keys.useProvider(data.provider)
                else
                    Agent.provider = data.provider
                end
            end
        end)
        pcall(function()
            if type(data.lib) == "string" and data.lib ~= "" then
                Agent.lib = data.lib
            end
            if type(data.instruction) == "string" then
                Agent.instruction = data.instruction
            end
            Agent.step = tonumber(data.step) or 0
            Agent.tokens = tonumber(data.tokens) or 0
            Agent.ctxUsed = tonumber(data.ctxUsed) or 0
            if type(AI) == "table" then
                if type(data.orModel) == "string" and data.orModel ~= "" then
                    AI.orModel = data.orModel
                end
                if type(data.orEffort) == "string" then
                    AI.orEffort = data.orEffort
                end
            end
        end)
        pcall(function()
            local d = type(data.draft) == "table" and data.draft or {}
            if type(Draft) == "table" and type(Draft.reset) == "function" then
                Draft.reset()
            end
            if type(d.code) == "string" then
                Draft.code = d.code
            else
                Draft.code = nil
            end
            Draft.version = tonumber(d.version) or 0
            Draft.title = type(d.title) == "string" and d.title or nil
            Draft.summary = type(d.summary) == "string" and d.summary or ""
            Draft.features = type(d.features) == "table" and d.features or {}
            Draft.finished = d.finished == true
            Draft.syntaxOk = d.syntaxOk == true
            Draft.finishRefusals = tonumber(d.finishRefusals) or 0
            Draft.lastReport = type(d.lastReport) == "string" and d.lastReport or ""
        end)
        pcall(function()
            Agent.currentSessionId = id
        end)
        local turns = 0
        local lines = 0
        pcall(function()
            turns = #(Agent.history or {})
        end)
        pcall(function()
            lines = Draft.lineCount()
        end)
        return true, ("%d turns, %d lines"):format(tonumber(turns) or 0, tonumber(lines) or 0)
    end)
    if ok and good == true then
        return true, tostring(msg or "")
    end
    if ok then
        return false, tostring(msg or "Load failed")
    end
    return false, "Load failed"
end

function Sessions.delete(id)
    local ok, res = pcall(function()
        if type(id) ~= "string" or id == "" then
            return false
        end
        pcall(function()
            if Env.delfile then
                Env.delfile(Sessions.dir .. "/" .. id .. ".json")
            end
        end)
        pcall(function()
            local idx = _sessionIndex()
            for i = #idx, 1, -1 do
                if type(idx[i]) == "table" and idx[i].id == id then
                    table.remove(idx, i)
                end
            end
            Store.save()
        end)
        pcall(function()
            if type(Agent) == "table" and Agent.currentSessionId == id then
                Sessions.newCurrent()
            end
        end)
        return true
    end)
    return ok and res == true
end

function Sessions.newCurrent(title)
    local ok, sid = pcall(function()
        local fresh = _freshSessionId()
        pcall(function()
            if type(Draft) == "table" and type(Draft.reset) == "function" then
                Draft.reset()
            end
        end)
        pcall(function()
            if type(title) == "string" and U.trim(title) ~= "" and type(Draft) == "table" then
                Draft.title = title
            end
        end)
        pcall(function()
            Agent.history = {}
            Agent.step = 0
            Agent.ctxUsed = 0
            Agent.tokens = 0
            Agent.stepCap = 200
            if type(title) == "string" then
                Agent.instruction = title
            else
                Agent.instruction = ""
            end
            if type(Agent.queue) == "table" then
                table.clear(Agent.queue)
            else
                Agent.queue = {}
            end
            Agent.session = false
            Agent.currentSessionId = fresh
        end)
        return fresh
    end)
    if ok and type(sid) == "string" and sid ~= "" then
        return sid
    end
    return nil
end

function Sessions.scripts()
    local ok, out = pcall(function()
        if not Env.listfiles then
            return {}
        end
        local okL, files = pcall(Env.listfiles, Sessions.scriptsDir)
        if not okL or type(files) ~= "table" then
            return {}
        end
        local names = {}
        for _, f in ipairs(files) do
            if type(f) == "string" and f:lower():sub(-4) == ".lua" then
                local base = f:gsub("\\", "/"):match("([^/]+)$") or f
                names[#names + 1] = base
            end
        end
        table.sort(names)
        return names
    end)
    if ok and type(out) == "table" then
        return out
    end
    return {}
end

function Sessions.readScript(name)
    local ok, code = pcall(function()
        if not Env.readfile then
            return nil
        end
        if type(name) ~= "string" or U.trim(name) == "" then
            return nil
        end
        local clean = U.trim(name):gsub("\\", "/")
        clean = clean:match("([^/]+)$") or clean
        if clean == "" or clean:find("%.%.", 1, true) then
            return nil
        end
        local raw = nil
        local okR = pcall(function()
            raw = Env.readfile(Sessions.scriptsDir .. "/" .. clean)
        end)
        if not okR or type(raw) ~= "string" or raw == "" then
            return nil
        end
        if #raw > 307200 then
            raw = raw:sub(1, 307200)
        end
        return raw
    end)
    if ok and type(code) == "string" and code ~= "" then
        return code
    end
    return nil
end

