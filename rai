function UI.toast(msg, kind)
    if UI.dead or not UI.win then
        return
    end
    if UI.lastToast then
        pcall(function()
            UI.lastToast:Destroy()
        end)
    end
    local err = kind == "error"
    local target = UDim2.new(0.5, 0, 1, -(UI.bottom.Visible and (BOTTOM_H + 10) or 18))
    local t = Text({ Text = tostring(msg), TextSize = 13, Font = FONT.medium, TextColor3 = err and C.white or C.black,
        BackgroundColor3 = err and Color3.fromRGB(127, 29, 29) or C.white, BackgroundTransparency = 1, TextTransparency = 1,
        TextWrapped = true, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(0, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -(UI.bottom.Visible and (BOTTOM_H + 10) or 18) - 10), TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 50, Parent = UI.win })
    New("UISizeConstraint", { MaxSize = Vector2.new(420, 200), Parent = t })
    Corner(14, t)
    Pad(t, 8, 14, 8, 14)
    UI.lastToast = t
    Tween(t, 0.18, { BackgroundTransparency = 0, TextTransparency = 0, Position = target })
    task.delay(2.6, function()
        if UI.dead then
            return
        end
        if t.Parent then
            Tween(t, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
            task.wait(0.22)
            if t.Parent then
                t:Destroy()
            end
        end
    end)
end

function UI.copyScript()
    if not Draft.code then
        return
    end
    if not Env.setclipboard then
        UI.toast("Executor doesn't support setclipboard — use Save", "error")
        return
    end
    local ok = pcall(Env.setclipboard, Draft.code)
    UI.toast(ok and "Script copied to clipboard" or "Copy failed", ok and nil or "error")
end

function UI.executeScript()
    if not Draft.code then
        return
    end
    if not Env.loadstring then
        UI.toast("Executor doesn't support loadstring", "error")
        return
    end
    local fn, err = Env.loadstring(Draft.code, "=ScriptCreator")
    if not fn then
        UI.toast("Syntax error: " .. tostring(err), "error")
        UI.input.Text = "Script has a syntax error: " .. tostring(err) .. " — fix it."
        UI.updateComposer()
        return
    end
    task.spawn(function()
        local ok, e = pcall(fn)
        if not ok and not UI.dead then
            UI.toast("Runtime error: " .. U.truncate(tostring(e), 160), "error")
            if not Agent.running then
                UI.input.Text = "Script errored at runtime: " .. U.truncate(tostring(e), 300) .. " — fix it."
                UI.updateComposer()
            end
        end
    end)
    UI.toast("Script executed")
end

function UI.saveScript()
    if not Draft.code then
        return
    end
    if not Env.writefile then
        UI.toast("Executor doesn't support writefile", "error")
        return
    end
    local path = ("ScriptCreator/scripts/%s_%d.lua"):format(U.fsName(U.gameName()), os.time())
    local ok = pcall(function()
        Store.ensureFolder("ScriptCreator")
        Store.ensureFolder("ScriptCreator/scripts")
        Env.writefile(path, Draft.code)
    end)
    UI.toast(ok and ("Saved: workspace/" .. path) or "Save failed", ok and nil or "error")
end

