local function P(t, desc)
    return { type = t, description = desc }
end

local function decl(name, desc, props, required)
    local d = { name = name, description = desc }
    if props then
        d.parameters = { type = "OBJECT", properties = props }
        if required and #required > 0 then
            d.parameters.required = required
        end
    end
    return d
end

