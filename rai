        end
    end)
    UI.conns[#UI.conns + 1] = UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- SHORTCUT
    UI.conns[#UI.conns + 1] = UserInputService.InputBegan:Connect(function(inp)
        if inp.KeyCode == Enum.KeyCode.RightControl then
            UI.setVisible(not UI.visible)
        end
    end)

    -- SCALE
    local function updateScale()
        local cam = Workspace.CurrentCamera
        if not cam then
            return
        end
        local vp = cam.ViewportSize
        local s = math.clamp(math.min(vp.X / (W + 40), vp.Y / (H + 40)), 0.5, 1)
        UI.scaleValue = s
        UI.scale.Scale = s
    end
    updateScale()
    if Workspace.CurrentCamera then
        UI.conns[#UI.conns + 1] = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    end

    -- ANIMATION LOOP
    local spin = 0
    UI.conns[#UI.conns + 1] = RunService.RenderStepped:Connect(function(dt)
        spin = (spin + dt * 420) % 360
        for g in pairs(UI.spinners) do
            g.Rotation = spin
        end
        if UI.shimmer then
            UI.shimmer.Visible = Agent.running
            if Agent.running then
                UI.shimmer.Position = UDim2.new(((os.clock() * 0.55) % 1.6) - 0.3, 0, 0, 0)
            end
        end
        if UI.miniSpin then
            UI.miniSpin.Visible = Agent.running
        end
    end)

    task.spawn(function()
        while not UI.dead do
            if UI.bottom.Visible then
                UI.renderStatus()
            end
            if UI.thinkLine and UI.thinkLine.label and UI.thinkLine.label.Parent then
                local el = os.clock() - UI.thinkLine.t0
                UI.thinkLine.secs = el
                UI.thinkLine.label.Text = el < 1 and "Thinking" or ("Thinking  ·  %ds"):format(math.floor(el))
            elseif UI.thinkLine then
                UI.thinkLine = nil
            end
            if UI.page == "setup" or Agent.running then
                UI.refreshKeyStatus()
            end
            task.wait(0.3)
        end
    end)
    UI.renderModelLabel()
end

