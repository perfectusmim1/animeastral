T.explore = function(a)
    local root, err = resolveArg(a.path or "game")
    if not root then
        return err, "not found"
    end
    local depth = clampNum(a.depth, 1, 4, 1)
    local maxChildren = clampNum(a.max_children, 5, 200, 60)
    local filter = argStr(a.class_filter)
    local lines, LIMIT = {}, 450
    local function describe(inst)
        local s = inst.Name .. " [" .. inst.ClassName .. "]"
        local ok, extra = pcall(function()
            if inst:IsA("ValueBase") then
                return " = " .. U.preview(inst.Value, 60)
            elseif inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                local t = inst.Text
                if t ~= "" then
                    return ' "' .. t:gsub("%s+", " "):sub(1, 40) .. '"'
                end
            elseif inst:IsA("ProximityPrompt") then
                return (' (Action="%s")'):format(inst.ActionText)
            end
            return ""
        end)
        if ok and extra then
            s ..= extra
        end
        local n = #inst:GetChildren()
        if n > 0 then
            s ..= " (" .. n .. ")"
        end
        return s
    end
    local function matches(k)
        if not filter then
            return true
        end
        local ok, r = pcall(function()
            return k:IsA(filter)
        end)
        return ok and r
    end
    local function walk(inst, d, indent)
        if #lines >= LIMIT then
            return
        end
        local kids = inst:GetChildren()
        local shown = 0
        for _, k in ipairs(kids) do
            if #lines >= LIMIT then
                break
            end
            if matches(k) then
                shown += 1
                if shown > maxChildren then
                    lines[#lines + 1] = indent .. ("… +%d more (increase max_children or use a filter)"):format(#kids - maxChildren)
                    break
                end
                lines[#lines + 1] = indent .. describe(k)
            end
            if d < depth then
                walk(k, d + 1, indent .. "  ")
            end
        end
    end
    lines[1] = U.path(root) .. "  [" .. root.ClassName .. "]"
    walk(root, 1, "  ")
    if #lines >= LIMIT then
        lines[#lines + 1] = "…(output limit; use a narrower path/filter)"
    end
    return table.concat(lines, "\n"), ("%d items"):format(#lines - 1)
end

T.get_properties = function(a)
    local inst, err = resolveArg(a.path)
    if not inst then
        return err, "not found"
    end
    local L = { U.path(inst) .. "  [" .. inst.ClassName .. "]" }
    local seen = {}
    for _, prop in ipairs(PROP_LIST) do
        if not seen[prop] then
            seen[prop] = true
            local ok, val = pcall(function()
                return inst[prop]
            end)
            if ok and val ~= nil then
                local tv = typeof(val)
                local isChild = tv == "Instance" and val.Parent == inst and val.Name == prop
                if not isChild and tv ~= "RBXScriptSignal" and tv ~= "function" then
                    L[#L + 1] = ("  %s = %s"):format(prop, U.preview(val, 140))
                end
            end
        end
    end
    local okA, attrs = pcall(function()
        return inst:GetAttributes()
    end)
    if okA and type(attrs) == "table" and next(attrs) then
        L[#L + 1] = "Attributes:"
        for k, v in pairs(attrs) do
            L[#L + 1] = ("  %s = %s"):format(k, U.preview(v, 100))
        end
    end
    local okT, tags = pcall(function()
        return CollectionService:GetTags(inst)
    end)
    if okT and type(tags) == "table" and #tags > 0 then
        L[#L + 1] = "Tags: " .. table.concat(tags, ", ")
    end
    L[#L + 1] = ("Children: %d | IsA: %s"):format(#inst:GetChildren(), isaChain(inst))
    if REMOTE_CLASS[inst.ClassName] then
        local p = U.path(inst)
        L[#L + 1] = ("RemoteSpy: out %d, in %d calls"):format(Spy.counts["out|" .. p] or 0, Spy.counts["in|" .. p] or 0)
    end
    pcall(function()
        local GHP = Env.gethiddenproperty
        if GHP == nil then
            local okG, v = pcall(function()
                return (genv ~= nil and genv.gethiddenproperty) or (_G ~= nil and _G.gethiddenproperty) or nil
            end)
            if okG then
                GHP = v
            end
        end
        if GHP then
            local hidden = { "SimulationRadius", "MaximumSimulationRadius", "CollisionGroupId", "RootPriority", "Mass", "Density", "Friction", "Elasticity", "CollisionGroup", "Shape", "FormFactor", "TopSurface", "BottomSurface", "Velocity", "RotVelocity", "DataCost", "RobloxLocked", "UniqueId", "SourceAssetId", "AttributesSerialize", "Sandboxed", "SelectionBehaviorUp", "SelectionBehaviorDown", "SelectionBehaviorLeft", "SelectionBehaviorRight", "IgnoreGuiInset", "AutoLocalize", "RootLocalizationTable", "StreamingMode", "LevelOfDetail", "RenderFidelity", "PhysicsData", "LocalTransparencyModifier" }
            local HL = {}
            for _, prop in ipairs(hidden) do
                if #HL >= 40 then
                    break
                end
                if not seen[prop] then
                    local ok, val = pcall(GHP, inst, prop)
                    if ok and val ~= nil then
                        HL[#HL + 1] = ("  %s = %s"):format(prop, U.preview(val, 100))
                    end
                end
            end
            if #HL > 0 then
                L[#L + 1] = "Hidden:"
                for _, h in ipairs(HL) do
                    L[#L + 1] = h
                end
            end
        end
    end)
    return table.concat(L, "\n"), (#L - 1) .. " lines"
end

T.search_instances = function(a)
    local q = argStr(a.query)
    q = q and q:lower()
    local cls = argStr(a.class_name)
    local tag = argStr(a.tag)
    local hasAttr = argStr(a.has_attr)
    local withPos = a.with_positions == true
    if not q and not cls and not tag and not hasAttr then
        return "ERROR: query, class_name, tag or has_attr required", "error"
    end
    local roots
    if argStr(a.root) then
        local r, err = resolveArg(a.root)
        if not r then
            return err, "not found"
        end
        roots = { r }
    else
        roots = searchRoots()
    end
    local exact = a.exact == true
    local max = clampNum(a.max_results, 1, 200, 50)
    local tagged = nil
    if tag then
        local okT, list2 = pcall(function()
            return CollectionService:GetTagged(tag)
        end)
        if not okT or type(list2) ~= "table" then
            return "ERROR: CollectionService:GetTagged failed", "error"
        end
        tagged = {}
        for _, v in ipairs(list2) do
            tagged[v] = true
        end
    end
    local results, scanned = {}, 0
    for _, r in ipairs(roots) do
        local ok, desc = pcall(function()
            return r:GetDescendants()
        end)
        if ok then
            for i, d in ipairs(desc) do
                scanned += 1
                local pass = true
                if q then
                    local nm = d.Name:lower()
                    if exact then
                        pass = nm == q
                    else
                        pass = nm:find(q, 1, true) ~= nil
                    end
                end
                if pass and cls then
                    local okI, isA = pcall(function()
                        return d:IsA(cls)
                    end)
                    pass = okI and isA
                end
                if pass and tagged and not tagged[d] then
                    pass = false
                end
                if pass and hasAttr then
                    local okA, av = pcall(function()
                        return d:GetAttribute(hasAttr)
                    end)
                    pass = okA and av ~= nil
                end
                if pass then
                    local row = U.path(d) .. "  [" .. d.ClassName .. "]"
                    if withPos then
                        local okP, pos = pcall(function()
                            if d:IsA("BasePart") then
                                return " pos=" .. tostring(d.Position)
                            elseif d:IsA("GuiObject") then
                                return " pos=" .. tostring(d.AbsolutePosition)
                            end
                            return nil
                        end)
                        if okP and pos then
                            row ..= pos
                        end
                    end
                    results[#results + 1] = row
                    if #results >= max then
                        break
                    end
                end
                if i % 20000 == 0 then
                    task.wait()
                end
            end
        end
        if #results >= max then
            break
        end
    end
    local head = ("%d results (%d instances scanned)%s\n"):format(#results, scanned, #results >= max and " — limit reached" or "")
    return head .. table.concat(results, "\n"), #results .. " results"
end

T.find_interactables = function(a)
    local root = Workspace
    if argStr(a.root) then
        local r, err = resolveArg(a.root)
        if not r then
            return err, "not found"
        end
        root = r
    end
    local maxGroups = clampNum(a.max_results, 5, 120, 40)
    local hrp = U.hrp()
    local char = LocalPlayer.Character
    local groups, order = {}, {}
    local function posOf(inst)
        local ok, pos = pcall(function()
            if inst:IsA("Attachment") then
                return inst.WorldPosition
            elseif inst:IsA("BasePart") then
                return inst.Position
            elseif inst:IsA("Model") then
                return inst:GetPivot().Position
            end
            return nil
        end)
        return ok and pos or nil
    end
    local desc = root:GetDescendants()
    for i, d in ipairs(desc) do
        local cls = d.ClassName
        local kind, target, extra = nil, nil, ""
        if cls == "ProximityPrompt" then
            kind, target = "ProximityPrompt", d.Parent
            extra = ('Action="%s" Object="%s" Hold=%s Key=%s MaxDist=%s Enabled=%s'):format(
                d.ActionText, d.ObjectText, Ser.num(d.HoldDuration), d.KeyboardKeyCode.Name, Ser.num(d.MaxActivationDistance), tostring(d.Enabled))
        elseif cls == "ClickDetector" then
            kind, target = "ClickDetector", d.Parent
            extra = "MaxDist=" .. Ser.num(d.MaxActivationDistance)
        elseif cls == "TouchTransmitter" then
            kind, target = "TouchInterest", d.Parent
        elseif cls == "Seat" or cls == "VehicleSeat" then
            kind, target = cls, d
        elseif cls == "Tool" then
            kind, target = "Tool", d:FindFirstChild("Handle") or d
        elseif cls == "Dialog" then
            kind, target = "Dialog", d.Parent
        end
        if kind and target and not (char and d:IsDescendantOf(char)) then
            local pos = posOf(target)
            local dist = (pos and hrp) and (pos - hrp.Position).Magnitude or math.huge
            local key = kind .. "|" .. target.Name
            local g = groups[key]
            if not g then
                g = { kind = kind, name = target.Name, count = 0, best = math.huge, path = "", extra = extra }
                groups[key] = g
                order[#order + 1] = g
            end
            g.count += 1
            if dist < g.best or g.path == "" then
                g.best = dist
                g.path = U.path(d)
                g.extra = extra
            end
        end
        if i % 20000 == 0 then
            task.wait()
        end
    end
    table.sort(order, function(x, y)
        return x.best < y.best
    end)
    local L = {}
    for i, g in ipairs(order) do
        if i > maxGroups then
            L[#L + 1] = ("… +%d more groups"):format(#order - maxGroups)
            break
        end
        L[#L + 1] = ("%s ×%d \"%s\" | nearest %s%s\n   %s"):format(
            g.kind, g.count, g.name, g.best == math.huge and "?" or (Ser.num(math.floor(g.best)) .. " studs"),
            g.extra ~= "" and (" | " .. g.extra) or "", g.path)
    end
    if #L == 0 then
        return "No interactable objects found.", "0 groups"
    end
    return table.concat(L, "\n"), #order .. " groups"
end

T.get_player_data = function(a)
    local plr = LocalPlayer
    if argStr(a.player) then
        plr = Players:FindFirstChild(a.player)
        if not plr then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():find(a.player:lower(), 1, true) or p.DisplayName:lower():find(a.player:lower(), 1, true) then
                    plr = p
                    break
                end
            end
        end
        if not plr then
            return "ERROR: player not found: " .. a.player, "not found"
        end
    end
    local L = {}
    L[#L + 1] = ("%s (@%s) UserId %d | Team %s | AccountAge %d | path %s"):format(
        plr.DisplayName, plr.Name, plr.UserId, plr.Team and plr.Team.Name or "-", plr.AccountAge, U.path(plr))
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then
            L[#L + 1] = ("Humanoid: Health %s/%s WalkSpeed %s JumpPower %s JumpHeight %s UseJumpPower %s HipHeight %s State %s"):format(
                Ser.num(hum.Health), Ser.num(hum.MaxHealth), Ser.num(hum.WalkSpeed), Ser.num(hum.JumpPower),
                Ser.num(hum.JumpHeight), tostring(hum.UseJumpPower), Ser.num(hum.HipHeight), tostring(hum:GetState()))
        end
        if hrp then
            L[#L + 1] = "HRP: " .. Ser.value(hrp.CFrame)
        end
        local tools = {}
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then
                tools[#tools + 1] = t.Name
            end
        end
        if #tools > 0 then
            L[#L + 1] = "Equipped: " .. table.concat(tools, ", ")
        end
        local cattrs = char:GetAttributes()
        if next(cattrs) then
            local t = {}
            for k, v in pairs(cattrs) do
                t[#t + 1] = k .. "=" .. U.preview(v, 40)
            end
            L[#L + 1] = "Character attributes: " .. table.concat(t, ", ")
        end
    else
        L[#L + 1] = "Character: none"
    end
    local attrs = plr:GetAttributes()
    if next(attrs) then
        local t = {}
        for k, v in pairs(attrs) do
            t[#t + 1] = k .. "=" .. U.preview(v, 40)
        end
        L[#L + 1] = "Player attributes: " .. table.concat(t, ", ")
    end
    local skip = { PlayerGui = true, PlayerScripts = true, Backpack = true, StarterGear = true }
    for _, child in ipairs(plr:GetChildren()) do
        if not skip[child.ClassName] and not skip[child.Name] then
            if child:IsA("ValueBase") then
                L[#L + 1] = ("Value %s = %s"):format(child.Name, U.preview(child.Value, 60))
            elseif #child:GetChildren() > 0 then
                local vals = valuesOf(child, 30)
                L[#L + 1] = ("%s [%s] (%d): %s"):format(child.Name, child.ClassName, #child:GetChildren(),
                    #vals > 0 and table.concat(vals, ", ") or U.childNames(child, 20))
            end
        end
    end
    local bp = plr:FindFirstChildOfClass("Backpack")
    if bp then
        L[#L + 1] = "Backpack: " .. U.childNames(bp, 30)
    end
    local pg = plr:FindFirstChildOfClass("PlayerGui")
    if pg then
        local guis = {}
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("LayerCollector") then
                guis[#guis + 1] = g.Name .. (g.Enabled and "" or "(off)")
            end
        end
        L[#L + 1] = "PlayerGui: " .. table.concat(guis, ", ")
    end
    return table.concat(L, "\n"), plr.Name
end

T.list_players = function()
