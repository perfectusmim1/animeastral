function UI.rememberOrModel(id)
    id = U.trim(tostring(id or ""))
    if id == "" then
        return
    end
    if Store.data == nil then
        Store.data = {}
    end
    local list = Store.data.or_models
    if type(list) ~= "table" then
        list = {}
        Store.data.or_models = list
    end
    for i, m in ipairs(list) do
        if tostring(m) == id then
            table.remove(list, i)
            break
        end
    end
    table.insert(list, 1, id)
    while #list > 8 do
        table.remove(list)
    end
    pcall(Store.save)
end

function UI.fillModelMenu(menu)
    if UI.dead or not menu then
        return
    end
    for _, ch in ipairs(menu:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
    local order = 0
    local function header(t)
        order += 1
        Text({ Text = t, Font = FONT.medium, TextSize = 11, TextColor3 = C.faint,
            Size = UDim2.new(1, 0, 0, 18), LayoutOrder = order, Parent = menu })
    end
    local cur = UI.currentModel()
    local function row(provider, id)
        order += 1
        local active = provider == UI.provider and tostring(id) == tostring(cur)
        local b = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = active and C.surface or C.surface2, BackgroundTransparency = active and 0 or 1,
            LayoutOrder = order, Parent = menu })
        Corner(8, b)
        Text({ Text = (active and "» " or "") .. tostring(id), TextSize = 14,
            TextColor3 = active and C.text or C.text2, Position = UDim2.fromOffset(10, 0),
            Size = UDim2.new(1, -44, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = b })
        Text({ Text = ">", TextSize = 15, TextColor3 = C.faint, AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 16), Parent = b })
        UI.menuRow(b, active, function()
            UI.pickModel(provider, id)
        end, function()
            UI.showThinkFly(provider, id, b, menu)
        end, function()
            UI.flyHoverRow = false
            UI.hideThinkFlySoon(0.25)
        end)
    end
    header("GEMINI")
    row("gemini", DEFAULT_MODEL)
    header("OPENROUTER")
    local seen = {}
    local ors = {}
    if AI ~= nil and AI.orModel ~= nil and tostring(AI.orModel) ~= "" then
        ors[#ors + 1] = tostring(AI.orModel)
    end
    -- Free router: OpenRouter picks a healthy free model instead of pinning us to one
    -- provider, which is the usual cause of "injected into SSE stream" failures.
    for _, m in ipairs(OR_SUGGESTED) do
        ors[#ors + 1] = m
    end
    if Store.data ~= nil and type(Store.data.or_models) == "table" then
        for _, m in ipairs(Store.data.or_models) do
            ors[#ors + 1] = m
        end
    end
    local n = 0
    for _, m in ipairs(ors) do
        m = tostring(m)
        if m ~= "" and not seen["or:" .. m] then
            seen["or:" .. m] = true
            row("openrouter", m)
            n += 1
            if n >= 10 then
                break
            end
        end
    end
    if n == 0 then
        order += 1
        Text({ Text = "Set a model id in Setup → OpenRouter", TextSize = 12, TextColor3 = C.faint,
            Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order, Parent = menu })
    end
end

