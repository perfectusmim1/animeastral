function Draft.reset()
    Draft.code = nil
    Draft.version = 0
    Draft.title = nil
    Draft.summary = ""
    Draft.features = {}
    Draft.finished = false
    Draft.syntaxOk = false
    Draft.finishRefusals = 0
    Draft.lastReport = ""
end
Draft.reset()

function Draft.clean(code)
    code = tostring(code or ""):gsub("\r\n", "\n")
    code = code:gsub("^%s*```[%w]*[ \t]*\n", ""):gsub("\n%s*```%s*$", "")
    return code
end

function Draft.lineCount(code)
    code = code or Draft.code or ""
    local n = 1
    for _ in code:gmatch("\n") do
        n += 1
    end
    return n
end

function Draft.extract(content)
    for _, p in ipairs(content.parts or {}) do
        if type(p.text) == "string" then
            local code = p.text:match("```lua[u]?%s*\n(.-)```")
            if code and #code > 200 then
                return code
            end
        end
    end
    return nil
end

function Draft.lint(code)
    local w = {}
    local lib = Agent.lib or "rayfield"
    if lib == "rayfield" then
        if not code:find("sirius.menu/gen2", 1, true) then
            w[#w + 1] = 'Missing Rayfield Gen2 loader: local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()'
        end
        if code:find("sirius.menu/rayfield", 1, true) then
            w[#w + 1] = "Old Rayfield (Gen1) URL used; only use https://sirius.menu/gen2."
        end
        local checks = {
            { "CurrentValue", "No 'CurrentValue' in Gen2 → use 'value'." },
            { "CurrentOption", "No 'CurrentOption' in Gen2 → use 'value'." },
            { "MultipleOptions", "No 'MultipleOptions' in Gen2 → use 'multiSelect'." },
            { "CurrentKeybind", "No 'CurrentKeybind' in Gen2 → use 'value'." },
            { ":CreateLabel(", "No CreateLabel in Gen2 → tab:CreateText({ name = ..., text = ... })." },
            { ":CreateParagraph(", "No CreateParagraph in Gen2 → tab:CreateText({ name = ..., text = ... })." },
            { "LoadConfiguration", "No LoadConfiguration in Gen2; use CreateWindow configuration = { autoSave = true, autoLoad = true, ... }." },
            { "Rayfield:Notify", "In Gen2 notifications use Window:Notify({ title, content, duration })." },
            { "Rayfield:Destroy", "To close the UI in Gen2 use Window:Unload()." },
            { "KeySystem", "Do not add a key system." },
        }
        for _, c in ipairs(checks) do
            if code:find(c[1], 1, true) then
                w[#w + 1] = c[2]
            end
        end
        if code:match(":CreateTab%(%s*[\"']") then
            w[#w + 1] = 'CreateTab takes a table: Window:CreateTab({ name = "Main", icon = 10723407389 }).'
        end
        if code:match(":CreateSection%(%s*[\"']") then
            w[#w + 1] = 'CreateSection takes a table: Tab:CreateSection({ name = "..." }).'
        end
    else
        if not code:find("StyearX/Fluent-modded", 1, true) then
            w[#w + 1] = 'Missing Fluent Modded loader: local Fluent = loadstring(game:HttpGet("https://github.com/StyearX/Fluent-modded/releases/latest/download/main.lua"))()'
        end
        if code:find("dawid-scripts", 1, true) then
            w[#w + 1] = "Original Fluent URL used; use StyearX/Fluent-modded (SaveManager/InterfaceManager = Fluent.SaveManager / Fluent.InterfaceManager)."
        end
        for _, m in ipairs({ "AddToggle", "AddSlider", "AddDropdown", "AddInput", "AddKeybind", "AddColorpicker" }) do
            if code:match(":" .. m .. "%(%s*{") then
                w[#w + 1] = m .. ' requires a unique flag string as first argument: :' .. m .. '("Flag", { ... }).'
            end
        end
        if code:find(":AddLabel(", 1, true) then
            w[#w + 1] = "No AddLabel in Fluent → AddParagraph({ Title = ..., Content = ... })."
        end
        if not code:find("SelectTab", 1, true) then
            w[#w + 1] = "Call Window:SelectTab(1) at the end."
        end
    end
    if code:find("while%s+true%s+do") then
        if not (code:find("task.wait", 1, true) or code:find("wait(", 1, true) or code:find(":Wait()", 1, true)) then
            w[#w + 1] = "No wait in while true do loop (add task.wait)."
        end
    end
    for url in code:gmatch("HttpGet%(%s*[\"']([^\"']+)[\"']") do
        if not (url:find("sirius.menu/gen2", 1, true) or url:find("StyearX/Fluent-modded", 1, true)) then
            w[#w + 1] = "Loading external script (" .. url:sub(1, 80) .. "): only the UI library may be loaded, remove it."
        end
    end
    if code:find("webhook", 1, true) or code:match("[^%w_]request%s*%(") or code:find("http_request", 1, true) then
        w[#w + 1] = "HTTP request / webhook detected: remove it."
    end
    if code:find("TODO", 1, true) or code:find("YOUR_", 1, true) then
        w[#w + 1] = "Do not leave placeholders (TODO / YOUR_...); use real values."
    end
    return w
end

function Draft.check()
    local code = Draft.code or ""
    local syntaxOk, msg, context = true, "OK", nil
    if Env.loadstring then
        local fn, err = Env.loadstring(code, "=script.lua")
        if not fn then
            syntaxOk = false
            msg = tostring(err)
            local ln = tonumber(msg:match(":(%d+):"))
            if ln then
                local lines = U.splitLines(code)
                local ctx = {}
                for i = math.max(1, ln - 3), math.min(#lines, ln + 2) do
                    ctx[#ctx + 1] = ("%s%4d| %s"):format(i == ln and ">>" or "  ", i, lines[i])
                end
                context = table.concat(ctx, "\n")
            end
        end
    else
        msg = "no loadstring, syntax check skipped"
    end
    local lint = Draft.lint(code)
    Draft.syntaxOk = syntaxOk
    local report = "Syntax: " .. (syntaxOk and "OK ✓" or ("ERROR ✗ → " .. msg))
    if context then
        report ..= "\n" .. context
    end
    if #lint > 0 then
        report ..= "\nLint warnings (fix them):\n- " .. table.concat(lint, "\n- ")
    end
    Draft.lastReport = report
    return report, syntaxOk
end

function Draft.finish(a)
    a = a or {}
    Draft.title = (a.title and tostring(a.title) ~= "" and tostring(a.title)) or Draft.title or (U.gameName() .. " Script")
    Draft.summary = a.summary and tostring(a.summary) or Draft.summary or ""
    Draft.features = type(a.features) == "table" and a.features or Draft.features or {}
    Draft.finished = true
end

