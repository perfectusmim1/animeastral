    end
    if open then
        UI.modelMenu.Visible = true
        if UI.modelDim then
            UI.modelDim.Visible = true
        end
        if UI.modelMenu:IsA("CanvasGroup") then
            UI.modelMenu.GroupTransparency = 1
            Tween(UI.modelMenu, 0.15, { GroupTransparency = 0 })
        end
    else
        -- Fade out before hiding; a hard Visible=false made the menu blink shut.
        local m = UI.modelMenu
        if m:IsA("CanvasGroup") then
            Tween(m, 0.12, {
                GroupTransparency = 1,
            })
            task.delay(0.13, function()
                if not UI.dead and m.GroupTransparency >= 1 then
                    m.Visible = false
                    if UI.modelDim then
                        UI.modelDim.Visible = false
                    end
                end
            end)
        else
            m.Visible = false
            if UI.modelDim then
                UI.modelDim.Visible = false
            end
        end
    end
end

