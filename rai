local REMOTE_CLASS = { RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true }
local SPY_METHOD = {
    FireServer = "FireServer",
    fireServer = "FireServer",
    InvokeServer = "InvokeServer",
    invokeServer = "InvokeServer",
}

Spy.logs = {}
Spy.max = 500
Spy.seq = 0
Spy.enabled = true
Spy.hooked = false
Spy.incoming = false
Spy.conns = {}
Spy.counts = {}
Spy.startTime = os.clock()
Spy.seen = 0
Spy.methods = nil
Spy.methodsSet = nil
Spy.invokes = {}

function Spy.getSeen()
    return Spy.seen
end

function Spy.seenLine()
    return ("seen %d namecalls (game) · showing filtered"):format(Spy.seen)
end

function Spy.setMethods(list)
    if list == nil or list == "" then
        Spy.methods = nil
        Spy.methodsSet = nil
        return
    end
    if type(list) ~= "table" then
        return
    end
    if #list == 0 then
        Spy.methods = nil
        Spy.methodsSet = nil
        return
    end
    local set = {}
    local arr = {}
    for _, m in ipairs(list) do
        if type(m) == "string" and m ~= "" and not set[m] then
            set[m] = true
            arr[#arr + 1] = m
        end
    end
    if #arr == 0 then
        Spy.methods = nil
        Spy.methodsSet = nil
        return
    end
    Spy.methods = arr
    Spy.methodsSet = set
end

function Spy.describeBuffer(v)
    if typeof(v) ~= "buffer" then
        return "buffer(?)"
    end
    local okLen, len = pcall(buffer.len, v)
    if not okLen or type(len) ~= "number" then
        return "buffer(?)"
    end
    local nHex = math.min(len, 24)
    local nAscii = math.min(len, 120)
    local hexParts = {}
    local chars = {}
    local okRead = pcall(function()
        for i = 0, nHex - 1 do
            hexParts[#hexParts + 1] = ("%02X"):format(buffer.readu8(v, i))
        end
        for i = 0, nAscii - 1 do
            local b = buffer.readu8(v, i)
            if b >= 32 and b <= 126 then
                chars[#chars + 1] = string.char(b)
            else
                chars[#chars + 1] = "."
            end
        end
    end)
    if not okRead then
        return ("buffer(len %d)"):format(len)
    end
    local ascii = table.concat(chars)
    if #ascii > 120 then
        ascii = ascii:sub(1, 120)
    end
    return ("buffer(len %d) hex %s ascii %s"):format(len, table.concat(hexParts, " "), ascii)
end

function Spy.record(remote, method, args, caller, direction)
    if not Spy.enabled then
        return
    end
    local okP, path = pcall(U.path, remote)
    local okN, name = pcall(function()
        return remote.Name
    end)
    local resolved
    if okP and path then
        resolved = path
    elseif direction == "call" then
        local okC, cls = pcall(function()
            return remote.ClassName
        end)
        if okC and type(cls) == "string" and cls ~= "" then
            resolved = cls .. "." .. tostring(method)
        elseif okN and name then
            resolved = name
        else
            resolved = "?"
        end
    elseif okN and name then
        resolved = name
    else
        resolved = "?"
    end
    Spy.seq += 1
    local e = {
        id = Spy.seq,
        t = os.clock(),
        remote = remote,
        name = okN and name or "?",
        path = resolved,
        method = method,
        args = args,
        caller = caller,
        direction = direction,
        dir = direction == "call" and "CALL" or direction,
    }
    local logs = Spy.logs
    logs[#logs + 1] = e
    if #logs > Spy.max then
        table.remove(logs, 1)
    end
    local key = direction .. "|" .. e.path
    Spy.counts[key] = (Spy.counts[key] or 0) + 1
end

function Spy.argsCode(e)
    if e.code then
        return e.code
    end
    local parts = {}
    local n = e.args.n or #e.args
    for i = 1, n do
        local v = e.args[i]
        if typeof(v) == "buffer" then
            local okD, d = pcall(Spy.describeBuffer, v)
            parts[i] = (okD and type(d) == "string" and d or "buffer(?)")
        else
            local ok, s = pcall(Ser.value, v, 0, {})
            parts[i] = ok and s or "nil --[[?]]"
        end
    end
    local s = table.concat(parts, ", ")
    if #s > 900 then
        s = s:sub(1, 900) .. " --[[…]]"
    end
    e.code = s
    return s
end

function Spy.format(e)
    local tag
    if e.direction == "in" then
        tag = "IN "
    elseif e.direction == "call" then
        tag = "CALL"
    else
        tag = "OUT"
    end
    local head = ("#%d [+%.1fs] %s %s"):format(e.id, e.t - Spy.startTime, tag, e.method)
    local caller = ""
    if e.caller then
        local ok, p = pcall(U.path, e.caller)
        if ok then
            caller = "  caller=" .. U.short(p)
        end
    end
    local args = Spy.argsCode(e)
    local code
    if e.direction == "in" then
        code = ("-- server→client  %s.%s(%s)"):format(e.path, e.method, args)
    else
        code = ("%s:%s(%s)"):format(e.path, e.method, args)
    end
    return head .. caller .. "\n" .. code
end

function Spy.since(seq)
    local out = {}
    for _, e in ipairs(Spy.logs) do
        if e.id > seq then
            out[#out + 1] = e
        end
    end
    return out
end

function Spy.clear()
    table.clear(Spy.logs)
    table.clear(Spy.counts)
end

function Spy.install()
    if Spy.hooked then
        return true
    end
    local hmm, gncm = Env.hookmetamethod, Env.getnamecallmethod
    if not (hmm and gncm) then
        return false, "hookmetamethod/getnamecallmethod missing"
    end
    local isCaller = Env.checkcaller or function()
        return false
    end
    local getCaller = Env.getcallingscript
    local old
    local ok, err = pcall(function()
        old = hmm(
            game,
            "__namecall",
            Env.newcclosure(function(self, ...)
                if Spy.enabled then
                    local m = gncm()
                    if not isCaller() then
                        Spy.seen += 1
                        local canon = SPY_METHOD[m]
                        if canon then
                            if typeof(self) == "Instance" and REMOTE_CLASS[self.ClassName] then
                                local args = table.pack(...)
                                local caller = nil
                                if getCaller then
                                    local okC, c = pcall(getCaller)
                                    if okC then
                                        caller = c
                                    end
                                end
                                task.defer(Spy.record, self, canon, args, caller, "out")
                            end
                        elseif Spy.methodsSet and Spy.methodsSet[m] and typeof(self) == "Instance" then
                            local args = table.pack(...)
                            local caller = nil
                            if getCaller then
                                local okC, c = pcall(getCaller)
                                if okC then
                                    caller = c
                                end
                            end
                            task.defer(Spy.record, self, m, args, caller, "call")
                        end
                    end
                end
                return old(self, ...)
            end)
        )
    end)
    if not ok then
        return false, tostring(err)
    end
    Spy.hooked = true
    return true
end

-- Listens for server → client events and function calls (only remotes the game already listens to, so the queue stays intact)
function Spy.listenIncoming()
    if Spy.incoming then
        return
    end
    Spy.incoming = true
    local roots = { ReplicatedStorage, ReplicatedFirst, Workspace, LocalPlayer, Lighting, StarterGui }
    local count = 0
    for _, root in ipairs(roots) do
        local ok, desc = pcall(function()
            return root:GetDescendants()
        end)
        if ok then
            for i, d in ipairs(desc) do
                local cls = d.ClassName
                if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
                    local listen = true
                    if Env.getconnections then
                        local okC, conns = pcall(Env.getconnections, d.OnClientEvent)
                        listen = okC and type(conns) == "table" and #conns > 0
                    end
                    if listen then
                        local okL, conn = pcall(function()
                            return d.OnClientEvent:Connect(function(...)
                                if Spy.enabled then
                                    Spy.record(d, "OnClientEvent", table.pack(...), nil, "in")
                                end
                            end)
                        end)
                        if okL and conn then
                            Spy.conns[#Spy.conns + 1] = conn
                            count += 1
                        end
                    end
                elseif cls == "RemoteFunction" then
                    local okR, cur = pcall(function()
                        return d.OnClientInvoke
                    end)
                    if okR and type(cur) == "function" then
                        local already = false
                        for _, w in ipairs(Spy.invokes) do
                            if w.remote == d then
                                already = true
                                break
                            end
                        end
                        if not already then
                            local orig = cur
                            local wrapper
                            wrapper = function(...)
                                if Spy.enabled then
                                    Spy.record(d, "OnClientInvoke", table.pack(...), nil, "in")
                                end
                                return orig(...)
                            end
                            local okW = pcall(function()
                                d.OnClientInvoke = wrapper
                            end)
                            if okW then
                                Spy.invokes[#Spy.invokes + 1] = { remote = d, orig = orig, wrapper = wrapper }
                                count += 1
                            end
                        end
                    end
                end
                if i % 20000 == 0 then
                    task.wait()
                end
            end
        end
    end
    return count
end

function Spy.stopIncoming()
    for _, c in ipairs(Spy.conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(Spy.conns)
    for _, w in ipairs(Spy.invokes) do
        pcall(function()
            if w.remote and w.wrapper and w.remote.OnClientInvoke == w.wrapper then
                w.remote.OnClientInvoke = w.orig
            end
        end)
    end
    table.clear(Spy.invokes)
    Spy.incoming = false
end

