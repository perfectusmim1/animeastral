function UI.refreshSessions()
    if UI.dead or not UI.sideList then
        return
    end
    for _, ch in ipairs(UI.sideList:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
    if not (Sessions and Sessions.list) then
        local t = Text({ Text = "Session history unavailable", TextSize = 12, TextColor3 = C.faint,
            TextWrapped = true, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = UI.sideList })
        t.TextXAlignment = Enum.TextXAlignment.Center
        return
    end
    local ok, list = pcall(function()
        return Sessions.list()
    end)
    if not ok or type(list) ~= "table" or #list == 0 then
        local t = Text({ Text = "No sessions yet", TextSize = 12, TextColor3 = C.faint,
            TextWrapped = true, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = UI.sideList })
        t.TextXAlignment = Enum.TextXAlignment.Center
        return
    end
    local cur = UI.currentSessionId()
    for i, s in ipairs(list) do
        if type(s) ~= "table" then
            s = { title = tostring(s) }
        end
        local id = s.id or s.sessionId or s.key or i
        local title = tostring(s.title or s.name or id)
        if #title > 32 then
            title = title:sub(1, 32) .. "..."
        end
        local dateStr = ""
        local ts = s.updatedAt or s.date or s.time or s.mtime
        if type(ts) == "number" then
            local dOk, d = pcall(function()
                return os.date("%m-%d %H:%M", ts)
            end)
            dateStr = (dOk and d) or tostring(ts)
        elseif ts ~= nil then
            dateStr = tostring(ts)
        end
        local model = tostring(s.model or s.provider or "")
        local n = s.lines or s.lineCount or s.numLines or s.turns or s.turnCount or 0
        local meta = dateStr
        if model ~= "" then
            meta = (meta ~= "" and (meta .. " · ") or "") .. model
        end
        if tonumber(n) and tonumber(n) > 0 then
            meta = (meta ~= "" and (meta .. " · ") or "") .. tostring(n) .. " lines"
        end
        local row = New("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = C.surface2, LayoutOrder = i, Parent = UI.sideList })
        Corner(10, row)
        local st = Stroke(C.soft, row)
        if cur ~= nil and tostring(id) == tostring(cur) then
            st.Color = C.text2
        end
        local loadBtn = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
            Size = UDim2.new(1, -36, 1, 0), Parent = row })
        Text({ Text = title, Font = FONT.medium, TextSize = 13, TextColor3 = C.text,
            Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -16, 0, 17),
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = loadBtn })
        Text({ Text = meta, TextSize = 12, TextColor3 = C.muted,
            Position = UDim2.fromOffset(10, 26), Size = UDim2.new(1, -16, 0, 16),
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = loadBtn })
        local del = New("ImageButton", { Image = "rbxassetid://" .. ICON.trash, ImageColor3 = C.faint,
            BackgroundTransparency = 1, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = row })
        del.MouseEnter:Connect(function()
            del.ImageColor3 = C.red
        end)
        del.MouseLeave:Connect(function()
            del.ImageColor3 = C.faint
        end)
        del.MouseButton1Click:Connect(function()
            if UI.dead then
                return
            end
            if Sessions and Sessions.delete then
                pcall(function()
                    Sessions.delete(id)
                end)
            end
            UI.refreshSessions()
        end)
        loadBtn.MouseButton1Click:Connect(function()
            UI.openSession(id, title)
        end)
    end
end

function UI.refreshScripts()
    if UI.dead or not UI.scriptList then
        return
    end
    for _, ch in ipairs(UI.scriptList:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
    if not (Sessions and Sessions.scripts) then
        return
    end
    local ok, names = pcall(function()
        return Sessions.scripts()
    end)
    if not ok or type(names) ~= "table" or #names == 0 then
        Text({ Text = "No saved scripts", TextSize = 12, TextColor3 = C.faint,
            Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = UI.scriptList })
        return
    end
    for i, name in ipairs(names) do
        local fname = tostring(type(name) == "table" and (name.name or name.path) or name)
        local short = fname:match("([^/\\]+)$") or fname
        if #short > 30 then
            short = short:sub(1, 30) .. "..."
        end
        local full = fname
        local b = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = C.surface2, LayoutOrder = i, Parent = UI.scriptList })
        Corner(8, b)
        Stroke(C.soft, b)
        Img(ICON.file, 14, C.muted, { Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = b })
        Text({ Text = short, TextSize = 13, TextColor3 = C.text2,
            Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -66, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = b })
        local del = New("ImageButton", { Image = "rbxassetid://" .. ICON.trash, ImageColor3 = C.faint,
            BackgroundTransparency = 1, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = b })
        del.MouseEnter:Connect(function()
            del.ImageColor3 = C.red
        end)
        del.MouseLeave:Connect(function()
            del.ImageColor3 = C.faint
        end)
        del.MouseButton1Click:Connect(function()
            if UI.dead then
                return
            end
            if Agent.running then
                UI.toast("Stop the agent first", "error")
                return
            end
            local base = tostring(full):match("([^/\\]+)$") or tostring(full)
            if base == "" or base:find("%.%.", 1, true) or not Env.delfile then
                UI.toast("Delete not supported here", "error")
                return
            end
            local ok = pcall(Env.delfile, "ScriptCreator/scripts/" .. base)
            if ok then
                if UI.pendingName == short then
                    UI.clearPending()
                end
                UI.refreshScripts()
                UI.toast("Deleted " .. short)
            else
                UI.toast("Could not delete " .. short, "error")
            end
        end)
        b.MouseButton1Click:Connect(function()
            if UI.dead then
                return
            end
            if not (Sessions and Sessions.readScript) then
                return
            end
            local rOk, code = pcall(function()
                return Sessions.readScript(full)
            end)
            if rOk and type(code) == "string" and code ~= "" then
                UI.pendingCode = code
                UI.pendingName = short
                UI.refreshPendingChip()
                UI.toast("Loaded " .. short .. " - type changes, press START")
            else
                UI.toast("Could not load " .. short, "error")
            end
        end)
    end
end

function UI.destroy()
    if UI.dead then
        return
    end
    UI.dead = true
    Agent.stopRequested = true
    Spy.enabled = false
    Spy.stopIncoming()
    for _, c in ipairs(UI.conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(UI.spinners)
    if UI.gui then
        UI.gui:Destroy()
    end
    genv.__ScriptCreatorCleanup = nil
end

