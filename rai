local function clampNum(v, lo, hi, default)
    v = tonumber(v)
    if not v then
        return default
    end
    return math.clamp(math.floor(v), lo, hi)
end

local function argStr(v)
    if v == nil then
        return nil
    end
    v = tostring(v)
    if v == "" then
        return nil
    end
    return v
end

local function resolveArg(p)
    local inst, err = U.resolve(p)
    if not inst then
        return nil, "ERROR: " .. tostring(err)
    end
    return inst
end

