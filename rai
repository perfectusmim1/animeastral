function UI.onAgentStart()
    if UI.dead then
        return
    end
    UI.busy = true
    UI.updateComposer()
    UI.renderStatus()
end

function UI.onAgentEnd(outcome)
    if UI.dead then
        return
    end
    -- Safety net: every exit from Agent.loop passes through here, including the ones that
    -- return before endThinking could be reached. Idempotent, so a normal finish is a no-op.
    UI.endThinking()
    UI.busy = false
    if outcome == "finished" then
        UI.setStatus(("Done · %s · %d lines"):format(Draft.title or "script.lua", Draft.lineCount()), "done")
        UI.addResultCard()
        UI.renderResult()
        task.delay(1.8, function()
            if not UI.dead and not Agent.running then
                UI.showPage("result")
            end
        end)
    elseif outcome == "stopped" then
        UI.setStatus("Stopped", "warn")
        UI.addNotice("Agent stopped." .. (Draft.code and " Current draft is in the Script tab." or ""))
    elseif outcome == "cap" then
        UI.setStatus("Safety step cap reached · send a message to continue", "warn")
    elseif outcome == "ctxfull" then
        UI.setStatus("Context full · start a new session", "error")
        UI.addNotice("Context budget exhausted. Start a new session to continue." .. (Draft.code and " Current draft is in the Script tab." or ""))
    else
        UI.setStatus("Something went wrong · type 'continue' to retry", "error")
    end
    if Draft.code then
        UI.onDraftUpdated()
    end
    UI.updateComposer()
    UI.refreshKeyStatus()
end

function UI.onDraftUpdated()
    if UI.dead then
        return
    end
    UI.tabResult.TextColor3 = UI.page == "result" and C.text or C.muted
    if UI.page == "result" then
        UI.renderResult()
    end
end

function UI.renderCode(code)
    local list = UI.codeScroll
    for _, ch in ipairs(list:GetChildren()) do
        if ch:IsA("Frame") then
            ch:Destroy()
        end
    end
    local hl = Highlight.lines(code)
    local CHUNK = 60
    for start = 1, #hl, CHUNK do
        local stop = math.min(start + CHUNK - 1, #hl)
        local nums, body = {}, {}
        for i = start, stop do
            nums[#nums + 1] = tostring(i)
            body[#body + 1] = (hl[i] == "" and " ") or hl[i]
        end
        local row = New("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(0, 0, 0, 0),
            LayoutOrder = start, Parent = list })
        Text({ Text = table.concat(nums, "\n"), Font = FONT.mono, TextSize = 13, TextColor3 = Color3.fromRGB(85, 85, 85),
            TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top,
            Size = UDim2.new(0, 34, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row })
        Text({ Text = table.concat(body, "\n"), RichText = true, Font = FONT.mono, TextSize = 13, TextColor3 = Color3.fromRGB(220, 220, 220),
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(46, 0),
            Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, Parent = row })
    end
    list.CanvasPosition = Vector2.new(0, 0)
end

function UI.renderResult()
    if UI.dead or not Draft.code then
        return
    end
    UI.rTitle.Text = Draft.title or (U.gameName() .. " Script")
    UI.rMeta.Text = ("%d lines · %s · v%d · %s"):format(Draft.lineCount(), Docs.names[Agent.lib] or "", Draft.version,
        Draft.syntaxOk and "syntax ✓" or "syntax not checked")
    local summary = tostring(Draft.summary or "")
    if type(Draft.features) == "table" and #Draft.features > 0 then
        local f = {}
        for i, v in ipairs(Draft.features) do
            if i > 14 then
                break
            end
            f[#f + 1] = tostring(v)
        end
        summary = (summary ~= "" and (summary .. "\n") or "") .. table.concat(f, " · ")
    end
    UI.rSummary.Text = summary ~= "" and summary or "Draft script. Copy, save, or Execute it directly."
    UI.codeInfo.Text = Draft.lineCount() .. " lines"
    if UI.renderedVersion ~= Draft.version then
        UI.renderedVersion = Draft.version
        UI.renderCode(Draft.code)
    end
end

