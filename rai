Keys.byProvider = { gemini = {}, openrouter = {} }
Keys.active = "gemini"
Keys.list = Keys.byProvider.gemini
Keys.rr = 0

-- Switches the active provider list (also mirrors Agent.provider).
function Keys.useProvider(p)
    if p ~= "gemini" and p ~= "openrouter" then
        return
    end
    Keys.active = p
    Keys.list = Keys.byProvider[p]
    Keys.rr = 0
    if Agent then
        Agent.provider = p
    end
end

function Keys.new(k)
    return { key = k, cooldown = 0, dead = false, uses = 0, fails = 0, lastError = nil }
end

function Keys.parse(str)
    local out = {}
    for token in tostring(str or ""):gmatch("[^%s,;|]+") do
        token = token:gsub("^[\"'`]+", ""):gsub("[\"'`]+$", "")
        if #token >= 20 and token:match("^[%w%-_%.]+$") then
            out[#out + 1] = token
        end
    end
    return out
end

function Keys.add(str)
    local added = 0
    for _, k in ipairs(Keys.parse(str)) do
        local dup = false
        for _, e in ipairs(Keys.list) do
            if e.key == k then
                dup = true
                break
            end
        end
        if not dup then
            Keys.list[#Keys.list + 1] = Keys.new(k)
            added += 1
        end
    end
    return added
end

function Keys.remove(i)
    table.remove(Keys.list, i)
end

function Keys.load(arr)
    -- Reuse the active table in place so the byProvider reference stays intact.
    local list = Keys.byProvider[Keys.active]
    if type(list) ~= "table" then
        list = {}
        Keys.byProvider[Keys.active] = list
    end
    table.clear(list)
    Keys.list = list
    Keys.rr = 0
    if type(arr) == "table" then
        for _, k in ipairs(arr) do
            if type(k) == "string" then
                Keys.add(k)
            end
        end
    end
end

function Keys.serializeList(list)
    local t = {}
    for _, e in ipairs(list) do
        t[#t + 1] = e.key
    end
    return t
end

function Keys.serialize()
    return Keys.serializeList(Keys.list)
end

-- Persists both providers' keys, then saves.
function Keys.persist()
    if Store and Store.data then
        Store.data.keys = Keys.serializeList(Keys.byProvider.gemini)
        Store.data.keys_openrouter = Keys.serializeList(Keys.byProvider.openrouter)
    end
    if Store and Store.save then
        Store.save()
    end
end

-- Loads both providers' keys (backcompat: data.keys -> gemini).
function Keys.loadAll(data)
    data = type(data) == "table" and data or {}
    local function fill(arr)
        local list = {}
        if type(arr) == "table" then
            for _, k in ipairs(arr) do
                if type(k) == "string" then
                    for _, tok in ipairs(Keys.parse(k)) do
                        local dup = false
                        for _, e in ipairs(list) do
                            if e.key == tok then
                                dup = true
                                break
                            end
                        end
                        if not dup then
                            list[#list + 1] = Keys.new(tok)
                        end
                    end
                end
            end
        end
        return list
    end
    Keys.byProvider.gemini = fill(data.keys)
    Keys.byProvider.openrouter = fill(data.keys_openrouter)
    if Keys.active ~= "gemini" and Keys.active ~= "openrouter" then
        Keys.active = "gemini"
    end
    Keys.list = Keys.byProvider[Keys.active]
    Keys.rr = 0
end

function Keys.mask(k)
    k = tostring(k or "")
    if #k <= 12 then
        return k
    end
    return k:sub(1, 6) .. "••••••" .. k:sub(-4)
end

function Keys.status(e)
    if e.dead then
        return e.lastError or "invalid", "dead"
    end
    local left = e.cooldown - os.clock()
    if left > 0 then
        return ("%s · %ds"):format(e.lastError or "limit", math.ceil(left)), "cool"
    end
    if e.uses > 0 then
        return e.uses .. " requests", "ok"
    end
    return "ready", "ok"
end

function Keys.acquire()
    local n = #Keys.list
    if n == 0 then
        return nil, "dead"
    end
    local now = os.clock()
    local soonest, alive = math.huge, false
    for _ = 1, n do
        Keys.rr = Keys.rr % n + 1
        local e = Keys.list[Keys.rr]
        if not e.dead then
            alive = true
            if e.cooldown <= now then
                return e
            end
            soonest = math.min(soonest, e.cooldown - now)
        end
    end
    if not alive then
        return nil, "dead"
    end
    return nil, soonest
end

