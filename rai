function Tools.execute(name, args)
    args = type(args) == "table" and args or {}
    local meta = Tools.meta[name] or { tostring(name), "wand", function()
        return ""
    end }
    local okD, detail = pcall(meta[3], args)
    detail = okD and tostring(detail or "") or ""
    local row = UI.toolStart(meta[1], detail, meta[2])
    UI.setStatus(meta[1] .. (detail ~= "" and (" · " .. detail) or ""), "tool")
    local impl = T[name]
    if not impl then
        local msg = "ERROR: unknown tool '" .. tostring(name) .. "'"
        UI.toolDone(row, false, "unknown", msg)
        return msg
    end
    local ok, result, summary = pcall(impl, args)
    if not ok then
        result = "ERROR: tool failed with error: " .. tostring(result)
        summary = "error"
    end
    result = U.safeStr(U.truncate(tostring(result or ""), 18000))
    local success = ok and not result:match("^ERROR") and not result:match("^SyntaxError")
    UI.toolDone(row, success, summary and tostring(summary) or "", result)
    return result
end

