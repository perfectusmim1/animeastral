local function stepInto(cur, name)
    local child = cur:FindFirstChild(name)
    if child then
        return child
    end
    if cur == Players and name == "LocalPlayer" then
        return LocalPlayer
    end
    local okP, isPlayer = pcall(function()
        return cur:IsA("Player")
    end)
    if okP and isPlayer and name == "Character" then
        return cur.Character
    end
    local okV, val = pcall(function()
        return cur[name]
    end)
    if okV and typeof(val) == "Instance" then
        return val
    end
    return nil
end

-- Path resolver: game:GetService("X").A["B C"]:FindFirstChild("D"), workspace/Map/Part, getnil("Name","Class") ...
function U.resolve(path)
    if typeof(path) == "Instance" then
        return path
    end
    path = U.trim(path)
    if path == "" then
        return game
    end
    local n = #path
    local first = path:match("^[%a_][%w_]*")
    if not first then
        return nil, "Invalid path: " .. path
    end
    local i = #first + 1
    local cur
    if first == "getnil" then
        local name, class, after = path:match("^%(%s*[\"'](.-)[\"']%s*,%s*[\"'](.-)[\"']%s*%)()", i)
        if not name then
            name, after = path:match("^%(%s*[\"'](.-)[\"']%s*%)()", i)
        end
        if not name then
            return nil, 'getnil syntax: getnil("Name", "Class")'
        end
        cur = U.getnil(U.unescape(name), class and U.unescape(class))
        if not cur then
            return nil, ("nil instance not found: %s (%s)"):format(name, tostring(class))
        end
        i = after
    elseif SHORTCUTS[first] then
        cur = SHORTCUTS[first]()
    else
        local okS, svc = pcall(function()
            return game:FindService(first)
        end)
        cur = (okS and svc) or game:FindFirstChild(first)
        if not cur then
            local okG, svc2 = pcall(function()
                return game:GetService(first)
            end)
            cur = okG and svc2 or nil
        end
    end
    if not cur then
        return nil, ("'%s' not found"):format(first)
    end
    while i <= n do
        local c = path:sub(i, i)
        local child, label
        if c == "." or c == "/" then
            local seg = path:match("^[^%.%[:/]+", i + 1)
            if not seg then
                return nil, ("Bad path (char %d): %s"):format(i, path)
            end
            i = i + 1 + #seg
            label = U.trim(seg)
            child = stepInto(cur, label)
        elseif c == "[" then
            local _, inner, after = path:match("^%[%s*([\"'])(.-)%1%s*%]()", i)
            if inner then
                label = U.unescape(inner)
                child = stepInto(cur, label)
                i = after
            else
                local num, after2 = path:match("^%[%s*(%d+)%s*%]()", i)
                if not num then
                    return nil, "Bad brackets: " .. path
                end
                label = "[" .. num .. "]"
                child = cur:GetChildren()[tonumber(num)]
                i = after2
            end
        elseif c == ":" then
            local method, arg, after = path:match("^:([%a_][%w_]*)%(%s*[\"'](.-)[\"'][^%)]*%)()", i)
            if not method then
                return nil, "Could not resolve method call: " .. path:sub(i)
            end
            arg = U.unescape(arg)
            label = arg
            i = after
            if method == "GetService" or method == "FindService" then
                local okG, svc = pcall(function()
                    return game:GetService(arg)
                end)
                child = okG and svc or nil
            elseif method == "FindFirstChild" or method == "WaitForChild" then
                child = cur:FindFirstChild(arg)
            elseif method == "FindFirstChildOfClass" then
                child = cur:FindFirstChildOfClass(arg)
            elseif method == "FindFirstChildWhichIsA" then
                child = cur:FindFirstChildWhichIsA(arg)
            elseif method == "FindFirstAncestor" then
                child = cur:FindFirstAncestor(arg)
            else
                return nil, "Unsupported method: " .. method
            end
        elseif c:match("%s") then
            i += 1
            child = cur
        else
            return nil, ("Unexpected character '%s' (%d): %s"):format(c, i, path)
        end
        if not child then
            return nil,
                ("'%s' not found inside '%s'. Available children: %s"):format(
                    U.short(U.path(cur)),
                    tostring(label),
                    U.childNames(cur, 30)
                )
        end
        cur = child
    end
    return cur
end

function U.preview(v, maxLen)
    maxLen = maxLen or 120
    local t = typeof(v)
    local s
    if t == "string" then
        s = '"' .. v:gsub("\n", "\\n") .. '"'
    elseif t == "Instance" then
        s = U.short(U.path(v))
    elseif t == "table" then
        local n = 0
        for _ in next, v do
            n += 1
            if n > 999 then
                break
            end
        end
        s = "table(" .. n .. (n > 999 and "+" or "") .. ")"
    elseif t == "number" then
        s = Ser.num(v)
    elseif t == "function" then
        local name = U.fnInfo(v)
        s = "function " .. (name ~= "" and name or "anonymous")
    elseif t == "Vector3" or t == "Vector2" or t == "CFrame" or t == "Color3" or t == "UDim2" or t == "UDim"
        or t == "EnumItem" or t == "BrickColor" or t == "NumberRange" then
        local ok, r = pcall(Ser.value, v)
        s = ok and r or tostring(v)
    else
        s = tostring(v)
    end
    if #s > maxLen then
        s = s:sub(1, maxLen) .. "…"
    end
    return s
end

-- Shows tables as Luau tables, anything else as a short preview
function U.show(v, maxLen)
    if type(v) == "table" then
        local ok, s = pcall(Ser.value, v, 0, {})
        return U.truncate(ok and s or "table", maxLen or 3000)
    end
    return U.preview(v, maxLen or 300)
end

--══════════════════════════════════════════════════════════════════════
-- SERIALIZER (converts values to runnable Luau code)
--══════════════════════════════════════════════════════════════════════
function Ser.num(n)
    if n ~= n then
        return "0/0"
    end
    if n == math.huge then
        return "math.huge"
    end
    if n == -math.huge then
        return "-math.huge"
    end
    if n == math.floor(n) and math.abs(n) < 1e15 then
        return string.format("%d", n)
    end
    local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
    return s
end

function Ser.str(s, maxLen)
    s = tostring(s)
    local extra = ""
    if maxLen and #s > maxLen then
        extra = (" --[[+%d chars]]"):format(#s - maxLen)
        s = s:sub(1, maxLen)
    end
    s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%c]", function(ch)
        return string.format("\\%03d", ch:byte())
    end)
    return '"' .. s .. '"' .. extra
end

function Ser.value(v, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local t = typeof(v)
    if t == "nil" then
        return "nil"
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "number" then
        return Ser.num(v)
    elseif t == "string" then
        return Ser.str(v, 400)
    elseif t == "Instance" then
        return U.path(v)
    elseif t == "Vector3" then
        return ("Vector3.new(%s, %s, %s)"):format(Ser.num(v.X), Ser.num(v.Y), Ser.num(v.Z))
    elseif t == "Vector2" then
        return ("Vector2.new(%s, %s)"):format(Ser.num(v.X), Ser.num(v.Y))
    elseif t == "CFrame" then
        local c = { v:GetComponents() }
        if c[4] == 1 and c[5] == 0 and c[6] == 0 and c[7] == 0 and c[8] == 1 and c[9] == 0 and c[10] == 0 and c[11] == 0 and c[12] == 1 then
            return ("CFrame.new(%s, %s, %s)"):format(Ser.num(c[1]), Ser.num(c[2]), Ser.num(c[3]))
        end
        local parts = {}
        for i = 1, 12 do
            parts[i] = Ser.num(c[i])
        end
        return "CFrame.new(" .. table.concat(parts, ", ") .. ")"
    elseif t == "Color3" then
        return ("Color3.fromRGB(%d, %d, %d)"):format(
            math.floor(v.R * 255 + 0.5),
            math.floor(v.G * 255 + 0.5),
            math.floor(v.B * 255 + 0.5)
        )
    elseif t == "BrickColor" then
        return ("BrickColor.new(%q)"):format(v.Name)
    elseif t == "UDim2" then
        return ("UDim2.new(%s, %s, %s, %s)"):format(
            Ser.num(v.X.Scale),
            Ser.num(v.X.Offset),
            Ser.num(v.Y.Scale),
            Ser.num(v.Y.Offset)
        )
    elseif t == "UDim" then
        return ("UDim.new(%s, %s)"):format(Ser.num(v.Scale), Ser.num(v.Offset))
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "Enum" then
        return "Enum." .. tostring(v)
    elseif t == "NumberRange" then
        return ("NumberRange.new(%s, %s)"):format(Ser.num(v.Min), Ser.num(v.Max))
    elseif t == "Ray" then
        return ("Ray.new(%s, %s)"):format(Ser.value(v.Origin), Ser.value(v.Direction))
    elseif t == "Rect" then
        return ("Rect.new(%s, %s, %s, %s)"):format(Ser.num(v.Min.X), Ser.num(v.Min.Y), Ser.num(v.Max.X), Ser.num(v.Max.Y))
    elseif t == "TweenInfo" then
        return ("TweenInfo.new(%s, %s, %s, %s, %s, %s)"):format(
            Ser.num(v.Time),
            tostring(v.EasingStyle),
            tostring(v.EasingDirection),
            Ser.num(v.RepeatCount),
            tostring(v.Reverses),
            Ser.num(v.DelayTime)
        )
    elseif t == "NumberSequence" or t == "ColorSequence" then
        local kps = {}
        for _, kp in ipairs(v.Keypoints) do
            if t == "NumberSequence" then
                kps[#kps + 1] = ("NumberSequenceKeypoint.new(%s, %s)"):format(Ser.num(kp.Time), Ser.num(kp.Value))
            else
                kps[#kps + 1] = ("ColorSequenceKeypoint.new(%s, %s)"):format(Ser.num(kp.Time), Ser.value(kp.Value))
            end
        end
        return t .. ".new({" .. table.concat(kps, ", ") .. "})"
    elseif t == "buffer" then
        local ok, s = pcall(buffer.tostring, v)
        return "buffer.fromstring(" .. Ser.str(ok and s or "", 200) .. ")"
    elseif t == "table" then
        if seen[v] then
            return "{--[[circular]]}"
        end
        if depth >= 4 then
            return "{--[[deep]]}"
        end
        seen[v] = true
        local items, count = {}, 0
        local arrLen = rawlen(v)
        for i = 1, arrLen do
            count += 1
            if count > 50 then
                items[#items + 1] = "--[[…]]"
                break
            end
            items[#items + 1] = Ser.value(rawget(v, i), depth + 1, seen)
        end
        if count <= 50 then
            for k, val in next, v do
                local isArr = type(k) == "number" and k >= 1 and k <= arrLen and k % 1 == 0
                if not isArr then
                    count += 1
                    if count > 50 then
                        items[#items + 1] = "--[[…]]"
                        break
                    end
                    local key
                    if U.isIdent(k) then
                        key = k
                    else
                        key = "[" .. Ser.value(k, depth + 1, seen) .. "]"
                    end
                    items[#items + 1] = key .. " = " .. Ser.value(val, depth + 1, seen)
                end
            end
        end
        seen[v] = nil
        if #items == 0 then
            return "{}"
        end
        local one = "{" .. table.concat(items, ", ") .. "}"
        if #one <= 100 then
            return one
        end
        local pad = string.rep("    ", depth + 1)
        return "{\n" .. pad .. table.concat(items, ",\n" .. pad) .. "\n" .. string.rep("    ", depth) .. "}"
    elseif t == "function" then
        local name = U.fnInfo(v)
        return "nil --[[function " .. (name ~= "" and name or "anonymous") .. "]]"
    else
        return "nil --[[" .. t .. ": " .. tostring(v) .. "]]"
    end
end

