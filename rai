function U.trim(s)
    s = tostring(s or "")
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

function U.truncate(s, n)
    s = tostring(s or "")
    if #s <= n then
        return s
    end
    local cut = n
    while cut > 0 do
        local b = s:byte(cut + 1)
        if b and b >= 0x80 and b < 0xC0 then
            cut -= 1
        else
            break
        end
    end
    return s:sub(1, cut) .. ("\n…[%d characters trimmed]"):format(#s - cut)
end

function U.safeStr(s)
    s = tostring(s or "")
    s = s:gsub("%z", "")
    s = s:gsub("[\1-\8\11\12\14-\31\127]", "")
    if utf8.len(s) then
        return s
    end
    local out, i, n = {}, 1, #s
    while i <= n do
        local c = s:byte(i)
        local len = 0
        if c < 0x80 then
            len = 1
        elseif c >= 0xC2 and c <= 0xDF then
            len = 2
        elseif c >= 0xE0 and c <= 0xEF then
            len = 3
        elseif c >= 0xF0 and c <= 0xF4 then
            len = 4
        end
        if len == 0 then
            out[#out + 1] = "?"
            i += 1
        else
            local chunk = s:sub(i, i + len - 1)
            if #chunk == len and utf8.len(chunk) then
                out[#out + 1] = chunk
                i += len
            else
                out[#out + 1] = "?"
                i += 1
            end
        end
    end
    return table.concat(out)
end

