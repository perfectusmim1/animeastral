-- Fade the flyout out instead of snapping it away, so it does not blink.
function UI.flyHide()
    if UI.dead or not UI.thinkFly or not UI.thinkFly.Visible then
        return
    end
    if UI.thinkFly:IsA("CanvasGroup") then
        local f = UI.thinkFly
        Tween(f, 0.12, {
            GroupTransparency = 1,
        })
        task.delay(0.13, function()
            if not UI.dead and f.GroupTransparency >= 1 then
                f.Visible = false
            end
        end)
    else
        UI.thinkFly.Visible = false
    end
end

function UI.showThinkFly(provider, id, row, menu)
    if UI.dead or not UI.thinkFly or not row or not menu then
        return
    end
    UI.flyToken = (UI.flyToken or 0) + 1
    UI.flyHoverRow = true
    for _, ch in ipairs(UI.thinkFly:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
    local levels = (provider == "openrouter")
        and { "default", "low", "medium", "high", "xhigh", "max" }
        or { "minimal", "low", "medium", "high" }
    local cur = ""
    if provider == "openrouter" then
        cur = (AI ~= nil and AI.orEffort ~= nil and AI.orEffort ~= "") and tostring(AI.orEffort) or "default"
    elseif AI ~= nil and AI.thinkLevel ~= nil then
        cur = tostring(AI.thinkLevel)
    end
    local order = 0
    for _, lv in ipairs(levels) do
        order += 1
        local active = lv == cur
        local b = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = C.surface2, BackgroundTransparency = active and 0 or 1,
            LayoutOrder = order, Parent = UI.thinkFly })
        Corner(6, b)
        Text({ Text = (active and "» " or "") .. lv, TextSize = 14,
            TextColor3 = active and C.text or C.text2, Position = UDim2.fromOffset(10, 0),
            Size = UDim2.new(1, -20, 1, 0), Parent = b })
        UI.menuRow(b, active, function()
            UI.pickThinkLevel(provider, lv)
        end)
    end
    pcall(function()
        local host = UI.body or UI.win
        local mx = menu.AbsolutePosition.X - host.AbsolutePosition.X
        local my = menu.AbsolutePosition.Y - host.AbsolutePosition.Y
        local ry = row.AbsolutePosition.Y - menu.AbsolutePosition.Y
        local w = UI.thinkFlyW or 132
        -- Prefer opening LEFT of the row. When the menu sits too close to the left edge
        -- there is no room, and clamping to 4 used to drop the flyout straight on top of the
        -- menu's own first columns; flip it to the menu's right edge instead.
        local left = mx - w - 6
        local x
        if left >= 4 then
            x = left
        else
            local menuW = menu.AbsoluteSize.X
            local right = mx + menuW + 6
            x = (right + w <= (host.AbsoluteSize.X - 4)) and right or math.max(4, mx + menuW - w)
        end
        local y = my + ry
        -- if it doesn't fit below, open upward (align flyout bottom to row bottom)
        if UI.win then
            local winBottom = UI.win.AbsolutePosition.Y + UI.win.AbsoluteSize.Y - host.AbsolutePosition.Y
            local n = #levels
            local estH = n * 26 + math.max(n - 1, 0) * 2 + 12
            if y + estH > winBottom then
                y = math.max(y + 30 - estH, 4)
            end
        end
        UI.thinkFly.Position = UDim2.fromOffset(x, y)
    end)
    if UI.thinkFly:IsA("CanvasGroup") then
        UI.thinkFly.GroupTransparency = 1
    end
    UI.thinkFly.Visible = true
    if UI.thinkFly:IsA("CanvasGroup") then
        Tween(UI.thinkFly, 0.14, { GroupTransparency = 0 })
    end
end

function UI.pickThinkLevel(provider, lv)
    if UI.dead then
        return
    end
    if Agent.running then
        UI.toast("Stop the agent first", "error")
        return
    end
    if Store.data == nil then
        Store.data = {}
    end
    if provider == "openrouter" then
        local v = (lv == "default") and "" or lv
        if AI ~= nil then
            AI.orEffort = v
            AI.skipReasoning = nil
        end
        Store.data.or_effort = v
        if UI.orEffortBox then
            UI.orEffortBox.Text = v
        end
        UI.toast(v == "" and ("Reasoning: model default (" .. tostring(AI ~= nil and AI.orEffortDefault or "medium") .. ")")
            or ("Reasoning effort: " .. v))
    else
        if AI ~= nil then
            AI.thinkLevel = lv
            AI.skipThinking = nil
        end
        Store.data.think_level = lv
        UI.toast("Thinking level: " .. lv)
    end
    pcall(Store.save)
    UI.flyHide()
    UI.flyHoverRow, UI.flyHover = false, false
    if UI.modelMenu and UI.modelMenu.Visible then
        UI.refreshModelMenu()
    end
    if UI.qModelMenu and UI.qModelMenu.Visible then
        UI.refreshQModelMenu()
    end
end

function UI.pickModel(provider, id)
    if UI.dead then
