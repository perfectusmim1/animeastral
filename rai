-- Dropdown rows were TextButtons with AutoButtonColor off and no hover or press handling at
-- all, so clicking them felt like clicking a picture. This gives every menu row the same
-- three states: rest, hover, pressed.
function UI.menuRow(row, active, onClick, onHover, onUnhover)
    local rest = active and C.surface or C.surface2
    local hover = Color3.fromRGB(math.min(rest.R + 12, 255), math.min(rest.G + 12, 255), math.min(rest.B + 12, 255))
    local press = Color3.fromRGB(math.min(rest.R + 22, 255), math.min(rest.G + 22, 255), math.min(rest.B + 22, 255))
    row.MouseEnter:Connect(function()
        Tween(row, 0.11, { BackgroundColor3 = hover })
        if onHover then
            onHover()
        end
    end)
    row.MouseLeave:Connect(function()
        Tween(row, 0.11, { BackgroundColor3 = rest })
        if onUnhover then
            onUnhover()
        end
    end)
    row.MouseButton1Down:Connect(function()
        Tween(row, 0.06, { BackgroundColor3 = press })
    end)
    row.MouseButton1Up:Connect(function()
        Tween(row, 0.11, { BackgroundColor3 = hover })
    end)
    if onClick then
        row.MouseButton1Click:Connect(onClick)
    end
end
